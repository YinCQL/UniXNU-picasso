# picasso first-console kernel configuration.
#
# Reaches the XNU video/serial console and reports the genuine missing-driver panic.
# Minimal native drivers; UFS / AES / VirtIO / display / Adreno are brought up in
# later stages once the platform boots.

CONFIG_XNU_BUILD_ARCHIVES=y
CONFIG_XNU_SOURCE_CORECRYPTO14=y
CONFIG_XNU_ARM_DT_PLATFORM=y
CONFIG_XNU_ARMCPU=y
CONFIG_XNU_NATIVE_ARCH_TIMER=y
CONFIG_XNU_NATIVE_PAN=y
CONFIG_XNU_DT_PANIC_REGION=y
CONFIG_XNU_TRUST_CACHE_RUNTIME=y
CONFIG_XNU_NATIVE_CS_HASH_CACHE=y

CONFIG_XNU_CRYPTO_BOOTSTRAP="prelinked"
CONFIG_XNU_EXTRA_LD_ARCHIVES=""

# Publish a bare ApplePMGRNub for the unchanged AMFI: its configuration
# settings match ApplePMGRNub and OR bit 2 into the always-on state, and the
# provider field below the nub stays NULL so nothing touches Apple PMGR.
# package/PicassoPmgr.cpp, run from the sheng-platform-power hook in bsd_init.
CONFIG_XNU_SHENG_PMGR=y
# CONFIG_XNU_SOURCE_PTHREAD is not set
# CONFIG_XNU_SOURCE_MOCKFS is not set
CONFIG_XNU_NATIVE_UFS=y
# CONFIG_XNU_NATIVE_AES is not set
# CONFIG_XNU_NATIVE_VIRTIO_BLOCK is not set
# CONFIG_XNU_NATIVE_VIRTIO_CONSOLE is not set
CONFIG_XNU_NATIVE_RAM_BLOCK=y
# CONFIG_XNU_NATIVE_MOBILE_DISPLAY is not set
# CONFIG_XNU_NATIVE_LEGACY_DISPLAY is not set
# CONFIG_XNU_NATIVE_ADRENO is not set
# CONFIG_XNU_ARMVIRT_PLATFORM is not set
# CONFIG_XNU_ZONE_PGZ_ALIGNMENT_PROBE is not set
# CONFIG_XNU_VERIFIED_ROOT_PROBE is not set
CONFIG_XNU_OWNER_ROOT_AUDIT=y
CONFIG_XNU_OWNER_ROOT_TRUST=y
# Mount the authenticated SystemOS cryptex read-only at /private/preboot and
# pass DYLD_SHARED_CACHE_DIR to init. This requires the OS root to have mounted
# already; it cannot resolve an earlier IOFindBSDRoot wait. CACHE_VOLUME_UUID
# selects the signed APFS volume by UUID, not by its variable diskNsM name.
# OWNER_UNION_SYSTEMOS stays off for now: it overlays SystemOS onto / with
# MNT_UNION. The kernel tree does select union mounts (DEVELOPMENT includes
# FILESYS_DEV), but that path is the heavier fallback -- the carrier route
# below authorizes the SystemOS mount in place and is sufficient.
CONFIG_XNU_OWNER_CACHE_MOUNT=y
# Select the dyld startup bit so the original ignition sequence does not run a
# second, unauthenticated cache path; requires the mount above.
CONFIG_XNU_OWNER_CACHE_STARTUP=y
# Publish the authenticated boot manifest for the mounted pair; requires the
# startup selection. Data is a separate volatile APFS volume prepared in CI.
CONFIG_XNU_OWNER_BOOT_MANIFEST=y
CONFIG_XNU_OWNER_CACHE_VOLUME_UUID="8846FE78-2910-4297-AF97-D59BB6F8FC16"
# The SystemOS carrier is mounted at /private/preboot, not unioned onto /.
# The non-CSR shared-region path checks the root mount and the mount resolved
# through /private/preboot/Cryptexes. The carrier patch adds the authenticated
# SystemOS mount/direct-parent check for our non-union path. Requires
# OWNER_CACHE_STARTUP. A first shared_region_check_np() returning an empty
# region is not by itself evidence that the subsequent mapping failed.
CONFIG_XNU_OWNER_CACHE_CARRIER=y
CONFIG_XNU_OWNER_DATA_MOUNT=y
# CONFIG_XNU_OWNER_UNION_SYSTEMOS is not set
# CONFIG_XNU_BOOT_PROGRESS is not set

# prepare-picasso-ram-data.py writes the formatted APFS volume's actual UUID
# into out/picasso/.config before compilation. An unprepared build must fail.
CONFIG_XNU_OWNER_DATA_VOLUME_UUID=""
