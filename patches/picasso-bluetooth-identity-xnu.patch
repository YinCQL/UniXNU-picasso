+static int
+picasso_bt_runtime_capture(const uint8_t *data, uint64_t size, uint32_t count,
+    uint32_t index, bool audio, bool gpu, int write_error)
+{
+    if (!data || !size || size > 16*1024*1024 || count != 22 ||
+        index < 14 || index > 15 || !audio || !gpu || write_error > 0) return EAUTH;
