+    if (!mp || !root || !(vfs_flags(mp) & MNT_RDONLY) || !(vfs_flags(root) & MNT_RDONLY) ||
+        strcmp(vfs_statfs(mp)->f_fstypename, "bindfs") ||
+        strcmp(vfs_statfs(mp)->f_mntonname, "/usr/sbin") ||
+        strcmp(vfs_statfs(mp)->f_mntfromname, "/private/var/ngpu/bluetooth-bin") ||
+        strcmp(vfs_statfs(root)->f_fstypename, "apfs")) return EAUTH;
+    vnode_t device = vfs_devvp(root);
+    if (!device) return EAUTH;
+    dev_t dev = vnode_specrdev(device);
