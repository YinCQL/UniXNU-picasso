+int
+picasso_bt_runtime_auth(vnode_t vp, vfs_context_t ctx)
+{
+    if (!os_atomic_load(&picasso_bt_runtime_ready, acquire)) return EAUTH;
+    if (!vp || !ctx || vnode_vtype(vp) != VREG || native_gpu_addon_files != 22 ||
+        native_gpu_addon_failed || native_gpu_addon_error) return EAUTH;
