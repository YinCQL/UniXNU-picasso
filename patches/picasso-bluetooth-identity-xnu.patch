+static int
+picasso_bt_runtime_file(vnode_t vp, unsigned index, vfs_context_t ctx)
+{
+    struct vnode_attr va;
+    VATTR_INIT(&va);
+    VATTR_WANTED(&va, va_mode); VATTR_WANTED(&va, va_uid); VATTR_WANTED(&va, va_gid);
+    VATTR_WANTED(&va, va_nlink); VATTR_WANTED(&va, va_data_size);
+    if (index >= 2 || !vp || vnode_vtype(vp) != VREG || !picasso_bt_runtime_sizes[index]) return EAUTH;
+    int error = vnode_getattr(vp, &va, ctx);
+    if (error) return error;
+    if (!VATTR_IS_SUPPORTED(&va, va_mode) || !VATTR_IS_SUPPORTED(&va, va_uid) ||
+        !VATTR_IS_SUPPORTED(&va, va_gid) || !VATTR_IS_SUPPORTED(&va, va_nlink) ||
+        !VATTR_IS_SUPPORTED(&va, va_data_size) || va.va_uid || va.va_gid ||
+        (va.va_mode & 07777) != 0755 || va.va_nlink != 1 ||
+        va.va_data_size != picasso_bt_runtime_sizes[index]) return EAUTH;
+    uint8_t *buffer = kalloc_data(4096, Z_WAITOK);
+    if (!buffer) return ENOMEM;
+    SHA256_CTX sha; uint8_t digest[32];
+    SHA256_Init(&sha);
+    for (uint64_t at = 0; !error && at < va.va_data_size; ) {
+        int count = (int)(va.va_data_size - at < 4096 ? va.va_data_size - at : 4096), resid = 0;
+        error = vn_rdwr(UIO_READ, vp, (caddr_t)buffer, count, (off_t)at, UIO_SYSSPACE,
+            IO_NOAUTH, vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+        if (!error && resid) error = EIO;
+        if (!error) SHA256_Update(&sha, buffer, count);
+        at += count;
+    }
+    SHA256_Final(digest, &sha);
+    kfree_data(buffer, 4096);
+    if (!error && memcmp(digest, picasso_bt_runtime_hashes[index], sizeof(digest))) error = EAUTH;
+    return error;
+}
