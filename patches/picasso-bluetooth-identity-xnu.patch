+    error = index < 2 ? picasso_bt_runtime_file(lower, index, ctx) : EAUTH;
+    vnode_put(lower);
+    static unsigned reports;
+    unsigned ticket = os_atomic_inc_orig(&reports, relaxed);
+    if (ticket < 8) printf("PICASSO_BT launch identity=%u error=%d\n", index, error);
+    return error;
+}
