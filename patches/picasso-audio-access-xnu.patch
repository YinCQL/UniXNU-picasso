+/* Picasso's output-only HAL is hosted by the signed iOS audio server. The
+ * stock profile cannot name this board's new user-client class. Scope this
+ * compatibility rule to that identity, exact provider/client and type zero;
+ * never use the mutable registry process-name grant for audio. */
+static bool
+picasso_audio_open_grant(IOService *service, IOUserClient *client, task_t owner, uint32_t type)
+{
+    if (!service || !client || type || owner != current_task() ||
+        strcmp(service->getMetaClass()->getClassName(), "PicassoAudio") ||
+        strcmp(client->getMetaClass()->getClassName(), "PicassoAudioUserClient") ||
+        client->getProvider() != service) return false;
+    proc_t process = proc_self();
+    const char *identity = process ? csproc_get_identity(process) : NULL;
+    bool grant = process && proc_task(process) == owner && csproc_get_platform_binary(process) &&
+        identity && !strcmp(identity, "com.apple.mediaserverd");
+    if (process) proc_rele(process);
+    return grant;
 }
 
