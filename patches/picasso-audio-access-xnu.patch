+/* The reference iPad's BuiltinAudioPlugin bundle is not guaranteed on this
+ * iPhone image. Verify our two required files independently; compare the lower
+ * bundle's vnode only when it existed before the union mount. */
+static void
+picasso_audio_addon_mount(proc_t p, user_addr_t scratch, volatile int *stage, volatile int *status)
+{
+    static const char lower[] = "/System/Library/Audio/Plug-Ins/HAL/BuiltinAudioPlugin.driver";
+    static const char source[] = "/private/var/ngpu/audio", point[] = "/System/Library/Audio/Plug-Ins/HAL";
+    vnode_t before = NULLVP, after = NULLVP;
+    int lower_error = vnode_lookup(lower, 0, &before, vfs_context_current());
+    native_gpu_addon_mount(p, scratch, 0xa00, source, sizeof(source), point, sizeof(point),
+        "/System/Library/Audio/Plug-Ins/HAL/PicassoAudio.driver/Info.plist",
+        "/System/Library/Audio/Plug-Ins/HAL/PicassoAudio.driver/PicassoAudio", stage, status);
+    int preserved = -1;
+    if (!lower_error) {
+        int error = vnode_lookup(lower, 0, &after, vfs_context_current());
+        preserved = !error && before == after;
+        if (!preserved && !*status) { *status = error ? error : EAUTH; *stage = 6; }
+    } else if (lower_error != ENOENT && !*status) { *status = lower_error; *stage = 6; }
+    printf("PICASSO_AUDIO addon lower_before=%d lower_preserved=%d own_stage=%d error=%d\n",
+        lower_error, preserved, *stage, *status);
+    if (after) vnode_put(after);
+    if (before) vnode_put(before);
+}
