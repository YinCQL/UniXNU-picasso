+/* Preserve swap/LaunchServices and APFS transaction space while restoring apps.
+ * This is a volatile sparse Data disk; the limit is not a RAM reservation. */
+#define PICASSO_STAGED_RESERVE (512ULL * 1024 * 1024)
+#define PICASSO_STAGED_TX_ALLOWANCE (64ULL * 1024)
+static int
+picasso_staged_free_bytes(mount_t mp, uint64_t *bytes)
+{
+	struct vfs_attr va;
+	VFSATTR_INIT(&va);
+	VFSATTR_WANTED(&va, f_bavail);
+	VFSATTR_WANTED(&va, f_bsize);
+	int error = vfs_getattr(mp, &va, vfs_context_current());
+	if (error) return error;
+	if (!VFSATTR_IS_SUPPORTED(&va, f_bavail) || !VFSATTR_IS_SUPPORTED(&va, f_bsize) ||
+	    !va.f_bsize || va.f_bavail > UINT64_MAX / va.f_bsize) return EINVAL;
+	*bytes = va.f_bavail * va.f_bsize;
+	return 0;
+}
+static int
+picasso_staged_headroom(mount_t mp, uint64_t length)
+{
+	uint64_t free_bytes = 0;
+	int error = picasso_staged_free_bytes(mp, &free_bytes);
+	if (error) return error;
+	if (length > free_bytes || free_bytes - length < PICASSO_STAGED_RESERVE + PICASSO_STAGED_TX_ALLOWANCE)
+		return ENOSPC;
+	return 0;
+}
+static void
+picasso_staged_report(mount_t mp)
+{
+	uint64_t free_bytes = 0;
+	int error = picasso_staged_free_bytes(mp, &free_bytes);
+	printf("PICASSO_STAGED stage=%d dirs=%d files=%d bytes=%llu failed=%d error=%d\n",
+	    native_staged_apps_stage, native_staged_apps_dirs, native_staged_apps_files,
+	    (unsigned long long)native_staged_apps_bytes, native_staged_apps_failed, native_staged_apps_error);
+	printf("PICASSO_STAGED free_bytes=%llu reserve_bytes=%llu stat_error=%d path=%s\n",
+	    (unsigned long long)free_bytes, (unsigned long long)PICASSO_STAGED_RESERVE, error, native_staged_apps_path);
+}
