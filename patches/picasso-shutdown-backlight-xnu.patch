+/* Only the stock SpringBoard executable can request this board operation.
+ * A read is inert. A write follows its verified, non-cancellable shutdown
+ * callback; it does not commit kernel shutdown or bypass storage teardown. */
+extern void picasso_backlight_shutdown(void) __attribute__((weak_import));
+bool
+picasso_shutdown_backlight_caller(void)
+{
+    proc_t p = current_proc();
+    char path[MAXPATHLEN];
+    int length = sizeof(path);
+    return csproc_get_platform_binary(p) && p->p_textvp &&
+        !vn_getpath(p->p_textvp, path, &length) &&
+        !strcmp(path, "/System/Library/CoreServices/SpringBoard.app/SpringBoard") &&
+        picasso_dyld_inject_target(p);
+}
+static int
+picasso_shutdown_backlight_sysctl SYSCTL_HANDLER_ARGS
+{
+    int value = 0;
+    if (!req->newptr) return SYSCTL_OUT(req, &value, sizeof(value));
+    if (!picasso_shutdown_backlight_caller()) return EPERM;
+    if (req->newlen != sizeof(value)) return EINVAL;
+    int error = SYSCTL_IN(req, &value, sizeof(value));
+    if (error) return error;
+    if (value != 1) return EINVAL;
+    if (!picasso_backlight_shutdown) return ENXIO;
+    picasso_backlight_shutdown();
+    return 0;
+}
+SYSCTL_PROC(_kern, OID_AUTO, picasso_shutdown_backlight,
+    CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_ANYBODY | CTLFLAG_LOCKED,
+    0, 0, picasso_shutdown_backlight_sysctl, "I", "picasso: blank after native shutdown confirmation");
 #endif
 
