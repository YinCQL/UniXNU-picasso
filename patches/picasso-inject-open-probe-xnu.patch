+/* Does dyld actually open the injected library, and in which process? AMFI's
+ * accepted signature says nothing about the load; a path copy for OP_OPEN is
+ * evidence of a request, not a successful open. Bounded to 64 lines. */
+extern bool picasso_dyld_inject_target(proc_t);
+static void
+picasso_inject_open_probe(struct nameidata *ndp, proc_t p, const char *path)
+{
+	static unsigned probe_count;
+	if (!p || p != current_proc() || ndp->ni_op != OP_OPEN ||
+	    !picasso_dyld_inject_target(p)) return;
+	const char *base = strrchr(path, '/');
+	base = base ? base + 1 : path;
+	if (strcmp(base, "libpicasso-sb.dylib") && strncmp(base, "picasso-marker-", 15)) return;
+	/* Independent of picasso-probes: quiet boot must not hide the only
+	 * read-only constructor/metric acknowledgement when sysctl is denied. */
+	unsigned ticket = __atomic_load_n(&probe_count, __ATOMIC_RELAXED);
+	do {
+		if (ticket >= 64) return;
+	} while (!__atomic_compare_exchange_n(&probe_count, &ticket, ticket + 1,
+	    false, __ATOMIC_RELAXED, __ATOMIC_RELAXED));
+	char name[MAXCOMLEN + 1] = "?";
+	proc_name(proc_getpid(p), name, sizeof name);
+	printf("PICASSO_INJECT open=%u pid=%d name=%s path=%.160s\n",
+	    ticket + 1, proc_getpid(p), name, path);
+}
