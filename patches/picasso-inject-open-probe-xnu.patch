+/* Does dyld actually open the injected library, and in which process? AMFI's
+ * accepted signature says nothing about the load; a path copy for OP_OPEN is
+ * evidence of a request, not a successful open. Bounded to 64 lines. */
+extern bool picasso_dyld_inject_target(proc_t);
+static void
+picasso_inject_open_probe(struct nameidata *ndp, proc_t p, const char *path)
+{
+	static unsigned probe_count;
+	if (!p || p != current_proc() || ndp->ni_op != OP_OPEN) return;
+	const char *base = strrchr(path, '/');
+	base = base ? base + 1 : path;
+	if (strcmp(base, "libpicasso-sb.dylib") && strncmp(base, "picasso-marker-", 15)) return;
+	if (!picasso_dyld_inject_target(p)) return;
+	/* A separate budget keeps the exact Preferences name result observable
+	 * after other apps consume the generic library-load budget. Numeric
+	 * presence/type/status/equality fields carry no user name or file data. */
+	static unsigned name_count;
+	static const char name_prefix[] = "/private/var/picasso/picasso-marker-btname-";
+	if (!strcmp(p->p_name, "Preferences") && !strncmp(path, name_prefix, sizeof(name_prefix) - 1)) {
+		unsigned sample = 0, part = 0, a = 0, b = 0, c = 0, d = 0;
+		int used = 0;
+		const char *values = path + sizeof(name_prefix) - 1;
+		if (sscanf(values, "%u-%u-%u-%u-%u-%u%n", &sample, &part, &a, &b, &c, &d, &used) != 6 ||
+		    !used || values[used] || sample > 6 || part > 3 || a > 65535 || b > 65535 || c > 65535 || d > 65535) return;
+		unsigned ticket = __atomic_load_n(&name_count, __ATOMIC_RELAXED);
+		do {
+			if (ticket >= 24) return;
+		} while (!__atomic_compare_exchange_n(&name_count, &ticket, ticket + 1,
+		    false, __ATOMIC_RELAXED, __ATOMIC_RELAXED));
+		printf("PICASSO_BT_NAME sample=%u part=%u a=%u b=%u c=%u d=%u pid=%d readonly=1\n",
+		    sample, part, a, b, c, d, proc_getpid(p));
+		return;
+	}
+	/* Independent of picasso-probes: quiet boot must not hide the only
+	 * read-only constructor/metric acknowledgement when sysctl is denied. */
+	unsigned ticket = __atomic_load_n(&probe_count, __ATOMIC_RELAXED);
+	do {
+		if (ticket >= 64) return;
+	} while (!__atomic_compare_exchange_n(&probe_count, &ticket, ticket + 1,
+	    false, __ATOMIC_RELAXED, __ATOMIC_RELAXED));
+	char name[MAXCOMLEN + 1] = "?";
+	proc_name(proc_getpid(p), name, sizeof name);
+	printf("PICASSO_INJECT open=%u pid=%d name=%s path=%.160s\n",
+	    ticket + 1, proc_getpid(p), name, path);
+}
