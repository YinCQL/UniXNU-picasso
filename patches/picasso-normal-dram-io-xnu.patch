+#if defined(XNU_PICASSO_NORMAL_DRAM_IO) && XNU_PICASSO_NORMAL_DRAM_IO && !defined(APPLE_ARM64_ARCH_FAMILY)
+/* Managed RAM image buffers are ordinary memory on Qualcomm. Apple's
+ * Device mappings reject the unaligned pair/vector reads in CoreGraphics
+ * and DC ZVA, even though these pages have no register side effects.
+ * Keep all unmanaged/MMIO apertures and every cached mode unchanged.
+ * The WCOMB case below retains NX/PNX and selects Normal non-cacheable. */
+static unsigned
+picasso_dram_io_wimg(unsigned wimg, pmap_paddr_t pa)
+{
+	unsigned mode = wimg & VM_WIMG_MASK;
+	if (pa_valid(pa) && (mode == VM_WIMG_IO || mode == VM_WIMG_POSTED ||
+	    mode == VM_WIMG_POSTED_REORDERED || mode == VM_WIMG_POSTED_COMBINED_REORDERED || mode == VM_WIMG_RT)) {
+		return (wimg & ~VM_WIMG_MASK) | VM_WIMG_WCOMB;
+	}
+	return wimg;
+}
+#endif
