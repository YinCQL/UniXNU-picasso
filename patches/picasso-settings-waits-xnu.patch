+static void
+picasso_preferences_snapshot_fire(thread_call_param_t unused, thread_call_param_t argument)
+{
+	static unsigned taken;
+	(void)unused;
+	proc_t p=picasso_dump_named_proc("Preferences");
+	if(p!=PROC_NULL)proc_rele(p);
+	if(++taken<30) {
+		uint64_t interval=0;
+		nanoseconds_to_absolutetime(20ULL*NSEC_PER_SEC,&interval);
+		thread_call_enter1_delayed(argument,argument,mach_absolute_time()+interval);
+	}
+}
