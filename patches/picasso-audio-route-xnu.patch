+/* Mount only this exact plugin directory. Its executable is prepared and
+ * signed offline; the sealed root and all other HAL bundles stay visible.
+ * This runs during initial Data preparation, before audio server launch. */
+static void
+picasso_audio_route_mount(proc_t p, user_addr_t scratch, volatile int *stage, volatile int *status)
+{
+    static const char source[] = "/private/var/ngpu/audio-route/VirtualAudio.plugin";
+    static const char point[] = "/Library/Audio/Plug-Ins/HAL/VirtualAudio.plugin";
+    native_gpu_addon_mount(p, scratch, 0xa00, source, sizeof(source), point, sizeof(point),
+        "/Library/Audio/Plug-Ins/HAL/VirtualAudio.plugin/Info.plist",
+        "/Library/Audio/Plug-Ins/HAL/VirtualAudio.plugin/VirtualAudio", stage, status);
+    printf("PICASSO_AUDIO route optional_vhaw=1 stage=%d error=%d\n", *stage, *status);
+}
+
+static void
+picasso_audio_prepare(proc_t p, user_addr_t scratch)
+{
+    volatile int stage = -1, status = native_gpu_addon_error;
+    if (!native_gpu_addon_failed && native_gpu_addon_files == 4 && !status) {
+        picasso_audio_route_mount(p, scratch, &stage, &status);
+        if (stage == 5 && !status) picasso_audio_addon_mount(p, scratch, &stage, &status);
+    }
+    printf("PICASSO_AUDIO addon files=%d written=%d same=%d failed=%d stage=%d error=%d\n",
+        native_gpu_addon_files, native_gpu_addon_written, native_gpu_addon_same, native_gpu_addon_failed, stage, status);
+}
