+/* The payload may own only these four ordered audio files. */
+static bool
+picasso_audio_addon_entry(uint32_t count, uint32_t index, const char *name, uint32_t mode)
+{
+    static const char *const names[] = {
+        "audio/PicassoAudio.driver/Info.plist", "audio/PicassoAudio.driver/PicassoAudio",
+        "audio-route/VirtualAudio.plugin/Info.plist", "audio-route/VirtualAudio.plugin/VirtualAudio"
+    };
+    return count == 4 && index < 4 && name && !strcmp(name, names[index]) &&
+        mode == ((index & 1) ? 0755U : 0644U);
+}
