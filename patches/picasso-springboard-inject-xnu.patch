+#if DEVELOPMENT || DEBUG
+extern bool picasso_dyld_inject_target(proc_t);
+/* 20H392 amfi_check_dyld_policy_self uses AMFI call 90 with two uint64_t
+ * words: input flags and a user pointer to output flags. Keep the MAC policy's
+ * decision/error; only allow DYLD path variables for the board-selected UI. */
+static void
+picasso_dyld_path_policy(proc_t p, int call, const char *policy, user_addr_t arg, int error)
+{
+	if (error || call != 90 || strcmp(policy, "AMFI") || !picasso_dyld_inject_target(p)) return;
+	uint64_t request[2], flags = 0, original = 0;
+	int result = copyin(arg, request, sizeof(request));
+	if (!result) result = copyin((user_addr_t)request[1], &flags, sizeof(flags));
+	if (!result) {
+		original = flags;
+		flags |= 1ULL << 1; /* AMFI_DYLD_OUTPUT_ALLOW_PATH_VARS only. */
+		result = copyout(&flags, (user_addr_t)request[1], sizeof(flags));
+	}
+	static unsigned reports;
+	if (__atomic_fetch_add(&reports, 1, __ATOMIC_RELAXED) < 16)
+		printf("PICASSO_INJECT dyld policy pid=%d old=%llx new=%llx result=%d\n",
+		    proc_getpid(p), (unsigned long long)original, (unsigned long long)flags, result);
+}
+#endif
