+/* A separate reader of the console ring. No UFS, waits or printf under pur_lock. */
+uint32_t picasso_console_snapshot(void *out,uint32_t capacity,uint64_t *total,uint64_t *dropped);
+uint32_t picasso_console_snapshot(void *out,uint32_t capacity,uint64_t *total,uint64_t *dropped) {
+	if(!out || !total || !dropped || !os_atomic_cmpxchg(&pur_lock,0,1,acquire))return 0;
+	uint64_t end=pur_ring.total;
+	uint32_t n=(uint32_t)MIN((uint64_t)MIN(capacity,PURing_SIZE),end);
+	*total=end;*dropped=os_atomic_load(&pur_dropped,relaxed);
+	os_atomic_store(&pur_lock,0,release);
+	for(uint32_t at=0;at<n;) {
+		if(!os_atomic_cmpxchg(&pur_lock,0,1,acquire))return 0;
+		if(pur_ring.total-(end-n+at)>PURing_SIZE) {os_atomic_store(&pur_lock,0,release);return 0;}
+		uint32_t chunk=MIN(n-at,4096U);
+		for(uint32_t i=0;i<chunk;++i)((char *)out)[at+i]=pur_ring.buffer[(end-n+at+i)&PURing_MASK];
+		os_atomic_store(&pur_lock,0,release);at+=chunk;
+	}
+	return n;
+}
