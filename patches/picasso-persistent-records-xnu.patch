+IOReturn IODTNVRAM::restorePicassoStorage(void) {
+	if(!picasso_nvram_load || !picasso_nvram_save || !_format || _format->getVersion()!=1)return kIOReturnUnsupported;
+	uint8_t *image=IONewZeroData(uint8_t,8192);
+	if(!image)return kIOReturnNoMemory;
+	int restored=picasso_nvram_load(image,8192);
+	IOReturn result=restored<0?kIOReturnNotReady:kIOReturnSuccess;
+	NVRAMWRITELOCK();CONTROLLERLOCK();
+	if(restored==1) result=static_cast<IONVRAMCHRPHandler *>(_format)->restorePicasso(image,8192);
+	__atomic_store_n(&picasso_nvram_active,result==kIOReturnSuccess,__ATOMIC_RELEASE);
+	CONTROLLERUNLOCK();NVRAMUNLOCK();
+	IODeleteData(image,uint8_t,8192);
+	IOLog("PICASSO_NVRAM restore=%d result=%x active=%u\n",restored,result,picasso_nvram_active);
+	return result;
+}
+extern "C" void picasso_nvram_restore_before_launchd(void) {
+	if(picasso_nvram_service)picasso_nvram_service->restorePicassoStorage();
+}
+
+extern "C" void picasso_nvram_periodic_sync(void) {
+	if(__atomic_load_n(&picasso_nvram_active,__ATOMIC_ACQUIRE) && picasso_nvram_service)picasso_nvram_service->sync();
+}
