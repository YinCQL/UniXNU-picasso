+// Restore only a complete CHRP bank produced by this board's unchanged serializer.
+// Validate before unserializeImage(), which otherwise panics on an invalid Adler.
+IOReturn IONVRAMCHRPHandler::restorePicasso(const uint8_t *image,uint32_t bytes) {
+	if(bytes!=8192 || !image || !isValidImage(image,bytes))return kIOReturnBadArgument;
+	int version=validateNVRAMVersion(image,bytes,nullptr);
+	if(version!=kNVRAMVersion1 || nvram_get_adler(const_cast<uint8_t *>(image),version)!=adler32_with_version(image,bytes,version))return kIOReturnIOError;
+	// Exact board proxy layout: nvram(32), common(2064), free(6096).
+	// No new system partition or alternate controller format may be introduced.
+	const uint32_t offsets[]={0,32,2096},lengths[]={32,2064,6096};
+	const char names[3][12]={"nvram","common","free"};
+	for(unsigned i=0;i<3;++i) {
+		const auto *h=reinterpret_cast<const chrp_nvram_header *>(image+offsets[i]);
+		if(uint32_t(h->len)*16!=lengths[i] || memcmp(h->name,names[i],12) || chrp_checksum(h)!=h->cksum)return kIOReturnIOError;
+	}
+	if(_bankSize!=bytes || _commonPartitionOffset!=48 || _commonPartitionSize!=2048 || _systemPartitionSize)return kIOReturnBadArgument;
+	// Allocate a replacement before changing the live proxy. Keep its old
+	// dictionary/image intact if allocation or property conversion fails.
+	uint8_t *replacement=IONewData(uint8_t,bytes);
+	auto dictionary=OSDictionary::withCapacity(1);
+	if(!replacement || !dictionary) {if(replacement)IODeleteData(replacement,uint8_t,bytes);return kIOReturnNoMemory;}
+	memcpy(replacement,image,bytes);
+	auto previousDictionary=_varDict;
+	uint8_t *previousImage=_nvramImage;
+	uint32_t previousGeneration=_generation,previousCommon=_commonUsed,previousSystem=_systemUsed;
+	bool previousDirty=_newData;
+	_varDict=dictionary;_nvramImage=replacement;
+	validateNVRAMVersion(image,bytes,&_generation);
+	_commonUsed=_systemUsed=0;
+	// Caller holds NVRAMWRITELOCK: avoid recursive provider get/setProperty.
+	_picassoRestoring=true;IOReturn ret=unserializeVariables();_picassoRestoring=false;
+	if(ret) {
+		_varDict=previousDictionary;_nvramImage=previousImage;_generation=previousGeneration;
+		_commonUsed=previousCommon;_systemUsed=previousSystem;_newData=previousDirty;
+		IODeleteData(replacement,uint8_t,bytes);
+	} else if(previousImage) IODeleteData(previousImage,uint8_t,bytes);
+	return ret;
+}
