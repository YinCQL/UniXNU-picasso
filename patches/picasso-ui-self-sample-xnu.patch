+/* Read the current main thread at its own user-to-kernel transition. The
+ * periodic remote-task walk is only a best-effort snapshot on SMP systems.
+ * Sampling is limited to the first SpringBoard main thread, once per five
+ * seconds after startup, for at most 180 samples. No thread is stopped. */
+static void
+picasso_ui_self_sample(arm_saved_state_t *state, thread_t thread, int trap)
+{
+	static uint64_t target_tid, next_tick, interval, first_tick;
+	static uint64_t previous_calls;
+	static unsigned samples;
+	if (!(thread_get_tag(thread) & THREAD_TAG_MAINTHREAD) || !is_saved_state64(state)) return;
+	uint64_t tid = thread_tid(thread);
+	uint64_t target = __atomic_load_n(&target_tid, __ATOMIC_ACQUIRE);
+	if (target && target != tid) return;
+	if (!target) {
+		struct proc *p = get_bsdthreadtask_info(thread);
+		if (!p || strcmp(proc_name_address(p), "SpringBoard")) return;
+		uint64_t empty = 0;
+		if (!__atomic_compare_exchange_n(&target_tid, &empty, tid, FALSE,
+		    __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE)) return;
+		nanoseconds_to_absolutetime(5ULL * NSEC_PER_SEC, &interval);
+		nanoseconds_to_absolutetime(120ULL * NSEC_PER_SEC, &first_tick);
+		next_tick = first_tick;
+	}
+	if (samples >= 180) return;
+	uint64_t now = mach_absolute_time();
+	if (now < next_tick) return;
+	next_tick = now + interval;
+	unsigned sample = ++samples;
+	const uint64_t mask = 0x7fffffffffull;
+	uint64_t frames[32] = {get_saved_state_pc(state) & mask, get_saved_state_lr(state) & mask};
+	uint64_t sp = get_saved_state_sp(state), fp = get_saved_state_fp(state);
+	unsigned depth = 2, stop = 0;
+	while (fp && depth < 32) {
+		/* The active ARM64 stack grows down. Reject bad/tagged pointers, cycles,
+		 * and unrelated memory rather than mistaking them for caller frames. */
+		if ((fp & 15) || fp < sp || fp > mask - 16 || fp - sp > 1024 * 1024) {
+			stop = 1; break;
+		}
+		uint64_t pair[2];
+		if (copyin((user_addr_t)fp, pair, sizeof(pair))) {stop = 2; break;}
+		if (!pair[1]) break;
+		frames[depth++] = pair[1] & mask;
+		if (pair[0] && pair[0] <= fp) {stop = 3; break;}
+		fp = pair[0];
+	}
+	if (fp && depth == 32) stop = 4;
+	uint64_t ns = 0, elapsed = 0;
+	absolutetime_to_nanoseconds(now, &ns);
+	absolutetime_to_nanoseconds(mach_absolute_time() - now, &elapsed);
+	uint64_t calls = thread->syscalls_mach + thread->syscalls_unix;
+	task_t task = get_threadtask(thread);
+	printf("PICASSO_UI_SAMPLE sample=%u pid=%d tid=%llu uptime_ms=%llu trap=%d calls=%llu delta=%llu depth=%u stop=%u walk_us=%llu cache_slide=%x main_header=%llx\n",
+	    sample, task_pid(task), tid, ns / NSEC_PER_MSEC, trap, calls,
+	    samples > 1 ? calls - previous_calls : 0, depth, stop, elapsed / NSEC_PER_USEC,
+	    task->task_shared_region_slide, (unsigned long long)task->mach_header_vm_address);
+	previous_calls = calls;
+	for (unsigned i = 0; i < depth; i += 4) {
+		printf("PICASSO_UI_STACK sample=%u offset=%u %llx %llx %llx %llx\n", sample, i,
+		    frames[i], frames[i + 1], frames[i + 2], frames[i + 3]);
+	}
+}
+#endif
+/* PICASSO_UI_SELF_SAMPLE_END */
