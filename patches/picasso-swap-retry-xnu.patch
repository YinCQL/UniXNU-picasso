 }
 
+/*
+ * sheng: the first swapfile create attempt runs while / is still the read-only system
+ * volume, so it fails with EROFS (/private/var is not yet the writable RAM Data volume).
+ * The boot path calls this right after mounting that volume: clear the failure time so
+ * VM_SWAP_SHOULD_CREATE() is true again and wake the creator to retry on the writable path.
+ */
+void
+vm_swap_retry_create(void)
+{
+	lck_mtx_lock(&vm_swap_data_lock);
+	vm_swapfile_last_failed_to_create_ts = 0;
+	thread_wakeup((event_t)&vm_swapfile_create_needed);
+	lck_mtx_unlock(&vm_swap_data_lock);
+}
+
 
