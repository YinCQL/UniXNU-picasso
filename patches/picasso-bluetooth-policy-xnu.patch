+/* launchd may reorder entries and add unrelated overrides. Accept only its
+ * bounded Boolean XML dictionary and preserve all bytes outside released jobs.
+ * Parse the whole document before changing it; duplicate keys are ambiguous. */
+static int
+picasso_jobs_space(uint8_t c)
+{
+    return c == ' ' || c == '\t' || c == '\r' || c == '\n';
+}
+
+static int
+picasso_jobs_token(const uint8_t *bytes, size_t size, size_t *at, const char *token)
+{
+    while (*at < size && picasso_jobs_space(bytes[*at])) ++*at;
+    size_t length = strlen(token);
+    if (*at > size || length > size - *at || memcmp(bytes + *at, token, length)) return EINVAL;
+    *at += length;
+    return 0;
+}
+
+static int
+picasso_jobs_transform(uint8_t *bytes, size_t *size, unsigned *removed)
+{
+    static const char *const released[] = {
+        "com.apple.BTServer.avrcp", "com.apple.BTServer.le", "com.apple.BTServer.map",
+        "com.apple.BTServer.pbap", "com.apple.BluetoothUIService", "com.apple.bluetoothd",
+        "com.apple.bluetoothuserd"
+    };
+    struct { uint16_t start, key, length, end; bool drop; } entries[128];
+    unsigned count = 0;
+    size_t at = 0;
+    *removed = 0;
+    if (*size > 8192 ||
+        picasso_jobs_token(bytes, *size, &at, "<?xml version=\"1.0\" encoding=\"UTF-8\"?>") ||
+        picasso_jobs_token(bytes, *size, &at, "<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">") ||
+        picasso_jobs_token(bytes, *size, &at, "<plist version=\"1.0\">") ||
+        picasso_jobs_token(bytes, *size, &at, "<dict>")) return EINVAL;
+    for (;;) {
+        size_t start = at, probe = at;
+        if (!picasso_jobs_token(bytes, *size, &probe, "</dict>")) { at = probe; break; }
+        if (count == 128 || picasso_jobs_token(bytes, *size, &at, "<key>")) return EINVAL;
+        size_t key = at;
+        while (at < *size && bytes[at] != '<') {
+            uint8_t c = bytes[at++];
+            if (!((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
+                (c >= '0' && c <= '9') || c == '.' || c == '-' || c == '_')) return EINVAL;
+        }
+        size_t length = at - key;
+        if (!length || length > 255 || picasso_jobs_token(bytes, *size, &at, "</key>")) return EINVAL;
+        for (unsigned i = 0; i < count; ++i)
+            if (entries[i].length == length && !memcmp(bytes + entries[i].key, bytes + key, length)) return EINVAL;
+        probe = at;
+        if (picasso_jobs_token(bytes, *size, &probe, "<true/>")) {
+            probe = at;
+            if (picasso_jobs_token(bytes, *size, &probe, "<false/>")) return EINVAL;
+        }
+        at = probe;
+        entries[count].start = (uint16_t)start;
+        entries[count].key = (uint16_t)key;
+        entries[count].length = (uint16_t)length;
+        entries[count].end = (uint16_t)at;
+        entries[count].drop = false;
+        for (unsigned i = 0; i < sizeof(released)/sizeof(released[0]); ++i)
+            if (strlen(released[i]) == length && !memcmp(bytes + key, released[i], length)) entries[count].drop = true;
+        ++count;
+    }
+    if (picasso_jobs_token(bytes, *size, &at, "</plist>")) return EINVAL;
+    while (at < *size && picasso_jobs_space(bytes[at])) ++at;
+    if (at != *size) return EINVAL;
+    while (count) {
+        --count;
+        if (!entries[count].drop) continue;
+        size_t start = entries[count].start, end = entries[count].end;
+        memmove(bytes + start, bytes + end, *size - end);
+        *size -= end - start;
+        ++*removed;
+    }
+    return 0;
+}
