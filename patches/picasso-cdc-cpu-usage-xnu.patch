diff --git a/osfmk/kern/task.c b/osfmk/kern/task.c
--- a/osfmk/kern/task.c
+++ b/osfmk/kern/task.c
@@ -10913,3 +10913,26 @@
 }
 #endif
 /* PICASSO_SERVICE_WAIT_TASK_END */
+
+/* CDC process list: cumulative CPU time and resident memory of a task, read the same way
+ * TASK_ABSOLUTETIME_INFO and TASK_BASIC_INFO read them. A task that never got a ledger (kernel_task is one)
+ * reports only its CPU time; the ledger is never dereferenced without the check. */
+void picasso_task_usage(task_t task, uint64_t *user, uint64_t *system, uint64_t *resident);
+void
+picasso_task_usage(task_t task, uint64_t *user, uint64_t *system, uint64_t *resident)
+{
+	if (!task) {
+		*user = *system = *resident = 0;
+		return;
+	}
+	struct recount_times_mach times = recount_task_times(task);
+	*user = times.rtm_user;
+	*system = times.rtm_system;
+	*resident = 0;
+	if (task->ledger) {
+		ledger_amount_t bytes = 0;
+		if (ledger_get_balance(task->ledger, task_ledgers.phys_mem, &bytes) == KERN_SUCCESS && bytes > 0) {
+			*resident = (uint64_t)bytes;
+		}
+	}
+}
