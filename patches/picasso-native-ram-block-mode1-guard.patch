+// Move the immutable seed's owned pages into an unallocated array-backed disk without
+// copying their content. The caller provides a zeroed table and releases the old
+// index/page arrays afterwards. Validate everything before transferring ownership.
+static bool seedMoveToSparse(SeedDisk &seed, RamSparseDisk &disk, uint8_t **table) {
+  // start() records the logical size before choosing SeedDisk or RamSparseDisk.
+  // A matching size with no page table/resident pages is still unallocated.
+  if (!table || disk.pages || (disk.bytes && disk.bytes != seed.bytes) || disk.resident || !seed.bytes ||
+      (seed.bytes & 4095) || seed.bytes > (4ULL << 30) || seed.count > seed.capacity ||
+      (seed.count && (!seed.index || !seed.page)) || seed.resident != seed.count*4096) return false;
+  for (uint64_t k=0; k<seed.count; ++k)
+    if (!seed.page[k] || seed.index[k] >= seed.bytes/4096 || (k && seed.index[k] <= seed.index[k-1])) return false;
+  disk.pages=table; disk.bytes=seed.bytes; disk.resident=seed.resident;
+  for (uint64_t k=0; k<seed.count; ++k) { table[seed.index[k]]=seed.page[k]; seed.page[k]=nullptr; }
+  seed.count=seed.resident=0;
+  return true;
+}
