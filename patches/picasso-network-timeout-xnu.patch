+static int
+picasso_ifnamer_read(const char *path, uint8_t *buffer, size_t capacity, uint64_t *size, vfs_context_t ctx)
+{
+    vnode_t vp = NULLVP;
+    int error = vnode_open(path, FREAD | O_NOFOLLOW, 0, 0, &vp, ctx);
+    if (error) return error;
+    if (vnode_vtype(vp) != VREG) error = EINVAL;
+    struct vnode_attr va;
+    VATTR_INIT(&va); VATTR_WANTED(&va, va_data_size);
+    if (!error) error = vnode_getattr(vp, &va, ctx);
+    if (!error && (!VATTR_IS_SUPPORTED(&va, va_data_size) || va.va_data_size > capacity)) error = EFBIG;
+    if (!error) {
+        *size = va.va_data_size;
+        int resid = 0;
+        error = vn_rdwr(UIO_READ, vp, (caddr_t)buffer, (int)*size, 0, UIO_SYSSPACE,
+            IO_NOAUTH, vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+        if (!error && resid) error = EIO;
+    }
+    int closed = vnode_close(vp, FREAD, ctx);
+    return error ? error : closed;
+}
