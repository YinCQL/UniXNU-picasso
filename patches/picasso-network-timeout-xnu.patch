+static int
+picasso_ifnamer_metadata(const char *path, int directory)
+{
+    vfs_context_t ctx = vfs_context_current();
+    vnode_t vp = NULLVP;
+    int error = vnode_lookup(path, VNODE_LOOKUP_NOFOLLOW, &vp, ctx);
+    if (error) return error;
+    if (vnode_vtype(vp) != (directory ? VDIR : VREG)) error = EINVAL;
+    struct vnode_attr va;
+    if (!error) {
+        VATTR_INIT(&va);
+        VATTR_SET(&va, va_uid, 0); VATTR_SET(&va, va_gid, 0);
+        VATTR_SET(&va, va_mode, directory ? 0755 : 0644);
+        error = vnode_setattr(vp, &va, ctx);
+    }
+    if (!error) {
+        VATTR_INIT(&va);
+        VATTR_WANTED(&va, va_uid); VATTR_WANTED(&va, va_gid); VATTR_WANTED(&va, va_mode);
+        error = vnode_getattr(vp, &va, ctx);
+        if (!error && (!VATTR_IS_SUPPORTED(&va, va_uid) || !VATTR_IS_SUPPORTED(&va, va_gid) ||
+            !VATTR_IS_SUPPORTED(&va, va_mode) || va.va_uid || va.va_gid ||
+            (va.va_mode & 07777) != (directory ? 0755 : 0644))) error = EPERM;
+    }
+    if (!error && directory == 2) error = picasso_ifnamer_directory(vp, ctx);
+    vnode_put(vp);
+    return error;
+}
