+static int
+picasso_ifnamer_copy_signatures(vfs_context_t ctx)
+{
+    uint8_t buffer[2048], digest[32];
+    char original[192], backing[192];
+    for (unsigned i = 0; i < sizeof(picasso_ifnamer_signature_files) / sizeof(picasso_ifnamer_signature_files[0]); ++i) {
+        const struct picasso_ifnamer_signature_file *file = &picasso_ifnamer_signature_files[i];
+        snprintf(original, sizeof(original), "/System/Library/SystemConfiguration/InterfaceNamer.bundle/_CodeSignature/%s", file->name);
+        snprintf(backing, sizeof(backing), "/private/var/picasso/ifnamer/InterfaceNamer.bundle/_CodeSignature/%s", file->name);
+        uint64_t size = 0;
+        int error = picasso_ifnamer_read(original, buffer, sizeof(buffer), &size, ctx);
+        if (error) return error;
+        SHA256_CTX sha;
+        SHA256_Init(&sha); SHA256_Update(&sha, buffer, (size_t)size); SHA256_Final(digest, &sha);
+        if (size != file->size || memcmp(digest, file->digest, sizeof(digest))) return EAUTH;
+        error = picasso_ifnamer_metadata(backing, 0);
+        if (error && error != ENOENT) return error;
+        error = native_gpu_addon_write(backing, buffer, size, 0644, ctx);
+        if (error && error != -1) return error;
+        error = picasso_ifnamer_metadata(backing, 0);
+        if (!error) error = picasso_ifnamer_read(backing, buffer, sizeof(buffer), &size, ctx);
+        if (error) return error;
+        SHA256_Init(&sha); SHA256_Update(&sha, buffer, (size_t)size); SHA256_Final(digest, &sha);
+        if (size != file->size || memcmp(digest, file->digest, sizeof(digest))) return EIO;
+    }
+    return picasso_ifnamer_metadata("/private/var/picasso/ifnamer/InterfaceNamer.bundle/_CodeSignature", 3);
+}
