+static int
+picasso_ifnamer_bind(proc_t p, user_addr_t scratch, const char *source, const char *point)
+{
+    struct mount_args request = {.type = scratch + 0xc00, .path = scratch + 0xc20,
+        .flags = MNT_RDONLY, .data = scratch + 0xd00};
+    int32_t result = 0;
+    int error = copyout("bindfs", request.type, 7);
+    if (!error) error = copyout(point, request.path, strlen(point) + 1);
+    if (!error) error = copyout(source, request.data, strlen(source) + 1);
+    if (error) return error;
+    native_bindfs_boot_mount = 1;
+    error = mount(p, &request, &result);
+    native_bindfs_boot_mount = 0;
+    if (error) return error;
+    vnode_t vp = NULLVP;
+    error = vnode_lookup(point, VNODE_LOOKUP_NOFOLLOW, &vp, vfs_context_current());
+    if (!error) {
+        mount_t mp = vnode_mount(vp);
+        if (vnode_vtype(vp) != VDIR || !mp || !(vfs_flags(mp) & MNT_RDONLY) ||
+            (vfs_flags(mp) & MNT_UNION)) error = EIO;
+        vnode_put(vp);
+    }
+    return error;
+}
