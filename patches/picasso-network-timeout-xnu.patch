+static void
+picasso_network_busy_observe(IOService *service, uint32_t busy)
+{
+    char name[32] = {};
+    proc_name(proc_selfpid(), name, sizeof(name));
+    if (strcmp(name, "configd") || service != IOService::getServiceRoot()) return;
+    static unsigned reports;
+    if (__atomic_fetch_add(&reports, 1U, __ATOMIC_RELAXED) >= 2) return;
+    IOLog("PICASSO_NETWORK configd root_busy=%u\n", busy);
+    if (!busy) return;
+    IORegistryIterator *it = IORegistryIterator::iterateOver(service, gIOServicePlane, kIORegistryIterateRecursively);
+    IORegistryEntry *entry;
+    unsigned visited = 0, reported = 0;
+    while (it && visited++ < 512 && (entry = it->getNextObject())) {
+        IOService *node = OSDynamicCast(IOService, entry);
+        if (!node || !node->getBusyState()) continue;
+        if (reported++ < 24) IOLog("PICASSO_NETWORK busy name=%s class=%s count=%u state=%llx\n",
+            node->getName(), node->getMetaClass()->getClassName(), node->getBusyState(), node->getState());
+    }
+    IOLog("PICASSO_NETWORK busy_scan visited=%u busy=%u valid=%u\n", visited, reported, it && it->isValid());
+    OSSafeReleaseNULL(it);
+}
