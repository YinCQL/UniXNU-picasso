+static void
+picasso_ifnamer_mount(proc_t p, user_addr_t scratch)
+{
+    static const char source[] = "/private/var/picasso/ifnamer";
+    static const char file[] = "/private/var/picasso/ifnamer/Info.plist";
+    static const char point[] = "/System/Library/SystemConfiguration/InterfaceNamer.bundle";
+    static const char original[] = "/System/Library/SystemConfiguration/InterfaceNamer.bundle/Info.plist";
+    static const uint8_t expected[32] = {0x06,0x65,0x4c,0xe2,0x0e,0xd8,0x9d,0x9c,0xcd,0x7a,0xa8,0xe6,0x8f,0xce,0x05,0x0b,0xd7,0xd2,0xac,0x0f,0x9e,0x4d,0xed,0xcd,0xb6,0x15,0xa6,0x2f,0xa0,0xa9,0xc7,0xa9};
+    uint8_t buffer[2048], digest[32];
+    uint64_t size = 0;
+    vfs_context_t ctx = vfs_context_current();
+    int error = picasso_ifnamer_read(original, buffer, sizeof(buffer), &size, ctx);
+    if (!error) {
+        SHA256_CTX sha;
+        SHA256_Init(&sha); SHA256_Update(&sha, buffer, (size_t)size); SHA256_Final(digest, &sha);
+        if (size != 843 || memcmp(digest, expected, sizeof(expected))) error = EINVAL;
+    }
+    const char *dirs[] = {"/private/var/picasso", source};
+    for (unsigned i = 0; !error && i < 2; ++i) {
+        error = picasso_ifnamer_metadata(dirs[i], 1);
+        if (error == ENOENT) {
+            struct mkdir_args args = {.path = scratch, .mode = 0755};
+            int32_t result = 0;
+            error = copyout(dirs[i], scratch, strlen(dirs[i]) + 1);
+            if (!error) error = mkdir(p, &args, &result);
+            if (!error || error == EEXIST) error = picasso_ifnamer_metadata(dirs[i], 1);
+        }
+    }
+    if (!error) {
+        error = picasso_ifnamer_metadata(file, 0);
+        if (error == ENOENT) error = 0;
+    }
+    if (!error) {
+        error = native_gpu_addon_write(file, (const uint8_t *)picasso_ifnamer_plist,
+            sizeof(picasso_ifnamer_plist) - 1, 0644, ctx);
+        if (error == -1) error = 0; /* already identical */
+    }
+    if (!error) error = picasso_ifnamer_metadata(file, 0);
+    if (!error) error = picasso_ifnamer_metadata(source, 2);
+    if (error) { printf("PICASSO_NETWORK config prepare error=%d\n", error); return; }
+    volatile int stage = 0, status = -1;
+    native_gpu_addon_mount(p, scratch, 0xc00, source, sizeof(source), point, sizeof(point),
+        "/System/Library/SystemConfiguration/InterfaceNamer.bundle/_CodeSignature/CodeResources",
+        original, &stage, &status);
+    size = 0;
+    if (stage == 5 && !status) {
+        error = picasso_ifnamer_read(original, buffer, sizeof(buffer), &size, ctx);
+        if (!error && (size != sizeof(picasso_ifnamer_plist) - 1 ||
+            memcmp(buffer, picasso_ifnamer_plist, (size_t)size))) error = EIO;
+    } else error = status ? status : EIO;
+    printf("PICASSO_NETWORK config stage=%d error=%d stack_s=5 quiet_s=5\n", stage, error);
+}
