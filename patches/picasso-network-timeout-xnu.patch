+static int
+picasso_ifnamer_directory(vnode_t vp, int signature, vfs_context_t ctx)
+{
+    char *buffer = kalloc_data(4096, Z_WAITOK);
+    uio_t uio = buffer ? uio_create(1, 0, UIO_SYSSPACE, UIO_READ) : NULL;
+    int error = uio ? 0 : ENOMEM, eof = 0;
+    static const char *const root_names[] = {"Info.plist", "_CodeSignature"};
+    static const char *const signature_names[] = {"CodeDirectory", "CodeRequirements",
+        "CodeRequirements-1", "CodeResources", "CodeSignature"};
+    const char *const *names = signature ? signature_names : root_names;
+    unsigned count = signature ? 5 : 2, found = 0;
+    for (unsigned batch = 0; !error && !eof && batch < 4; ++batch) {
+        uio_reset(uio, uio_offset(uio), UIO_SYSSPACE, UIO_READ);
+        error = uio_addiov(uio, CAST_USER_ADDR_T(buffer), 4096);
+        int entries = 0;
+        if (!error) error = VNOP_READDIR(vp, uio, 0, &eof, &entries, ctx);
+        if (error) break;
+        size_t used = 4096 - uio_resid(uio), at = 0;
+        const size_t header = offsetof(struct dirent, d_name);
+        while (at < used) {
+            if (used - at <= header) { error = EIO; break; }
+            const struct dirent *entry = (const struct dirent *)(buffer + at);
+            if (entry->d_reclen <= header || entry->d_reclen > used - at ||
+                entry->d_namlen >= entry->d_reclen - header || entry->d_name[entry->d_namlen]) {
+                error = EIO; break;
+            }
+            int dot = entry->d_namlen == 1 && entry->d_name[0] == '.';
+            int dotdot = entry->d_namlen == 2 && !memcmp(entry->d_name, "..", 2);
+            if (!dot && !dotdot) {
+                unsigned index = 0;
+                for (; index < count; ++index) {
+                    size_t length = strlen(names[index]);
+                    if (entry->d_namlen == length && !memcmp(entry->d_name, names[index], length)) break;
+                }
+                if (index == count || (found & (1U << index)) ||
+                    entry->d_type != (!signature && index == 1 ? DT_DIR : DT_REG)) {
+                    error = EINVAL; break;
+                }
+                found |= 1U << index;
+            }
+            at += entry->d_reclen;
+        }
+        if (!used && !eof) error = EIO;
+    }
+    if (!error && (!eof || found != (1U << count) - 1)) error = EINVAL;
+    if (uio) uio_free(uio);
+    if (buffer) kfree_data(buffer, 4096);
+    return error;
+}
