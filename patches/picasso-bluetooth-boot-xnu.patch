--- a/bsd/kern/kern_exit.c
+++ b/bsd/kern/kern_exit.c
@@ -2475,6 +2475,26 @@
 	task_t task = proc_task(p);
 
 
+#if __arm64__ && (DEVELOPMENT || DEBUG)
+    /* First failures remain observable with normal quiet-boot arguments. */
+    static const char *const bt_boot_names[] = {"backboardd", "SpringBoard", "bluetoothd", "BlueTool", "bluetoothuserd"};
+    static unsigned bt_boot_exits[5];
+    for (unsigned i = 0; i < 5; ++i) {
+        if (strcmp(p->p_name, bt_boot_names[i])) continue;
+        unsigned ticket = os_atomic_load(&bt_boot_exits[i], relaxed);
+        while (ticket < 4 && !os_atomic_cmpxchg(&bt_boot_exits[i], ticket, ticket + 1, relaxed))
+            ticket = os_atomic_load(&bt_boot_exits[i], relaxed);
+        if (ticket < 4) {
+            printf("PICASSO_BT_EXIT pid=%d name=%s rv=%x namespace=%u code=%llx cs=%llx\n",
+                proc_getpid(p), p->p_name, rv, p->p_exit_reason ? p->p_exit_reason->osr_namespace : 0,
+                p->p_exit_reason ? (unsigned long long)p->p_exit_reason->osr_code : 0ULL, (unsigned long long)proc_getcsflags(p));
+            picasso_service_description(p, rv, ticket + 1);
+            picasso_report_user_fault(p, rv, ticket + 1, "BTBOOT");
+        }
+        break;
+    }
+#endif
+
