+static int
+native_picasso_ui_pref_write(const char *path)
+{
+	vfs_context_t ctx = vfs_context_current();
+	vnode_t vp = NULLVP;
+	int error = vnode_open(path, O_CREAT | O_TRUNC | FWRITE | O_NOFOLLOW, 0644, 0, &vp, ctx);
+	if (error) {
+		return error;
+	}
+	int resid = 0;
+	error = vn_rdwr(UIO_WRITE, vp, (caddr_t)native_picasso_ui_prefs_plist,
+	    (int)sizeof(native_picasso_ui_prefs_plist), 0, UIO_SYSSPACE, IO_NOAUTH | IO_UNIT,
+	    vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+	if (!error && resid) {
+		error = EIO;
+	}
+	if (!error) {
+		struct vnode_attr va;
+		VATTR_INIT(&va);
+		VATTR_SET(&va, va_mode, 0644);
+		VATTR_SET(&va, va_uid, 501);
+		VATTR_SET(&va, va_gid, 501);
+		error = vnode_setattr(vp, &va, ctx);
+	}
+	if (!error) {
+		error = VNOP_FSYNC(vp, MNT_WAIT, ctx);
+	}
+	int close_error = vnode_close(vp, FWRITE, ctx);
+	return error ? error : close_error;
+}
+static int
+native_picasso_mkdir(proc_t p, user_addr_t scratch, const char *path)
+{
+	struct mkdir_args request = {.path = scratch + 0xb00, .mode = 0755};
+	int32_t result = 0;
+	int error = copyout(path, request.path, strlen(path) + 1);
+	if (!error) {
+		error = mkdir(p, &request, &result);
+	}
+	if (error && error != EEXIST) {
+		return error;
+	}
+	vnode_t vp = NULLVP;
+	error = vnode_lookup(path, VNODE_LOOKUP_NOFOLLOW, &vp, vfs_context_current());
+	if (!error) {
+		struct vnode_attr va;
+		VATTR_INIT(&va);
+		VATTR_SET(&va, va_uid, 501);
+		VATTR_SET(&va, va_gid, 501);
+		error = vnode_setattr(vp, &va, vfs_context_current());
+		vnode_put(vp);
+	}
+	return error;
+}
+static int
+native_picasso_copy_file(const char *source_path, const char *dest_path)
+{
+	vfs_context_t ctx = vfs_context_current();
+	vnode_t src = NULLVP, dst = NULLVP;
+	int error = vnode_open(source_path, O_RDONLY | O_NOFOLLOW, 0, 0, &src, ctx);
+	if (error) {
+		return error;
+	}
+	error = vnode_open(dest_path, O_CREAT | O_TRUNC | FWRITE | O_NOFOLLOW, 0755, 0, &dst, ctx);
+	if (error) {
+		vnode_close(src, FREAD, ctx);
+		return error;
+	}
+	void *buffer = kalloc_data(65536, Z_WAITOK);
+	if (!buffer) {
+		error = ENOMEM;
+		goto done;
+	}
+	off_t at = 0;
+	for (;;) {
+		int resid = 0;
+		error = vn_rdwr(UIO_READ, src, (caddr_t)buffer, 65536, at, UIO_SYSSPACE, IO_NOAUTH,
+		    vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+		int length = 65536 - resid;
+		if (error || !length) {
+			break;
+		}
+		error = vn_rdwr(UIO_WRITE, dst, (caddr_t)buffer, length, at, UIO_SYSSPACE,
+		    IO_NOAUTH | IO_UNIT, vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+		if (!error && resid) {
+			error = EIO;
+		}
+		if (error) {
+			break;
+		}
+		at += length;
+	}
+	kfree_data(buffer, 65536);
+	if (!error) {
+		struct vnode_attr va;
+		VATTR_INIT(&va);
+		VATTR_SET(&va, va_mode, 0755);
+		VATTR_SET(&va, va_uid, 501);
+		VATTR_SET(&va, va_gid, 501);
+		error = vnode_setattr(dst, &va, ctx);
+	}
+	if (!error) {
+		error = VNOP_FSYNC(dst, MNT_WAIT, ctx);
+	}
+done:
+	{
+		int close_error = vnode_close(dst, FWRITE, ctx);
+		if (!error) error = close_error;
+	}
+	{
+		int close_error = vnode_close(src, FREAD, ctx);
+		if (!error) error = close_error;
+	}
+	return error;
+}
+static void
+native_picasso_ui_prefs(proc_t p, user_addr_t scratch)
+{
+	int mobile_dir = native_picasso_mkdir(p, scratch, "/private/var/mobile/Library/picasso");
+	int var_dir = native_picasso_mkdir(p, scratch, "/private/var/picasso");
+	int mobile = mobile_dir ? mobile_dir : native_picasso_copy_file("/private/var/ngpu/libpicasso-sb.dylib",
+	    "/private/var/mobile/Library/picasso/libpicasso-sb.dylib");
+	int var = var_dir ? var_dir : native_picasso_copy_file("/private/var/ngpu/libpicasso-sb.dylib",
+	    "/private/var/picasso/libpicasso-sb.dylib");
+	int plist_mobile = native_picasso_ui_pref_write("/private/var/mobile/Library/Preferences/com.apple.UIKit.plist");
+	int plist_system = native_picasso_ui_pref_write("/private/var/preferences/com.apple.UIKit.plist");
+	printf("PICASSO_UI_PREFS provider=Pad_ForcedNoCell plist=%d/%d dylib=%d/%d\n",
+	    plist_mobile, plist_system, mobile, var);
+}
