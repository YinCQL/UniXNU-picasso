+static volatile int native_picasso_apps_stage = 0, native_picasso_apps_status = -1;
+/* The 29 separable iOS apps live in the OS volume's private/var/staged_system_apps and are absent from the
+ * iPad root's /Applications. The owner copy above puts them on Data; a union of that directory over the sealed
+ * /Applications adds their bundles to the path LaunchServices scans at boot. */
+/* The staged News app's widget stack (NewsFeed -> SiriUtilities -> PegasusAPI) force-unwraps the main
+ * CADisplay that this port's FrontBoardServices monitor cannot provide: with News.app visible over
+ * /Applications, SpringBoard traps there shortly after it starts (wf178, wf179, wf181). Keep the bundle
+ * in the staged directory, out of the union, until the display side can satisfy that code. */
+static void
+native_picasso_hide_unusable_app(proc_t p, user_addr_t scratch)
+{
+	static const char from[] = "/private/var/staged_system_apps/News.app";
+	static const char to[] = "/private/var/staged_system_apps/News.app.hidden";
+	struct rename_args request = {.from = scratch + 0xc00, .to = scratch + 0xd00};
+	int32_t result = 0;
+	int error = copyout(from, request.from, sizeof(from));
+	if (!error) {
+		error = copyout(to, request.to, sizeof(to));
+	}
+	if (!error) {
+		error = rename(p, &request, &result);
+	}
+	if (error && error != ENOENT) {
+		printf("PICASSO_APPS_HIDE app=News error=%d\n", error);
+	}
+}
+static void
+native_picasso_apps_mount(proc_t p, user_addr_t scratch)
+{
+	static const char source[] = "/private/var/staged_system_apps";
+	static const char point[] = "/Applications";
+	uint32_t picassoExtras = 7;
+	PE_parse_boot_argn("sheng-ui-extras", &picassoExtras, sizeof(picassoExtras));
+	if (!(picassoExtras & 1)) {
+		printf("PICASSO_APPS_MOUNT skipped extras=%u\n", picassoExtras);
+		return;
+	}
+	native_picasso_hide_unusable_app(p, scratch);
+	native_gpu_addon_mount(p, scratch, 0xc00, source, sizeof(source), point, sizeof(point),
+	    "/Applications/Camera.app/Info.plist", "/Applications/MobileMail.app/Info.plist",
+	    &native_picasso_apps_stage, &native_picasso_apps_status);
+	printf("PICASSO_APPS_MOUNT stage=%d status=%d\n", native_picasso_apps_stage, native_picasso_apps_status);
+}
