--- a/bsd/kern/kern_exec.c	2026-11-04 10:58:06
+++ b/bsd/kern/kern_exec.c	2026-11-04 10:58:06
@@ -7651,6 +7651,7 @@
 	native_gpu_addon_files = (int)count;
 	vfs_context_t ctx = vfs_context_current();
 	char path[192];
+	bool saw_publish = false, saw_clients = false;
 	at = 24;
 	for (uint32_t i = 0; i < count; ++i) {
 		uint32_t name_bytes = 0, mode = 0;
@@ -7662,6 +7663,8 @@
 		at += 24;
 		const char *name = (const char *)(addon + at);
 		at += (name_bytes + 7) & ~7ULL;
+		if (!strcmp(name, "addons/NativeAdrenoMetal.publish")) saw_publish = true;
+		if (!strcmp(name, "addons/NativeAdrenoMetal.clients")) saw_clients = true;
 		snprintf(path, sizeof(path), "/private/var/ngpu/%s", name);
 		uint8_t *data = kalloc_data(size ? size : 1, Z_WAITOK);
