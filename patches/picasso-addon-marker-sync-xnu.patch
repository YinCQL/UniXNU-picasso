@@ -7684,6 +7687,26 @@
 		}
 		at += (packed + 7) & ~7ULL;
 	}
+	/* The addon is the authority for its own directory. A publish/clients marker
+	 * left behind by an earlier published addon survives the Data volume and
+	 * kept the Metal plugin in its production path after the unpublished addon
+	 * was installed (wf214 -> wf215/wf216), which wedges the render server. */
+	if (!saw_publish) {
+		struct unlink_args request = { .path = scratch + 0x800 };
+		const char *stale = "/private/var/ngpu/addons/NativeAdrenoMetal.publish";
+		int32_t result = 0;
+		if (!copyout(stale, request.path, strlen(stale) + 1)) {
+			(void)unlink(p, &request, &result);
+		}
+	}
+	if (!saw_clients) {
+		struct unlink_args request = { .path = scratch + 0x900 };
+		const char *stale = "/private/var/ngpu/addons/NativeAdrenoMetal.clients";
+		int32_t result = 0;
+		if (!copyout(stale, request.path, strlen(stale) + 1)) {
+			(void)unlink(p, &request, &result);
+		}
+	}
