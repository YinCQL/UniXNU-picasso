 static bool native_sandbox_grant(IOService * service);
+// Board-scoped backlight compatibility follows the display tutorial. Only the
+// original platform backboardd may send this service's typed actuator request;
+// no generic user-client/open grant or telemetry-to-command conversion.
+extern "C" bool picasso_brightness_is_service(IORegistryEntry *) __attribute__((weak_import));
+#if CONFIG_MACF
+static int
+picasso_brightness_caller(void)
+{
+	proc_t p = (proc_t)get_bsdtask_info(current_task());
+	if (!p) return 1;
+	if (!csproc_get_platform_binary(p)) return 2;
+	char name[32] = {};
+	proc_name(proc_selfpid(), name, sizeof(name));
+	if (strcmp(name, "backboardd")) return 3;
+	vnode_t vp = proc_getexecutablevnode(p);
+	if (!vp) return 4;
+	char path[128] = {};
+	int length = sizeof(path);
+	int error = vn_getpath(vp, path, &length);
+	vnode_put(vp);
+	return error ? 5 : strcmp(path, "/usr/libexec/backboardd") ? 6 : 0;
+}
+
+static int
+picasso_iokit_set_properties_check(IORegistryEntry *entry, OSObject **object)
+{
+	IOService *service = OSDynamicCast(IOService, entry);
+	const bool board = picasso_brightness_is_service && picasso_brightness_is_service(entry);
+	// Preserve the existing policy for all other services.
+	if (!board && service && native_sandbox_grant(service)) return 0;
+	int original = mac_iokit_check_set_properties(kauth_cred_get(), entry, *object);
+	if (!board) return original;
+	int verdict = original;
+	bool allowed = false;
+	OSDictionary *dict = OSDynamicCast(OSDictionary, *object);
+	OSNumber *level = dict ? OSDynamicCast(OSNumber, dict->getObject("brightness")) : nullptr;
+	OSNumber *fade = dict ? OSDynamicCast(OSNumber, dict->getObject("FadePeriod")) : nullptr;
+	OSNumber *panel = dict ? OSDynamicCast(OSNumber, dict->getObject("backlight-level")) : nullptr;
+	auto integer = [](OSNumber *n, uint64_t maximum) {
+		return n && (n->numberOfBits() == 8 || n->numberOfBits() == 16 ||
+		    n->numberOfBits() == 32 || n->numberOfBits() == 64) &&
+		    n->unsigned64BitValue() <= maximum;
+	};
+	bool valid = dict && integer(level, 4095) &&
+	    (!dict->getObject("FadePeriod") || integer(fade, UINT32_MAX)) &&
+	    (!dict->getObject("backlight-level") || integer(panel, 4095)) &&
+	    dict->getCount() == 1U + (fade ? 1U : 0U) + (panel ? 1U : 0U);
+	int caller = original && valid ? picasso_brightness_caller() : -1;
+	if (original && valid && caller == 0) {
+		// Original profiles cannot name this board driver. The tutorial grants
+		// all service properties by process name; constrain that rule here to
+		// this exact live service, executable identity and three integer keys.
+		allowed = true;
+		verdict = 0;
+	}
+	static unsigned reports;
+	unsigned ticket = __atomic_fetch_add(&reports, 1U, __ATOMIC_RELAXED);
+	if (ticket < 128 || !(ticket & 63))
+		IOLog("PICASSO_BRIGHTNESS mac original=%d final=%d backlight_rule=%u valid=%u caller=%d pid=%d\n",
+		    original, verdict, allowed, valid, caller, proc_selfpid());
+	dict = OSDynamicCast(OSDictionary, *object);
+	if (dict && ticket < 16) {
+		OSCollectionIterator *it = OSCollectionIterator::withCollection(dict);
+		OSObject *key;
+		for (unsigned n = 0; it && n < 4 && (key = it->getNextObject()); ++n) {
+			OSString *name = OSDynamicCast(OSString, key);
+			OSObject *value = name ? dict->getObject(name->getCStringNoCopy()) : nullptr;
+			OSNumber *number = OSDynamicCast(OSNumber, value);
+			IOLog("PICASSO_BRIGHTNESS key=%s number=%u value=%llu bits=%u dictionary=%u\n",
+			    name ? name->getCStringNoCopy() : "<invalid>", number != nullptr,
+			    number && number->numberOfBits() != 31 && number->numberOfBits() != 63 ? number->unsigned64BitValue() : 0ULL,
+			    number ? number->numberOfBits() : 0, OSDynamicCast(OSDictionary, value) != nullptr);
+		}
+		OSSafeReleaseNULL(it);
+	}
+	return verdict;
+}
+#endif
