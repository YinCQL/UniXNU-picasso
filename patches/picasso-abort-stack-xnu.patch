--- a/bsd/kern/kern_exit.c
+++ b/bsd/kern/kern_exit.c
@@ -1741,8 +1741,49 @@
 		picasso_service_description(p, rv, ticket);
 		picasso_report_user_fault(p, rv, ticket, "SERVICE");
 		return;
+	}
+}
+/* PICASSO_ABORTSTACK_BEGIN: where a UI service stood when it raised SIGABRT.
+ * The exit report names only signal 6: the abort payload carries no text and
+ * the userspace console cannot be reached. The dying thread is the one that
+ * raised the signal and its saved user state is still the interrupted frame,
+ * so its frame-pointer chain is the abort's caller stack. Resolve addresses
+ * with the printed dyld shared-cache slide and the first image's path. */
+static void
+picasso_abort_stack(proc_t p, int rv)
+{
+	static unsigned reports;
+	if (!WIFSIGNALED(rv) || WTERMSIG(rv) != SIGABRT) return;
+	if (strcmp(p->p_name, "backboardd") && strcmp(p->p_name, "SpringBoard")) return;
+	if (__atomic_fetch_add(&reports, 1, __ATOMIC_RELAXED) >= 8) return;
+	extern struct arm_saved_state *find_user_regs(thread_t);
+	struct arm_saved_state *state = find_user_regs(current_thread());
+	if (!state || !is_saved_state64(state) || !PSR64_IS_USER64(get_saved_state_cpsr(state))) {
+		printf("PICASSO_ABORTSTACK pid=%d name=%s no-state\n", proc_getpid(p), p->p_name);
+		return;
+	}
+	const uint64_t pc = get_saved_state_pc(state), lr = get_saved_state_lr(state);
+	const uint64_t sp = get_saved_state_sp(state), fp = get_saved_state_fp(state);
+	struct user64_dyld_all_image_infos info = {0};
+	const int info_error = copyin((user_addr_t)task_get_all_image_info_addr(current_task()),
+	    &info, sizeof(info));
+	printf("PICASSO_ABORTSTACK pid=%d name=%s unique=%llu pc=%llx lr=%llx sp=%llx fp=%llx slide=%llx info_error=%d\n",
+	    proc_getpid(p), p->p_name, (unsigned long long)proc_uniqueid(p),
+	    (unsigned long long)pc, (unsigned long long)lr, (unsigned long long)sp,
+	    (unsigned long long)fp, (unsigned long long)(info_error ? 0 : info.sharedCacheSlide),
+	    info_error);
+	uint64_t frame = fp;
+	for (unsigned depth = 0; depth < 8; ++depth) {
+		uint64_t pair[2] = {0, 0};
+		if (!frame || (frame & 15) || frame < sp) break;
+		if (copyin((user_addr_t)frame, pair, sizeof(pair))) break;
+		printf("PICASSO_ABORTSTACK frame pid=%d depth=%u fp=%llx lr=%llx\n",
+		    proc_getpid(p), depth, (unsigned long long)pair[0], (unsigned long long)pair[1]);
+		if (pair[0] <= frame) break;
+		frame = pair[0];
 	}
 }
+/* PICASSO_ABORTSTACK_END */
 /* PICASSO_SERVICE_EXIT_END */
 #endif
 /* PICASSO_USER_FAULT_END */
@@ -2462,6 +2503,7 @@
 		    p->p_exit_reason?(unsigned long long)p->p_exit_reason->osr_code:0ULL);
 	}
 	picasso_report_service_exit(p, rv);
+	picasso_abort_stack(p, rv);
 	picasso_report_service_wait(p, rv);
 #endif
 /* PICASSO_SERVICE_TRACE_END */
