+		 * boot log at the moment the command arrives. */
+		extern char native_adreno_metal_rows[48][96];
+		extern volatile uint32_t native_adreno_metal_rows_seq;
+		printf("PICASSO_GPU_TABLE begin seq=%u\n", native_adreno_metal_rows_seq);
+		for (unsigned row = 0; row < 48; ++row) {
+			if (native_adreno_metal_rows[row][0]) {
+				printf("PICASSO_GPU_TABLE %u %s\n", row, native_adreno_metal_rows[row]);
+			}
+		}
+		printf("PICASSO_GPU_TABLE end\n");
+	}
 	if (ud.register_pending && !ud.panic_mode) {
 		ud.register_pending = false;
