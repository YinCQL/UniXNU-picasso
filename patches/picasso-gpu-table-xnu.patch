index a3ea1ab..263b4d1 100644
--- a/bsd/dev/picasso_usb.c
+++ b/bsd/dev/picasso_usb.c
@@ -384,6 +384,7 @@ static struct {
 	unsigned    ps_pending;
 	bool        save_ls_pending;
 	bool        ls_scan_pending;
+	bool        gpu_table_pending;
 	bool        register_pending;
 	int         publish_pending;
 	bool        watchdog;
@@ -2461,6 +2462,9 @@ ud_process_command(void)
 	} else if (ud_command_is(ud.cmd, "ls-scan")) {
 		printf("PICASSO CDC: ls-scan requested; scanning after the lock\n");
 		ud.ls_scan_pending = true;
+	} else if (ud_command_is(ud.cmd, "gpu-table")) {
+		printf("PICASSO CDC: gpu-table requested; dumping after the lock\n");
+		ud.gpu_table_pending = true;
 	} else if (ud_command_is(ud.cmd, "panic-test")) {
 		printf("PICASSO CDC: panic-test requested; emitting marker now\n");
