+/* One read-only library union; signature/MAC/VM checks run normally on load. */
+static void
+picasso_ui_library_mount(proc_t p, user_addr_t scratch)
+{
+    static const char source[] = "/private/var/picasso/usr-lib";
+    static const char point[] = "/usr/lib";
+    static const char library[] = "/usr/lib/libpicasso-sb.dylib";
+    char requested[128] = {};
+    if (!PE_parse_boot_argn("picasso_inject_sb", requested, sizeof(requested)) ||
+        strcmp(requested, library)) return;
+    int error = picasso_ui_library_prepare();
+    if (error) { printf("PICASSO_INJECT view prepare error=%d\n", error); return; }
+    volatile int stage = 0, status = -1;
+    native_gpu_addon_mount(p, scratch, 0xc00, source, sizeof(source), point, sizeof(point),
+        "/usr/lib/dyld", library, &stage, &status);
+    printf("PICASSO_INJECT view stage=%d error=%d path=%s\n", stage, status, library);
+}
