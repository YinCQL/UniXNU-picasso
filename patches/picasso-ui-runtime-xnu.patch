+#if DEVELOPMENT || DEBUG
+/* Validate the entire upper directory before giving it a system view. This
+ * boot-only seed is not a general library overlay or a writable plugin path. */
+static int
+picasso_ui_library_directory(vnode_t vp, vfs_context_t ctx)
+{
+    char *buffer = kalloc_data(4096, Z_WAITOK);
+    uio_t uio = buffer ? uio_create(1, 0, UIO_SYSSPACE, UIO_READ) : NULL;
+    int error = uio ? 0 : ENOMEM, eof = 0;
+    unsigned found = 0;
+    for (unsigned batch = 0; !error && !eof && batch < 4; ++batch) {
+        uio_reset(uio, uio_offset(uio), UIO_SYSSPACE, UIO_READ);
+        error = uio_addiov(uio, CAST_USER_ADDR_T(buffer), 4096);
+        int entries = 0;
+        if (!error) error = VNOP_READDIR(vp, uio, 0, &eof, &entries, ctx);
+        if (error) break;
+        size_t used = 4096 - uio_resid(uio), at = 0;
+        const size_t header = offsetof(struct dirent, d_name);
+        while (at < used) {
+            if (used - at <= header) { error = EIO; break; }
+            const struct dirent *entry = (const struct dirent *)(buffer + at);
+            if (entry->d_reclen <= header || entry->d_reclen > used - at ||
+                entry->d_namlen >= entry->d_reclen - header || entry->d_name[entry->d_namlen]) {
+                error = EIO; break;
+            }
+            int dot = entry->d_namlen == 1 && entry->d_name[0] == '.';
+            int dotdot = entry->d_namlen == 2 && !memcmp(entry->d_name, "..", 2);
+            if (!dot && !dotdot) {
+                if (entry->d_namlen != sizeof("libpicasso-sb.dylib") - 1 ||
+                    memcmp(entry->d_name, "libpicasso-sb.dylib", sizeof("libpicasso-sb.dylib") - 1) || ++found != 1) {
+                    error = EINVAL; break;
+                }
+            }
+            at += entry->d_reclen;
+        }
+        if (!used && !eof) error = EIO;
+    }
+    if (!error && (!eof || found != 1)) error = EINVAL;
+    if (uio) uio_free(uio);
+    if (buffer) kfree_data(buffer, 4096);
+    return error;
+}
+
+static int
+picasso_ui_library_prepare(void)
+{
+    const char *paths[] = {"/private/var/picasso", "/private/var/picasso/usr-lib",
+        "/private/var/picasso/usr-lib/libpicasso-sb.dylib"};
+    vfs_context_t ctx = vfs_context_current();
+    for (unsigned i = 0; i < 3; ++i) {
+        vnode_t vp = NULLVP;
+        int error = vnode_lookup(paths[i], VNODE_LOOKUP_NOFOLLOW, &vp, ctx);
+        if (error) return error;
+        if (vnode_vtype(vp) != (i == 2 ? VREG : VDIR)) error = EINVAL;
+        if (!error && i == 1) error = picasso_ui_library_directory(vp, ctx);
+        if (!error) {
+            struct vnode_attr va;
+            VATTR_INIT(&va);
+            VATTR_SET(&va, va_mode, i == 2 ? 0644 : 0755);
+            VATTR_SET(&va, va_uid, 0);
+            VATTR_SET(&va, va_gid, 0);
+            error = vnode_setattr(vp, &va, ctx);
+            if (!error) {
+                VATTR_INIT(&va);
+                VATTR_WANTED(&va, va_mode); VATTR_WANTED(&va, va_uid); VATTR_WANTED(&va, va_gid);
+                error = vnode_getattr(vp, &va, ctx);
+                if (!error && (!VATTR_IS_SUPPORTED(&va, va_mode) || !VATTR_IS_SUPPORTED(&va, va_uid) ||
+                    !VATTR_IS_SUPPORTED(&va, va_gid) || va.va_uid || va.va_gid ||
+                    (va.va_mode & 07777) != (i == 2 ? 0644 : 0755))) error = EPERM;
+            }
+        }
+        vnode_put(vp);
+        if (error) return error;
+    }
+    return 0;
+}
