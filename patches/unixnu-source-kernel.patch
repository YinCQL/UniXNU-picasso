++	bzero(out, PICASSO_IOS16_LIMITS);
++	memcpy(out, in, 0x08);
++	picasso_narrow(out, 0x08, in, 0x08);
++	picasso_narrow(out, 0x0c, in, 0x10);
++	picasso_narrow(out, 0x10, in, 0x18);
++	out[0x14] = in[0x20];
++	memcpy(out + 0x16, in + 0x22, 2);
++}
