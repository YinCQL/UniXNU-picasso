++static unsigned
++picasso_smmu_addr_bits(unsigned code)
++{
++	switch (code) {
++	case 0: return 32;
++	case 1: return 36;
++	case 2: return 40;
++	case 3: return 42;
++	case 4: return 44;
++	case 5: return 48;
++	default: return 0;
++	}
++}
++
++static inline void
++picasso_usb_smmu_write(vm_offset_t base, uint32_t off, uint32_t value)
++{
++	*(volatile uint32_t *)(base + off) = value;
++	__asm__ volatile ("dsb sy" ::: "memory");
++}
