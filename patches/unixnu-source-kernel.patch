diff --git a/patches/xnu/picasso-fb-method-trace.patch b/patches/xnu/picasso-fb-method-trace.patch
new file mode 100644
index 0000000000000000000000000000000000000000..2bcbc12745dfaa4f42f62cc3dbf3d193666aaecd
--- /dev/null
+++ b/patches/xnu/picasso-fb-method-trace.patch
@@ -0,0 +1,99 @@
+diff --git a/iokit/Kernel/IOUserClient.cpp b/iokit/Kernel/IOUserClient.cpp
+--- a/iokit/Kernel/IOUserClient.cpp
++++ b/iokit/Kernel/IOUserClient.cpp
+@@ -6425,2 +6425,77 @@ is_io_device_tree_entry_exists_with_name(
++/* PICASSO_FB_METHOD_TRACE_BEGIN */
++#if DEVELOPMENT || DEBUG
++struct picasso_fb_method_trace {
++	unsigned ticket, selector;
++	int pid;
++	uint64_t tid;
++};
++
++static picasso_fb_method_trace
++picasso_fb_method_begin(IOUserClient *client, uint32_t selector,
++    const IOExternalMethodArguments *args)
++{
++	picasso_fb_method_trace trace = {};
++	if (!client || !args ||
++	    !client->metaCast("IOMobileFramebufferUserClient")) return trace;
++	unsigned operation;
++	if (selector == 4) operation = 0;
++	else if (selector == 5) operation = 1;
++	else if (selector == 72) operation = 2;
++	else return trace;
++	char name[32] = {};
++	int pid = proc_selfpid();
++	proc_name(pid, name, sizeof(name));
++	unsigned process;
++	if (!strcmp(name, "backboardd")) process = 0;
++	else if (!strcmp(name, "SpringBoard")) process = 1;
++	else return trace;
++	static unsigned budgets[2][3];
++	unsigned *counter = &budgets[process][operation];
++	unsigned value = __atomic_load_n(counter, __ATOMIC_RELAXED);
++	while (value < 3) {
++		if (__atomic_compare_exchange_n(counter, &value, value + 1, false,
++		    __ATOMIC_RELAXED, __ATOMIC_RELAXED)) {
++			trace.ticket = value + 1;
++			break;
++		}
++	}
++	if (!trace.ticket) return trace;
++	trace.selector = selector;
++	trace.pid = pid;
++	trace.tid = thread_tid(current_thread());
++	uint64_t bytes = args->structureInputDescriptor ?
++	    args->structureInputDescriptor->getLength() : args->structureInputSize;
++	printf("PICASSO_FB begin sel=%u sample=%u pid=%d tid=%llu in_bytes=%llu in_scalar=%u out_bytes=%u out_scalar=%u\n",
++	    selector, trace.ticket, pid, (unsigned long long)trace.tid,
++	    (unsigned long long)bytes, args->scalarInputCount,
++	    args->structureOutputSize, args->scalarOutputCount);
++	if (selector == 5 && !args->structureInputDescriptor &&
++	    args->structureInput && args->structureInputSize == 1132) {
++		const uint8_t *input = static_cast<const uint8_t *>(args->structureInput);
++		uint64_t low = 0, high = 0;
++		for (unsigned i = 0; i < 1132; ++i) {
++			if (!input[i]) continue;
++			unsigned block = i / 16;
++			if (block < 64) low |= 1ULL << block;
++			else high |= 1ULL << (block - 64);
++		}
++		printf("PICASSO_FB shape sel=5 sample=%u pid=%d blocks16_lo=%016llx blocks16_hi=%016llx\n",
++		    trace.ticket, pid, (unsigned long long)low, (unsigned long long)high);
++	}
++	return trace;
++}
++
++static void
++picasso_fb_method_end(const picasso_fb_method_trace &trace,
++    const IOExternalMethodArguments *args, IOReturn result)
++{
++	if (!trace.ticket) return;
++	printf("PICASSO_FB end sel=%u sample=%u pid=%d tid=%llu result=%x out_bytes=%u out_scalar=%u\n",
++	    trace.selector, trace.ticket, trace.pid, (unsigned long long)trace.tid,
++	    (unsigned)result, args->structureOutputSize, args->scalarOutputCount);
++}
++#endif
++/* PICASSO_FB_METHOD_TRACE_END */
++
+ IOReturn
+ IOUserClient::callExternalMethod(uint32_t selector, IOExternalMethodArguments * args)
+@@ -6430,2 +6505,8 @@ IOUserClient::callExternalMethod(uint32_t selector, IOExternalMethodArguments *
++/* PICASSO_FB_METHOD_HOOK_BEGIN */
++#if DEVELOPMENT || DEBUG
++	picasso_fb_method_trace fbTrace = picasso_fb_method_begin(this, selector, args);
++#endif
++/* PICASSO_FB_METHOD_HOOK_END */
++
+ 	ipcEnter(defaultLocking ? (defaultLockingSingleThreadExternalMethod ? kIPCLockWrite : kIPCLockRead) : kIPCLockNone);
+ 	if (uc2022) {
+@@ -6438,2 +6519,8 @@ IOUserClient::callExternalMethod(uint32_t selector, IOExternalMethodArguments *
++/* PICASSO_FB_METHOD_HOOK_BEGIN */
++#if DEVELOPMENT || DEBUG
++	picasso_fb_method_end(fbTrace, args, ret);
++#endif
++/* PICASSO_FB_METHOD_HOOK_END */
++
+ 	return ret;
+ }
diff --git a/patches/xnu/picasso-timebase-microtime.patch b/patches/xnu/picasso-timebase-microtime.patch
new file mode 100644
index 0000000000000000000000000000000000000000..3d55270f27cc0c10bc28eb86ad570f2ecca77ea2
--- /dev/null
+++ b/patches/xnu/picasso-timebase-microtime.patch
@@ -0,0 +1,12 @@
+diff --git a/osfmk/arm/rtclock.c b/osfmk/arm/rtclock.c
+--- a/osfmk/arm/rtclock.c
++++ b/osfmk/arm/rtclock.c
+@@ -471,2 +471,7 @@ absolutetime_to_microtime(uint64_t       abstime,
+-	*microsecs = (uint32_t)(abstime / rtclock_usec_divisor);
++	/* Native counters need not have an integral number of ticks per usec.
++	 * At 19.2 MHz, dividing by floor(19.2) produces usecs above 999999 and
++	 * makes the timestamp go backwards at each second boundary. Scale the
++	 * subsecond remainder instead; it is below the u32 second divisor, so
++	 * its u64 product with USEC_PER_SEC cannot overflow. */
++	*microsecs = (clock_usec_t)((abstime * USEC_PER_SEC) / rtclock_sec_divisor);
+ }
