++static bool
++ud_poll_serialized(void)
++{
++	if (!os_atomic_cmpxchg(&ud.poll_lock, 0, 1, acquire)) {
++		return false;
++	}
++	ud_poll();
++	/* picasso_session_s=N: a bounded test session ends in Fastboot by itself, the
++	 * same way the reboot-fastboot console command does, so no button is needed. */
++	if (ud.session_deadline && !ud.panic_mode && !ud.reboot_pending &&
++	    mach_absolute_time() >= ud.session_deadline) {
++		ud.session_deadline = 0;
++		printf("PICASSO CDC: session time is over; reboot-fastboot\n");
++		picasso_usb_watchdog_terminal();
++		ud.reboot_pending = true;
++	}
++	bool normal = !ud.panic_mode && !ud.reboot_pending && !ud.hang_pending &&
++	    !ud.panic_pending && !ud.reset_pending;
++	os_atomic_store(&ud.poll_lock, 0, release);
++	if (ud.reboot_pending && !ud.panic_mode) {
++		ud.reboot_pending = false;
++		ud_finish_reboot();
++	}
++	if (ud.hang_pending && !ud.panic_mode) {
++		ud.hang_pending = false;
++		ud_finish_hang();
++	}
++	if (ud.panic_pending && !ud.panic_mode) {
++		ud.panic_pending = false;
++		panic("PICASSO CDC PANIC TEST: synchronous panic capture is active");
++	}
++	if (ud.reset_pending && !ud.panic_mode) {
++		ud.reset_pending = false;
++		ud_finish_reboot();
++	}
++	return normal && !ud.panic_mode;
++}
