++static void
++picasso_usb_sync_mark(const char *text)
++{
++	while (*text != '\0') {
++		console_write_unbuffered(*text++);
++	}
++	console_write_unbuffered('\n');
++}
++
++static void
++picasso_usb_sync_mark_index(const char *text, unsigned index)
++{
++	char digits[10];
++	unsigned count = 0;
++
++	while (*text != '\0') {
++		console_write_unbuffered(*text++);
++	}
++	do {
++		digits[count++] = (char)('0' + index % 10);
++		index /= 10;
++	} while (index != 0);
++	while (count != 0) {
++		console_write_unbuffered(digits[--count]);
++	}
++	console_write_unbuffered('\n');
++}
++
++static void
++picasso_usb_sync_hex(const char *text, uint32_t value)
++{
++	static const char hex[] = "0123456789abcdef";
++
++	while (*text != '\0') {
++		console_write_unbuffered(*text++);
++	}
++	console_write_unbuffered('0');
++	console_write_unbuffered('x');
++	for (int shift = 28; shift >= 0; shift -= 4) {
++		console_write_unbuffered(hex[(value >> shift) & 0xfu]);
++	}
++	console_write_unbuffered('\n');
++}
