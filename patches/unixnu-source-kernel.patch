++	/*
++	 * The panic stream is already sent synchronously. Repeat the bounded
++	 * drain so the final backtrace/stackshot bytes reach the host before
++	 * the reset removes power from the USB controller.
++	 */
++	for (unsigned i = 0; i < 8; i++) {
++		picasso_usb_panic_flush();
++		picasso_usb_busy_wait(1000);
++	}
++	(void)picasso_usb_arm_fastboot_reason();
++	static const char reset_notice[] =
++	    "\r\n=== PICASSO CDC PANIC FLUSH COMPLETE: FASTBOOT REASON ARMED ===\r\n";
++	picasso_usb_panic_write(reset_notice, sizeof(reset_notice) - 1);
++	picasso_usb_panic_flush();
++	picasso_usb_system_reset();
++}
