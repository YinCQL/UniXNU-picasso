++static void
++ud_setup(void)
++{
++	const uint8_t *st = (const uint8_t *)(ud.dma + UD_SETUP);
++	uint8_t *data = (uint8_t *)(ud.dma + UD_DATA);
++	uint8_t type = st[0], req = st[1];
++	uint16_t value = (uint16_t)(st[2] | st[3] << 8);
++	uint16_t index = (uint16_t)(st[4] | st[5] << 8);
++	uint16_t length = (uint16_t)(st[6] | st[7] << 8);
++	uint32_t n = 0;
++	bool ok = true;
++
++	ud.data_in = (type & 0x80) != 0;
++	ud.last_request = req;
++	ud.data_length = length;
++	if (ud.setups++ < 96) {
++		printf("PICASSO USB: setup type=%02x req=%02x value=%04x index=%04x len=%u\n",
++		    type, req, value, index, length);
++	}
++	if (type == 0xc0 && req == UD_DIAG_REQUEST && index == 0) {
++		struct ud_diag diag;
++		ud_diag_snapshot(&diag);
++		n = MIN((uint32_t)length, (uint32_t)sizeof(diag));
++		memcpy(data, &diag, n);
++	} else if ((type & 0x60) == 0x20) {   /* CDC class requests on control interface 0 */
++		if ((type & 0x1f) != 1 || index != 0) {
++			ok = false;
++		} else if (req == 0x20 && type == 0x21 && length == sizeof(ud_line_coding)) {
++			/* SET_LINE_CODING: copy the host's seven-byte OUT data stage below. */
++		} else if (req == 0x21 && type == 0xa1) {
++			memcpy(data, ud_line_coding, sizeof(ud_line_coding));
++			n = sizeof(ud_line_coding);
++		} else if (req == 0x22 && type == 0x21 && length == 0) {
++			/* SET_CONTROL_LINE_STATE: bit 0 tracks the host opening the port. */
++			bool was_open = ud.host_open;
++			ud.host_open = (value & 1u) != 0;
++			if (ud.host_open && !was_open && ud.configured) {
++				ud_dump_ep_state("host-open", EP_RX);
++			}
++		} else if (req == 0x23 && type == 0x21 && length == 0) {
++			/* SEND_BREAK: accepted, no device action. */
++		} else {
++			ok = false;
++		}
++	} else if ((type & 0x60) != 0) {
++		ok = false;
++	} else if (req == 6) {          /* GET_DESCRIPTOR */
++		switch (value >> 8) {
++		case 1: memcpy(data, ud_dev_desc, sizeof(ud_dev_desc)); n = sizeof(ud_dev_desc); break;
++		case 2:
++			memcpy(data, ud_cfg_desc, sizeof(ud_cfg_desc));
++			n = sizeof(ud_cfg_desc);
++			for (uint32_t i = 0; i + 5 < n && data[i] >= 2; i += data[i]) {
++				if (data[i + 1] == 5 && (data[i + 3] & 3u) == 2u) {
++					data[i + 4] = (uint8_t)ud.mps;
++					data[i + 5] = (uint8_t)(ud.mps >> 8);
++				}
++			}
++			break;
++		case 3: n = ud_string(value & 0xff, data); ok = n != 0; break;
++		default: ok = false; break;
++		}
++	} else if (req == 5) {          /* SET_ADDRESS */
++		uint32_t dcfg = dwc_rd(DCFG) & ~(0x7fu << 3);
++		dwc_wr(DCFG, dcfg | ((uint32_t)(value & 0x7f) << 3));
++	} else if (req == 9) {          /* SET_CONFIGURATION */
++		if (value == 1) {
++			ud_configure();
++		}
++	} else if (req == 8) {          /* GET_CONFIGURATION */
++		data[0] = ud.configured ? 1 : 0; n = 1;
++	} else if (req == 0) {          /* GET_STATUS */
++		data[0] = 0; data[1] = 0; n = 2;
++	} else if (req == 1 && type == 0x02 && value == 0 &&
++	    index != 0 && (index & 0x70) == 0) {
++		/* CLEAR_FEATURE(ENDPOINT_HALT), including macOS's open-time clear. */
++		unsigned ep = (index & 0x0f) * 2 + ((index >> 7) & 1);
++		if (ep >= 6) {
++			ok = false;
++		} else {
++			printf("PICASSO USB: clear halt ep=0x%02x phys=%u busy=%u rsc=%u\n",
++			    index, ep, ep == EP_RX ? ud.rx_busy :
++			    ep == EP_TX ? ud.tx_busy :
++			    ep == EP_NOTIFY ? ud.notify_busy : 0u, ud.resource[ep]);
++			if (ud.resource[ep] != 0) {
++				ud_epcmd(ep, DEPCMD_ENDTRANSFER | DEPCMD_FORCE_RM |
++				    (ud.resource[ep] << 16), 0, 0, 0);
++				ud.resource[ep] = 0;
++			}
++			if (ud_epcmd(ep, DEPCMD_CLEARSTALL, 0, 0, 0) != 0) {
++				ok = false;
++			} else {
++				if (ep == EP_RX) {
++					ud.rx_busy = false;
++					ud.rx_transfer_started = false;
++				} else if (ep == EP_TX) {
++					ud.tx_busy = false;
++				} else if (ep == EP_NOTIFY) {
++					ud.notify_busy = false;
++				}
++			}
++		}
++	} else if (req == 11 && (type & 0x1f) == 1 && index == 1 && value == 0) {
++		/* SET_INTERFACE: the sole data-interface alternate setting is zero. */
++	} else if (req == 10 && (type & 0x1f) == 1 && index == 1) {
++		data[0] = 0; n = 1;          /* GET_INTERFACE: alternate setting zero */
++	} else {
++		ok = false;
++	}
++	if (!ok) {
++		ud_stall();
++		return;
++	}
++	if (req == 1 && type == 0x02 && index == 0x01) {
++		ud_start_rx();
++	}
++	if (length == 0) {
++		ud.state = EP0_WAIT_STATUS2;
++		return;
++	}
++	ud.state = EP0_DATA;
++	if (ud.data_in) {
++		if (n > length) {
++			n = length;
++		}
++		ud_ep0_start_recovering(1, UD_TRB_IN, UD_DATA, n, TRBCTL_DATA,
++		    "data-in no-resource");
++	} else {
++		ud_ep0_start_recovering(0, UD_TRB_OUT, UD_DATA, length, TRBCTL_DATA,
++		    "data-out no-resource");
++	}
++}
++
++static void
++ud_tx_pump(void)
++{
++	if (!ud.configured || ud.tx_busy) {
++		return;
++	}
++	uint32_t n = 0;
++	if (ud.panic_mode) {
++		n = pup_copy((char *)(ud.dma + UD_TX), UD_TX_SIZE);
++		if (n == 0) {
++			return;
++		}
++	} else {
++		n = pur_copy(&ud.tx_pos, (char *)(ud.dma + UD_TX), UD_TX_SIZE);
++	}
++	if (n == 0) {
++		return;
++	}
++	ud.tx_busy = true;
++	ud.chars += n;
++	ud_start_trb(EP_TX, UD_TRB_TX, UD_TX, n, TRBCTL_NORMAL);
++}
++
++static void
++ud_rx_consume(const uint8_t *data, uint32_t size)
++{
++	for (uint32_t i = 0; i < size; i++) {
++		char c = (char)data[i];
++		if (c == '\r' || c == '\n') {
++			if (ud.cmd_len != 0 && !ud.cmd_pending) {
++				ud.cmd[ud.cmd_len] = '\0';
++				ud.cmd_pending = true;
++			}
++			ud.cmd_len = 0;
++		} else if (c == '\b' || c == 0x7f) {
++			if (ud.cmd_len != 0) {
++				ud.cmd_len--;
++			}
++		} else if (c >= ' ' && c <= '~') {
++			if (ud.cmd_len + 1 < sizeof(ud.cmd)) {
++				ud.cmd[ud.cmd_len++] = c;
++			} else {
++				ud.cmd_len = 0;
++				printf("PICASSO CDC: command too long\n");
++			}
++		}
++	}
++}
++
++static void
++ud_event(uint32_t ev)
++{
++	if (ev & 1) {                   /* device event */
++		uint32_t type = (ev >> 8) & 0xf;
++		if (type == 1) {        /* USB reset */
++			dwc_wr(DCFG, dwc_rd(DCFG) & ~(0x7fu << 3));
++			ud_link_down_cleanup();
++			if (ud_ep0_rebuild("usb reset") == 0) {
++				ud_start_setup();
++			}
++		} else if (type == 2) { /* connect done */
++			uint32_t speed = dwc_rd(DSTS) & 7;
++			ud.mps = speed == 0 ? 512u : 64u;
++			if (!ud.ep0_ready && ud_ep0_rebuild("connect done") == 0) {
++				ud_start_setup();
++			}
++			if (!ud.panic_mode) {
++				printf("PICASSO USB: connected, speed %u\n", speed);
++			}
++		} else if (type == 0) {
++			if (!ud.panic_mode) {
++				printf("PICASSO USB: disconnect\n");
++			}
++			ud_link_down_cleanup();
++			if (ud_ep0_rebuild("disconnect") == 0) {
++				ud_start_setup();
++			}
++		}
++		return;
++	}
++	unsigned ep = (ev >> 1) & 0x1f;
++	unsigned type = (ev >> 6) & 0xf;
++	unsigned status = (ev >> 12) & 0xf;
++	if (ep < 6) {
++		ud.last_event[ep] = ev;
++		if (type == 1) {
++			ud.event_complete[ep]++;
++		} else if (type == 2) {
++			ud.event_inprogress[ep]++;
++		} else if (type == 3) {
++			ud.event_notready[ep]++;
++		}
++	}
++	if (ep == EP_TX && type == 1) {         /* bulk IN complete */
++		ud.tx_busy = false;
++		return;
++	}
++	if (ep == EP_NOTIFY && type == 1) {    /* CDC interrupt notification complete */
++		ud.notify_busy = false;
++		return;
++	}
++	if (ep == EP_RX && (type == 1 || type == 2)) {
++		/* Linux completes a bulk TRB for both Complete and InProgress. */
++		ud.rx_busy = false;
++		ud_sync(UD_TRB_RX, 16);
++		volatile uint32_t *trb = (volatile uint32_t *)(ud.dma + UD_TRB_RX);
++		uint32_t remaining = trb[2];
++		struct pur_text diag = { .length = 0 };
++		pur_text_append(&diag, "PICASSO USB: RX event type=");
++		pur_text_u64(&diag, type);
++		pur_text_append(&diag, " status=0x");
++		pur_text_hex32(&diag, status);
++		pur_text_append(&diag, " rem=");
++		pur_text_u64(&diag, remaining);
++		pur_text_append(&diag, " len=");
++		pur_text_u64(&diag, ud.rx_len);
++		pur_text_append(&diag, " ctl=0x");
++		pur_text_hex32(&diag, trb[3]);
++		pur_text_append(&diag, " rsc=");
++		pur_text_u64(&diag, ud.resource[EP_RX]);
++		pur_text_append(&diag, "\r\n");
++		pur_emit_raw(diag.bytes, diag.length);
++		if (!(status & 1u) && remaining <= ud.rx_len) {
++			uint32_t received = ud.rx_len - remaining;
++			if (!ud.panic_mode) {
++				printf("PICASSO CDC: RX complete type=%u status=%x bytes=%u\n",
++				    type, status, received);
++			}
++			if (received != 0) {
++				ud_sync(UD_RX, received);
++				ud_rx_consume((const uint8_t *)(ud.dma + UD_RX), received);
++				ud.rx_bytes += received;
++			}
++		}
++		ud_start_rx();
++		return;
++	}
++	if (ep == EP_RX && type == 3) {        /* bulk OUT transfer not ready */
++		if (!ud.panic_mode) {
++			printf("PICASSO CDC: RX not-ready status=%x busy=%u rsc=%u\n",
++			    status, ud.rx_busy ? 1u : 0u, ud.resource[EP_RX]);
++		}
++		if (!ud.rx_busy) {
++			ud_start_rx();
++		}
++		return;
++	}
++	if (ep > 1) {
++		return;
++	}
++	if (type == 1 || type == 2) {   /* XferComplete or terminal InProgress */
++		if (!ud.ep0_busy || ud.ep0_active_ep != ep) {
++			return;
++		}
++		if (type == 2) {
++			uint32_t trb = ep == 0 ? UD_TRB_OUT : UD_TRB_IN;
++			ud_sync(trb, 16);
++			volatile uint32_t *control =
++			    (volatile uint32_t *)(ud.dma + trb);
++			if (control[3] & TRB_HWO) {
++				return;
++			}
++		}
++		ud.resource[ep] = 0;
++		ud.ep0_busy = false;
++		ud.ep0_active_ep = 0;
++		switch (ud.state) {
++		case EP0_SETUP:
++			ud_sync(UD_SETUP, 8);
++			ud_setup();
++			break;
++		case EP0_DATA:
++			if (!ud.data_in && ud.last_request == 0x20 &&
++			    ud.data_length == sizeof(ud_line_coding)) {
++				ud_sync(UD_DATA, ud.data_length);
++				memcpy(ud_line_coding, (const void *)(ud.dma + UD_DATA), sizeof(ud_line_coding));
++			}
++			ud.state = EP0_WAIT_STATUS3;
++			break;
++		case EP0_STATUS:
++			ud_start_setup();
++			break;
++		default:
++			break;
++		}
++		return;
++	}
++	if (type == 3 && status == 2) { /* XferNotReady, control status phase */
++		if (ud.state == EP0_WAIT_STATUS2 || ud.state == EP0_WAIT_STATUS3) {
++			uint32_t ctl = ud.state == EP0_WAIT_STATUS3 ? TRBCTL_STATUS3 : TRBCTL_STATUS2;
++			ud.state = EP0_STATUS;
++			ud_ep0_start_recovering(ep, ep ? UD_TRB_IN : UD_TRB_OUT,
++			    UD_DATA, 0, ctl, "status no-resource");
++		}
++	}
++}
++
++static void
++ud_poll_events(void)
++{
++	uint32_t count = dwc_rd(GEVNTCOUNT) & 0xffffu;
++	if (count) {
++		ud_sync(UD_EVT, UD_EVT_SIZE);
++		for (uint32_t done = 0; done < count; done += 4) {
++			uint32_t ev = *(volatile uint32_t *)(ud.dma + UD_EVT + ud.evt_pos);
++			unsigned event_ep = (ev & 1) ? 0u : ((ev >> 1) & 0x1fu);
++			ud.evt_pos = (ud.evt_pos + 4) % UD_EVT_SIZE;
++			if (!ud.panic_mode &&
++			    (event_ep != EP_TX || ud.trace_polling) &&
++			    (event_ep == EP_RX || ud.events < 200)) {
++				pur_emit_event(ud.events, event_ep, ev);
++			}
++			ud.events++;
++			ud_event(ev);
++		}
++		dwc_wr(GEVNTCOUNT, count);
++	}
++	if (ud.cmd_pending && !ud.panic_mode) {
++		ud_process_command();
++	}
++}
++
++static void
++ud_poll(void)
++{
++	ud_poll_events();
++	ud_tx_pump();
++}
++
++static bool
++ud_command_is(const char *command, const char *expected)
++{
++	while (*command != '\0' && *expected != '\0') {
++		char a = *command++;
++		char b = *expected++;
++		if (a >= 'A' && a <= 'Z') {
++			a = (char)(a - 'A' + 'a');
++		}
++		if (b >= 'A' && b <= 'Z') {
++			b = (char)(b - 'A' + 'a');
++		}
++		if (a != b) {
++			return false;
++		}
++	}
++	return *command == '\0' && *expected == '\0';
++}
