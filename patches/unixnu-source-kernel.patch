++/*
++ * Read-only QSCRATCH diagnostics. Each access has a synchronous breadcrumb
++ * before it, so the last visible line identifies a stalled interconnect read.
++ */
++static void
++picasso_usb_qscratch_probe(vm_offset_t qs)
++{
++	picasso_usb_sync_mark("PICASSO USB: QPROBE enter");
++	picasso_usb_busy_wait(1000);
++
++	picasso_usb_sync_mark("PICASSO USB: QPROBE GENERAL_CFG read begin");
++	uint32_t general = usb_rd(qs, QSCRATCH_GENERAL_CFG);
++	picasso_usb_sync_hex("PICASSO USB: QPROBE GENERAL_CFG=", general);
++
++	picasso_usb_sync_mark("PICASSO USB: QPROBE HS_PHY_CTRL read begin");
++	uint32_t hs = usb_rd(qs, QSCRATCH_HS_PHY_CTRL);
++	picasso_usb_sync_hex("PICASSO USB: QPROBE HS_PHY_CTRL=", hs);
++
++	picasso_usb_sync_mark("PICASSO USB: QPROBE SS_PHY_CTRL read begin");
++	uint32_t ss = usb_rd(qs, QSCRATCH_SS_PHY_CTRL);
++	picasso_usb_sync_hex("PICASSO USB: QPROBE SS_PHY_CTRL=", ss);
++
++	picasso_usb_sync_mark("PICASSO USB: QPROBE CGCTL read begin");
++	uint32_t cgctl = usb_rd(qs, QSCRATCH_CGCTL);
++	picasso_usb_sync_hex("PICASSO USB: QPROBE CGCTL=", cgctl);
++
++	picasso_usb_sync_mark("PICASSO USB: QPROBE PWR_EVT_STAT read begin");
++	uint32_t pwr_stat = usb_rd(qs, QSCRATCH_PWR_EVT_STAT);
++	picasso_usb_sync_hex("PICASSO USB: QPROBE PWR_EVT_STAT=", pwr_stat);
++
++	picasso_usb_sync_mark("PICASSO USB: QPROBE PWR_EVT_MASK read begin");
++	uint32_t pwr_mask = usb_rd(qs, QSCRATCH_PWR_EVT_MASK);
++	picasso_usb_sync_hex("PICASSO USB: QPROBE PWR_EVT_MASK=", pwr_mask);
++
++	picasso_usb_sync_mark("PICASSO USB: QPROBE GENERAL_CFG2 read begin");
++	uint32_t general2 = usb_rd(qs, QSCRATCH_GENERAL_CFG);
++	picasso_usb_sync_hex("PICASSO USB: QPROBE GENERAL_CFG2=", general2);
++	picasso_usb_sync_mark("PICASSO USB: QPROBE complete");
++}
++
++/*
++ * Minimal read-only experiment for the SMMU register block. The plan/apply
++ * path stays untouched; synchronous breadcrumbs are emitted immediately
++ * before each read so a bus hang identifies the exact register even when the
++ * buffered console cannot drain.
++ */
++static bool
++picasso_usb_smmu_probe_page(vm_offset_t smmu)
++{
++	picasso_usb_sync_mark("PICASSO USB: PROBE enter");
++	picasso_usb_sync_mark("PICASSO USB: PROBE sCR0 begin");
++	uint32_t scr0 = usb_rd(smmu, 0x000);
++	picasso_usb_sync_mark("PICASSO USB: PROBE sCR0 ok");
++	printf("PICASSO USB: SMMU probe sCR0=%08x\n", scr0);
++
++	picasso_usb_sync_mark("PICASSO USB: PROBE sGFSR begin");
++	uint32_t gfsr = usb_rd(smmu, 0x048);
++	picasso_usb_sync_mark("PICASSO USB: PROBE sGFSR ok");
++	printf("PICASSO USB: SMMU probe sGFSR=%08x\n", gfsr);
++
++	picasso_usb_sync_mark("PICASSO USB: PROBE IDR begin");
++	uint32_t idr0 = usb_rd(smmu, 0x020);
++	uint32_t idr1 = usb_rd(smmu, 0x024);
++	uint32_t idr2 = usb_rd(smmu, 0x028);
++	picasso_usb_sync_mark("PICASSO USB: PROBE IDR ok");
++	printf("PICASSO USB: SMMU probe idr=%08x/%08x/%08x\n",
++	    idr0, idr1, idr2);
++
++	unsigned slots = idr0 & 0xffu;
++	if (!slots || slots > 128) {
++		printf("PICASSO USB: SMMU probe bad stream count=%u\n", slots);
++		return false;
++	}
++
++	unsigned active = 0;
++	unsigned free_slot = 0xffffu;
++	for (unsigned i = 0; i < slots; i++) {
++		picasso_usb_sync_mark_index("PICASSO USB: PROBE SMR begin ",
++		    i);
++		uint32_t smr = usb_rd(smmu, 0x800u + 4u * i);
++		if (smr & (1u << 31)) {
++			active++;
++		} else if (free_slot == 0xffffu) {
++			free_slot = i;
++		}
++	}
++	printf("PICASSO USB: SMMU probe complete active=%u free=%u\n",
++	    active, free_slot);
++	return true;
++}
++
++/*
++ * The Qualcomm firmware implements Linux's SMMU bypass quirk: a TYPE=BYPASS
++ * S2CR reads back as FAULT, while TYPE=TRANSLATE to a disabled
++ * S1_TRANS_S2_BYPASS context bank works. Bind only the USB SID, never change
++ * sCR0, and leave every other stream route untouched. This is explicitly a
++ * debug-boot operation and is lost on the next reset.
++ */
++struct picasso_usb_smmu_bind {
++	unsigned slot;
++	unsigned bank;
++	uint32_t cbar;
++	uint32_t cba2r;
++	uint32_t sctlr;
++	uint32_t sctlr_off;
++};
++
++static bool
++picasso_usb_smmu_plan_bind(vm_offset_t smmu,
++    struct picasso_usb_smmu_bind *plan, bool verbose)
++{
++	if (verbose) {
++		picasso_usb_sync_mark("PICASSO USB: PLAN sCR0 begin");
++	}
++	uint32_t scr0 = usb_rd(smmu, 0x000);
++	if (verbose) {
++		picasso_usb_sync_mark("PICASSO USB: PLAN sGFSR begin");
++	}
++	uint32_t gfsr = usb_rd(smmu, 0x048);
++	if (verbose) {
++		picasso_usb_sync_mark("PICASSO USB: PLAN IDR begin");
++	}
++	uint32_t idr0 = usb_rd(smmu, 0x020);
++	uint32_t idr1 = usb_rd(smmu, 0x024);
++	uint32_t idr2 = usb_rd(smmu, 0x028);
++	unsigned slots = idr0 & 0xffu;
++	unsigned banks = idr1 & 0xffu;
++	unsigned pages = 1u << (((idr1 >> 28) & 7u) + 1u);
++	bool exids = (idr0 & (1u << 8)) != 0;
++	unsigned active = 0, free_slot = 0xffffu;
++	uint8_t bank_users[128] = { 0 };
++	uint32_t smrs[128];
++
++	printf("PICASSO USB: SMMU bind scr0=%08x gfsr=%08x idr=%08x/%08x/%08x exids=%u\n",
++	    scr0, gfsr, idr0, idr1, idr2, exids);
++	if (!slots || slots > 128 || !banks || banks > 128 || pages > 128 ||
++	    (pages + banks) * 4096u > SMMU_SIZE) {
++		printf("PICASSO USB: SMMU bind unsupported geometry\n");
++		return false;
++	}
++	if (exids) {
++		printf("PICASSO USB: SMMU bind refuses EXIDS layout\n");
++		return false;
++	}
++
++	for (unsigned i = 0; i < slots; i++) {
++		if (verbose) {
++			picasso_usb_sync_mark_index(
++			    "PICASSO USB: PLAN SMR begin ", i);
++		} else if ((i & 15u) == 0) {
++			printf("PICASSO USB: SMMU bind scan smr %u/%u\n", i, slots);
++		}
++		smrs[i] = usb_rd(smmu, 0x800u + 4u * i);
++		if (smrs[i] & (1u << 31)) {
++			active++;
++		} else if (free_slot == 0xffffu) {
++			free_slot = i;
++		}
++	}
++	printf("PICASSO USB: SMMU bind smr active=%u free=%u\n",
++	    active, free_slot);
++	if (free_slot == 0xffffu) {
++		printf("PICASSO USB: SMMU bind no free stream-match slot\n");
++		return false;
++	}
++
++	for (unsigned i = 0; i < slots; i++) {
++		if (!(smrs[i] & (1u << 31))) {
++			continue;
++		}
++		if (verbose) {
++			picasso_usb_sync_mark_index(
++			    "PICASSO USB: PLAN S2CR begin ", i);
++		}
++		uint32_t s2cr = usb_rd(smmu, 0xc00u + 4u * i);
++		if (((s2cr >> 16) & 3u) == 0 && (s2cr & 0xffu) < banks) {
++			bank_users[s2cr & 0xffu]++;
++		}
++	}
++	printf("PICASSO USB: SMMU bind s2cr scan done\n");
++
++	for (unsigned attempt = 0; attempt < banks; attempt++) {
++		unsigned bank = banks - 1 - attempt;
++		if (bank_users[bank]) {
++			printf("PICASSO USB: SMMU bank %u users=%u skip\n",
++			    bank, bank_users[bank]);
++			continue;
++		}
++		if (verbose) {
++			picasso_usb_sync_mark_index(
++			    "PICASSO USB: PLAN bank begin ", bank);
++		}
++		printf("PICASSO USB: SMMU bank %u probe\n", bank);
++		uint32_t cbar = usb_rd(smmu, 0x1000u + 4u * bank);
++		printf("PICASSO USB: SMMU bank %u cbar=%08x\n", bank, cbar);
++		uint32_t cba2r = usb_rd(smmu, 0x1800u + 4u * bank);
++		printf("PICASSO USB: SMMU bank %u cba2r=%08x\n", bank, cba2r);
++		uint32_t sctlr = usb_rd(smmu, (pages + bank) * 4096u);
++		printf("PICASSO USB: SMMU bank %u sctlr=%08x M=%u\n",
++		    bank, sctlr, sctlr & 1u);
++		if ((sctlr & 1u) != 0 ||
++		    (cbar != 0 && cbar != 0x10000u)) {
++			continue;
++		}
++
++		plan->slot = free_slot;
++		plan->bank = bank;
++		plan->cbar = cbar;
++		plan->cba2r = cba2r | 1u;
++		plan->sctlr = sctlr;
++		plan->sctlr_off = (pages + bank) * 4096u;
++		printf("PICASSO USB: SMMU bind plan slot=%u bank=%u\n",
++		    plan->slot, plan->bank);
++		return true;
++	}
++	printf("PICASSO USB: SMMU bind found no disabled bypass bank\n");
++	return false;
++}
++
++static bool
++picasso_usb_smmu_apply_bind(vm_offset_t smmu,
++    const struct picasso_usb_smmu_bind *plan)
++{
++	printf("PICASSO USB: SMMU bind apply slot=%u bank=%u\n",
++	    plan->slot, plan->bank);
++	if (plan->cbar != 0x10000u) {
++		picasso_usb_smmu_write(smmu, 0x1000u + 4u * plan->bank,
++		    0x10000u);
++	}
++	picasso_usb_smmu_write(smmu, 0x1800u + 4u * plan->bank,
++	    plan->cba2r);
++	uint32_t sctlr_after = usb_rd(smmu, plan->sctlr_off);
++	if (usb_rd(smmu, 0x1000u + 4u * plan->bank) != 0x10000u ||
++	    usb_rd(smmu, 0x1800u + 4u * plan->bank) != plan->cba2r ||
++	    sctlr_after != plan->sctlr) {
++		printf("PICASSO USB: SMMU bank %u setup readback FAIL\n",
++		    plan->bank);
++		return false;
++	}
++
++	picasso_usb_smmu_write(smmu, 0xc00u + 4u * plan->slot, plan->bank);
++	if (usb_rd(smmu, 0xc00u + 4u * plan->slot) != plan->bank) {
++		printf("PICASSO USB: SMMU bind S2CR readback FAIL\n");
++		return false;
++	}
++	picasso_usb_smmu_write(smmu, 0x800u + 4u * plan->slot,
++	    0x80000000u | USB_STREAM_ID);
++	uint32_t smr = usb_rd(smmu, 0x800u + 4u * plan->slot);
++	uint32_t s2cr = usb_rd(smmu, 0xc00u + 4u * plan->slot);
++	printf("PICASSO USB: SMMU bind route slot=%u smr=%08x s2cr=%08x bank=%u cbar=%08x cba2r=%08x sctlr=%08x\n",
++	    plan->slot, smr, s2cr, plan->bank, plan->cbar, plan->cba2r,
++	    plan->sctlr);
++	if (smr != (0x80000000u | USB_STREAM_ID) || s2cr != plan->bank) {
++		printf("PICASSO USB: SMMU bind route readback FAIL\n");
++		return false;
++	}
++	return true;
++}
++
++/*
++ * Read-only guard for the apps SMMU. A debug-only DMA path may use an
++ * existing direct/bypass route, but must never create or weaken one.
++ */
++static bool
++picasso_usb_smmu_guard(vm_offset_t smmu, uint64_t dma, uint64_t bytes)
++{
++	uint32_t scr0 = usb_rd(smmu, 0x000);
++	uint32_t idr0 = usb_rd(smmu, 0x020);
++	uint32_t idr1 = usb_rd(smmu, 0x024);
++	uint32_t idr2 = usb_rd(smmu, 0x028);
++	uint32_t gfsr = usb_rd(smmu, 0x048);
++	unsigned count = idr0 & 0xffu;
++	unsigned banks = idr1 & 0xffu;
++	unsigned pages = 1u << (((idr1 >> 28) & 7u) + 1u);
++	unsigned matches = 0;
++	unsigned match_index = 0;
++	uint32_t match_smr = 0;
++	uint32_t match_s2cr = 0;
++	uint32_t match_mask = 0;
++
++	printf("PICASSO USB: SMMU scr0=%08x idr=%08x/%08x/%08x gfsr=%08x\n",
++	    scr0, idr0, idr1, idr2, gfsr);
++	printf("PICASSO USB: SMMU streams=%u banks=%u pages=%u\n",
++	    count, banks, pages);
++	if (!count || !banks || pages > 128 ||
++	    (pages + banks) * 4096u > SMMU_SIZE) {
++		printf("PICASSO USB: SID e0 guard FAIL: unsupported SMMU geometry\n");
++		return false;
++	}
++
++	for (unsigned i = 0; i < count; i++) {
++		uint32_t smr = usb_rd(smmu, 0x800u + 4u * i);
++		if (!(smr & (1u << 31))) {
++			continue;
++		}
++		uint32_t mask = (smr >> 16) & 0x7fffu;
++		if (((smr ^ USB_STREAM_ID) & 0xffffu & ~mask) != 0) {
++			continue;
++		}
++		matches++;
++		if (matches <= 4) {
++			printf("PICASSO USB: SID e0 match %u smr=%08x s2cr=%08x\n",
++			    i, smr, usb_rd(smmu, 0xc00u + 4u * i));
++		}
++		if (matches == 1) {
++			match_index = i;
++			match_smr = smr;
++			match_mask = mask;
++			match_s2cr = usb_rd(smmu, 0xc00u + 4u * i);
++		}
++	}
++	if (matches != 1) {
++		printf("PICASSO USB: SID e0 guard FAIL: matches=%u (need exactly 1)\n",
++		    matches);
++		return false;
++	}
++	if (match_mask != 0) {
++		printf("PICASSO USB: SID e0 guard FAIL: non-exact mask=%04x\n",
++		    match_mask);
++		return false;
++	}
++
++	unsigned type = (match_s2cr >> 16) & 3u;
++	unsigned bank = match_s2cr & 0xffu;
++	uint32_t cbar = 0;
++	uint32_t cba2r = 0;
++	uint32_t sctlr = 0;
++	bool identity = false;
++
++	if (type == 0) {
++		if (bank >= banks) {
++			printf("PICASSO USB: SID e0 guard FAIL: cb=%u banks=%u\n",
++			    bank, banks);
++			return false;
++		}
++		cbar = usb_rd(smmu, 0x1000u + 4u * bank);
++		cba2r = usb_rd(smmu, 0x1800u + 4u * bank);
++		sctlr = usb_rd(smmu, (pages + bank) * 4096u);
++		identity = ((cbar >> 16) & 3u) == 1u && !(sctlr & 1u);
++	} else if (type == 1) {
++		identity = true;
++	}
++	printf("PICASSO USB: SID e0 match=%u smr=%08x s2cr=%08x type=%u cb=%u\n",
++	    match_index, match_smr, match_s2cr, type, bank);
++	printf("PICASSO USB: SID e0 cbar=%08x cba2r=%08x sctlr=%08x path=%s\n",
++	    cbar, cba2r, sctlr, identity ? "identity" : "not-identity");
++	if (!identity) {
++		printf("PICASSO USB: SID e0 guard FAIL: route is not direct identity\n");
++		return false;
++	}
++
++	unsigned in_bits = picasso_smmu_addr_bits(idr2 & 0xf);
++	unsigned out_bits = picasso_smmu_addr_bits((idr2 >> 4) & 0xf);
++	unsigned mid_bits = picasso_smmu_addr_bits((idr2 >> 8) & 0xf);
++	printf("PICASSO USB: SMMU widths in/out/mid=%u/%u/%u DMA=0x%llx+0x%llx\n",
++	    in_bits, out_bits, mid_bits, dma, bytes);
++	if (bytes) {
++		unsigned widths[3] = { in_bits, out_bits, mid_bits };
++		for (unsigned i = 0; i < 3; i++) {
++			if (!widths[i] || dma >= (1ULL << widths[i]) ||
++			    bytes > (1ULL << widths[i]) - dma) {
++				printf("PICASSO USB: SID e0 guard FAIL: DMA exceeds width %u\n",
++				    widths[i]);
++				return false;
++			}
++		}
++	}
++	printf("PICASSO USB: SID e0 guard PASS\n");
++	return true;
++}
++
++static inline void
++dwc_wr(uint32_t off, uint32_t v)
++{
++	*(volatile uint32_t *)(ud.dwc + off) = v;
++	__asm__ volatile ("dsb sy" ::: "memory");
++}
++
++static inline uint32_t
++dwc_rd(uint32_t off)
++{
++	return usb_rd(ud.dwc, off);
++}
