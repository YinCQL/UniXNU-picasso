++static void
++picasso_usb_select_utmi_clk(vm_offset_t qs)
++{
++	picasso_usb_sync_mark("PICASSO USB: UTMI enter");
++	picasso_usb_sync_mark("PICASSO USB: UTMI before read begin");
++	uint32_t before = usb_rd(qs, QSCRATCH_GENERAL_CFG);
++	picasso_usb_sync_hex("PICASSO USB: UTMI before=", before);
++
++	picasso_usb_sync_mark("PICASSO USB: UTMI disable write begin");
++	usb_wr(qs, QSCRATCH_GENERAL_CFG, before | PIPE_UTMI_CLK_DIS);
++	picasso_usb_sync_mark("PICASSO USB: UTMI disable write done");
++	picasso_usb_busy_wait(5);
++	picasso_usb_sync_mark("PICASSO USB: UTMI disabled read begin");
++	uint32_t disabled = usb_rd(qs, QSCRATCH_GENERAL_CFG);
++	picasso_usb_sync_hex("PICASSO USB: UTMI disabled=", disabled);
++
++	picasso_usb_sync_mark("PICASSO USB: UTMI select write begin");
++	usb_wr(qs, QSCRATCH_GENERAL_CFG,
++	    disabled | PIPE_UTMI_CLK_SEL | PIPE3_PHYSTATUS_SW);
++	picasso_usb_sync_mark("PICASSO USB: UTMI select write done");
++	picasso_usb_busy_wait(5);
++	picasso_usb_sync_mark("PICASSO USB: UTMI selected read begin");
++	uint32_t selected = usb_rd(qs, QSCRATCH_GENERAL_CFG);
++	picasso_usb_sync_hex("PICASSO USB: UTMI selected=", selected);
++
++	picasso_usb_sync_mark("PICASSO USB: UTMI enable write begin");
++	usb_wr(qs, QSCRATCH_GENERAL_CFG, selected & ~PIPE_UTMI_CLK_DIS);
++	picasso_usb_sync_mark("PICASSO USB: UTMI enable write done");
++	picasso_usb_busy_wait(5);
++	picasso_usb_sync_mark("PICASSO USB: UTMI final read begin");
++	uint32_t after = usb_rd(qs, QSCRATCH_GENERAL_CFG);
++	picasso_usb_sync_hex("PICASSO USB: UTMI final=", after);
++
++	picasso_usb_sync_mark("PICASSO USB: UTMI complete");
++}
