++static void
++ud_sleep_ms(unsigned ms)
++{
++	uint64_t deadline;
++	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
++	(void)assert_wait_deadline(&ud.sleep_chan, THREAD_UNINT, deadline);
++	thread_block(THREAD_CONTINUE_NULL);
++}
++
++static int
++ud_epcmd(unsigned ep, uint32_t cmd, uint32_t p0, uint32_t p1, uint32_t p2)
++{
++	if (ud.trace_commands && !ud.panic_mode) {
++		printf("PICASSO USB: ep%u cmd %u prepare\n", ep, cmd);
++	}
++	/*
++	 * Issue one command and poll CMDACT, as Linux does. DEPCMD status 1 is
++	 * "no transfer resource", not "command ring full"; reissuing the same
++	 * STARTTRANSFER cannot make an active endpoint resource disappear.
++	 */
++	dwc_wr(DEPCMDPAR0(ep), p0);
++	dwc_wr(DEPCMDPAR1(ep), p1);
++	dwc_wr(DEPCMDPAR2(ep), p2);
++	*(volatile uint32_t *)(ud.dwc + DEPCMD(ep)) = cmd | DEPCMD_CMDACT;
++	__asm__ volatile ("dsb sy" ::: "memory");
++
++	for (unsigned poll = 0; poll < 5000; poll++) {
++		uint32_t value = dwc_rd(DEPCMD(ep));
++		if (!(value & DEPCMD_CMDACT)) {
++			uint32_t status = (value >> 12) & 0xf;
++			if (status != 0) {
++				if (!ud.panic_mode) {
++					printf("PICASSO USB: ep%u cmd %u status %u%s reg=0x%08x\n",
++					    ep, cmd, status,
++					    status == 1 ? " (no transfer resource)" : "",
++					    value);
++				}
++				return status == 1 ? UD_EPCMD_NO_RESOURCE : -1;
++			}
++			if (ud.trace_commands && !ud.panic_mode) {
++				printf("PICASSO USB: ep%u cmd %u complete reg=0x%08x polls=%u\n",
++				    ep, cmd, value, poll + 1);
++			}
++			if (cmd == DEPCMD_STARTTRANSFER) {
++				ud.resource[ep] = (value >> 16) & 0x7fu;
++			}
++			return 0;
++		}
++		picasso_usb_busy_wait(1);
++	}
++	if (!ud.panic_mode) {
++		printf("PICASSO USB: ep%u cmd %u timeout\n", ep, cmd);
++	}
++	return -1;
++}
++
++static int
++ud_epcmd_named(const char *name, unsigned ep, uint32_t cmd,
++    uint32_t p0, uint32_t p1, uint32_t p2)
++{
++	int result = ud_epcmd(ep, cmd, p0, p1, p2);
++	if (!ud.panic_mode) {
++		printf("PICASSO USB: %s ep%u cmd=%u result=%d reg=0x%08x rsc=%u\n",
++		    name, ep, cmd & 0xfu, result, dwc_rd(DEPCMD(ep)), ud.resource[ep]);
++	}
++	return result;
++}
++
++static void
++ud_dump_ep_state(const char *tag, unsigned ep)
++{
++	volatile uint32_t *trb = NULL;
++	uint32_t trb_off = 0;
++	int result = ud_epcmd(ep, DEPCMD_GETEPSTATE, 0, 0, 0);
++	uint32_t state = dwc_rd(DEPCMDPAR2(ep));
++
++	if (ep == EP_RX) {
++		trb_off = UD_TRB_RX;
++	} else if (ep == EP_TX) {
++		trb_off = UD_TRB_TX;
++	} else if (ep == EP_NOTIFY) {
++		trb_off = UD_TRB_NOTIFY;
++	}
++	if (trb_off != 0) {
++		trb = (volatile uint32_t *)(ud.dma + trb_off);
++		ud_sync(trb_off, 16);
++		printf("PICASSO USB: EPSTATE %s ep%u result=%d state=0x%08x "
++		    "busy=%u rsc=%u trb=%08x/%08x/%08x/%08x "
++		    "DALEPENA=%08x DCTL=%08x DSTS=%08x events=%llu/%u\n",
++		    tag, ep, result, state,
++		    ep == EP_RX ? ud.rx_busy : ep == EP_TX ? ud.tx_busy :
++		    ep == EP_NOTIFY ? ud.notify_busy : 0u,
++		    ud.resource[ep], trb[0], trb[1], trb[2], trb[3],
++		    dwc_rd(DALEPENA), dwc_rd(DCTL), dwc_rd(DSTS),
++		    ud.events, dwc_rd(GEVNTCOUNT) & 0xffffu);
++		return;
++	}
++	printf("PICASSO USB: EPSTATE %s ep%u result=%d state=0x%08x "
++	    "busy=%u rsc=%u DALEPENA=%08x DCTL=%08x DSTS=%08x events=%llu/%u\n",
++	    tag, ep, result, state,
++	    ep == EP_RX ? ud.rx_busy : ep == EP_TX ? ud.tx_busy :
++	    ep == EP_NOTIFY ? ud.notify_busy : 0u,
++	    ud.resource[ep], dwc_rd(DALEPENA), dwc_rd(DCTL), dwc_rd(DSTS),
++	    ud.events, dwc_rd(GEVNTCOUNT) & 0xffffu);
++}
++
++static uint64_t
++ud_prepare_trb(uint32_t trb, uint32_t buf, uint32_t len, uint32_t ctl,
++    uint32_t flags)
++{
++	volatile uint32_t *t = (volatile uint32_t *)(ud.dma + trb);
++	uint64_t bpa = ud.dma_pa + buf;
++
++	t[0] = (uint32_t)bpa;
++	t[1] = (uint32_t)(bpa >> 32);
++	t[2] = len;
++	/*
++	 * Linux only sets ISP/IMI for isochronous transfers or OUT requests
++	 * with short_not_ok. None of this gadget's endpoints need it.
++	 */
++	t[3] = ctl | TRB_HWO | flags | TRB_IOC;
++	ud_sync(trb, 16);
++	if (len) {
++		ud_sync(buf, len);
++	}
++	return ud.dma_pa + trb;
++}
++
++/* One TRB (at DMA offset trb) on physical endpoint ep. */
++static int
++ud_start_trb(unsigned ep, uint32_t trb, uint32_t buf, uint32_t len, uint32_t ctl)
++{
++	if (ep <= 1 && ud.ep0_busy) {
++		unsigned active = ud.ep0_active_ep;
++		uint32_t resource = ud.resource[active];
++		uint32_t command = DEPCMD_ENDTRANSFER | DEPCMD_FORCE_RM |
++		    DEPCMD_CMDIOC | (resource << 16);
++		int result = ud_epcmd(active, command, 0, 0, 0);
++		if (!ud.panic_mode) {
++			printf("PICASSO USB: ep0 restart ended physical ep%u rsc=%u "
++			    "result=%d\n", active, resource, result);
++		}
++		ud.resource[active] = 0;
++		ud.ep0_busy = false;
++		ud.ep0_active_ep = 0;
++	}
++	uint64_t tpa = ud_prepare_trb(trb, buf, len, ctl, TRB_LST);
++	int result = ud_epcmd(ep, DEPCMD_STARTTRANSFER,
++	    (uint32_t)(tpa >> 32), (uint32_t)tpa, 0);
++	if (result == 0 && ep <= 1) {
++		ud.ep0_busy = true;
++		ud.ep0_active_ep = ep;
++	}
++	return result;
++}
++
++static void
++ud_ep0_end_active(const char *reason)
++{
++	if (!ud.ep0_busy) {
++		return;
++	}
++	unsigned ep = ud.ep0_active_ep;
++	uint32_t resource = ud.resource[ep];
++	uint32_t command = DEPCMD_ENDTRANSFER | DEPCMD_FORCE_RM |
++	    DEPCMD_CMDIOC | (resource << 16);
++	int result = ud_epcmd(ep, command, 0, 0, 0);
++	if (!ud.panic_mode) {
++		printf("PICASSO USB: ep0 end active (%s) physical ep%u rsc=%u "
++		    "result=%d\n", reason, ep, resource, result);
++	}
++	ud.resource[ep] = 0;
++	ud.ep0_busy = false;
++	ud.ep0_active_ep = 0;
++}
++
++static void
++ud_data_endpoints_abort(void)
++{
++	const unsigned endpoints[] = { EP_RX, EP_TX, EP_NOTIFY };
++	for (unsigned i = 0; i < sizeof(endpoints) / sizeof(endpoints[0]); i++) {
++		unsigned ep = endpoints[i];
++		if (ud.resource[ep] != 0) {
++			uint32_t command = DEPCMD_ENDTRANSFER | DEPCMD_FORCE_RM |
++			    DEPCMD_CMDIOC | (ud.resource[ep] << 16);
++			int result = ud_epcmd(ep, command, 0, 0, 0);
++			if (!ud.panic_mode && result != 0) {
++				printf("PICASSO USB: reset abort ep%u failed result=%d\n",
++				    ep, result);
++			}
++		}
++		ud.resource[ep] = 0;
++	}
++	ud.tx_busy = false;
++	ud.rx_busy = false;
++	ud.rx_transfer_started = false;
++	ud.notify_busy = false;
++}
++
++static void
++ud_link_down_cleanup(void)
++{
++	ud_data_endpoints_abort();
++	ud.configured = false;
++	ud.host_open = false;
++	ud.cmd_len = 0;
++}
++
++/*
++ * An endpoint prestarted by the no-op transfer uses Update Transfer for all
++ * subsequent TRBs. Linux uses the No Response form without CMDACT/CMDIOC.
++ * For a non-stream bulk OUT endpoint Linux sets CSP and leaves LST clear.
++ */
++static int
++ud_update_trb(unsigned ep, uint32_t trb, uint32_t buf, uint32_t len, uint32_t ctl)
++{
++	(void)ud_prepare_trb(trb, buf, len, ctl, TRB_CSP);
++	uint32_t command = DEPCMD_UPDATETRANSFER | (ud.resource[ep] << 16);
++	*(volatile uint32_t *)(ud.dwc + DEPCMD(ep)) = command;
++	__asm__ volatile ("dsb sy" ::: "memory");
++	return 0;
++}
++
++/*
++ * Linux primes every bulk/interrupt endpoint with a zeroed no-op TRB after
++ * DALEPENA.  DWC3 then treats subsequent No Response Update Transfer commands
++ * as normal endpoint activity instead of leaving the endpoint uninitialised.
++ */
++static int
++ud_noop_start(unsigned ep, uint32_t trb)
++{
++	volatile uint32_t *t = (volatile uint32_t *)(ud.dma + trb);
++
++	t[0] = 0;
++	t[1] = 0;
++	t[2] = 0;
++	t[3] = 0;
++	ud_sync(trb, 16);
++	uint64_t tpa = ud.dma_pa + trb;
++	return ud_epcmd_named("rx-noop", ep, DEPCMD_STARTTRANSFER,
++	    (uint32_t)(tpa >> 32), (uint32_t)tpa, 0);
++}
++
++/* Terminate the two-entry bulk OUT ring with a hardware-owned link TRB. */
++static void
++ud_init_rx_ring(void)
++{
++	volatile uint32_t *link = (volatile uint32_t *)(ud.dma + UD_TRB_RX_LINK);
++	uint64_t first = ud.dma_pa + UD_TRB_RX;
++
++	link[0] = (uint32_t)first;
++	link[1] = (uint32_t)(first >> 32);
++	link[2] = 0;
++	link[3] = TRB_HWO | TRBCTL_LINK;
++	ud_sync(UD_TRB_RX_LINK, 16);
++	if (!ud.panic_mode) {
++		printf("PICASSO USB: RX ring first=0x%llx link=0x%llx ctl=0x%08x\n",
++		    first, ud.dma_pa + UD_TRB_RX_LINK, link[3]);
++	}
++}
++
++/*
++ * USB reset is destructive to endpoint resource allocation on this controller.
++ * Rebuild EP0 from the databook sequence and only restore data endpoints if the
++ * host had already selected the configuration.
++ */
++static int
++ud_ep0_rebuild(const char *reason)
++{
++	bool restore_configured = ud.configured;
++
++	ud_ep0_end_active(reason);
++	if (restore_configured) {
++		ud_data_endpoints_abort();
++		ud.configured = false;
++	}
++	ud.ep0_ready = false;
++	ud.ep0_busy = false;
++	ud.ep0_active_ep = 0;
++	ud.resource[0] = 0;
++	ud.resource[1] = 0;
++	dwc_wr(DALEPENA, 0);
++	if (ud_epcmd(0, DEPCMD_DEPSTARTCFG, 0, 0, 0) != 0 ||
++	    ud_epcmd(0, DEPCMD_SETEPCONFIG, (0u << 1) | (64u << 3),
++	    (1u << 8) | (1u << 10) | (0u << 25), 0) != 0 ||
++	    ud_epcmd(0, DEPCMD_SETTRANSFRESOURCE, 1, 0, 0) != 0 ||
++	    ud_epcmd(1, DEPCMD_SETEPCONFIG, (0u << 1) | (64u << 3),
++	    (1u << 8) | (1u << 10) | (1u << 25), 0) != 0 ||
++	    ud_epcmd(1, DEPCMD_SETTRANSFRESOURCE, 1, 0, 0) != 0) {
++		if (!ud.panic_mode) {
++			printf("PICASSO USB: ep0 rebuild failed (%s)\n", reason);
++		}
++		return -1;
++	}
++	dwc_wr(DALEPENA, 0x3);
++	ud.ep0_ready = true;
++	if (!ud.panic_mode) {
++		printf("PICASSO USB: ep0 resources rebuilt (%s), DALEPENA=0x%08x\n",
++		    reason, dwc_rd(DALEPENA));
++	}
++	if (restore_configured) {
++		ud_configure();
++	}
++	return 0;
++}
++
++static int
++ud_ep0_start_recovering(unsigned ep, uint32_t trb, uint32_t buf, uint32_t len,
++    uint32_t ctl, const char *phase)
++{
++	unsigned saved_state = ud.state;
++	int result = ud_start_trb(ep, trb, buf, len, ctl);
++
++	if (result == UD_EPCMD_NO_RESOURCE &&
++	    ud_ep0_rebuild(phase) == 0) {
++		ud.state = saved_state;
++		result = ud_start_trb(ep, trb, buf, len, ctl);
++	}
++	return result;
++}
++
++static void
++ud_start_rx(void)
++{
++	if (!ud.configured || ud.rx_busy) {
++		return;
++	}
++	if (!ud.rx_transfer_started) {
++		/*
++		 * Linux primes every non-control endpoint with a zeroed no-op
++		 * STARTTRANSFER after DALEPENA. This assigns the resource index
++		 * used by subsequent no-response UPDATE_TRANSFER commands.
++		 */
++		ud_init_rx_ring();
++		int prime = ud_noop_start(EP_RX, UD_TRB_RX);
++		if (prime != 0 || ud.resource[EP_RX] == 0) {
++			if (!ud.panic_mode) {
++				printf("PICASSO USB: RX no-op prime failed result=%d rsc=%u\n",
++				    prime, ud.resource[EP_RX]);
++			}
++			return;
++		}
++		ud.rx_transfer_started = true;
++	}
++	ud.rx_len = UD_RX_SIZE;
++	ud.rx_busy = true;
++	int result = ud_update_trb(EP_RX, UD_TRB_RX, UD_RX, UD_RX_SIZE,
++	    TRBCTL_NORMAL);
++	if (!ud.panic_mode) {
++		printf("PICASSO USB: RX arm mps=%u len=%u trb=0x%llx result=%d "
++		    "cmd=0x%08x rsc=%u started=%u\n",
++		    ud.mps, UD_RX_SIZE, ud.dma_pa + UD_TRB_RX, result,
++		    dwc_rd(DEPCMD(EP_RX)), ud.resource[EP_RX],
++		    ud.rx_transfer_started ? 1u : 0u);
++		ud_dump_ep_state("after-arm", EP_RX);
++	}
++	if (result != 0) {
++		ud.rx_busy = false;
++	}
++}
++
++static void
++ud_start_setup(void)
++{
++	if (!ud.ep0_ready && ud_ep0_rebuild("setup") != 0) {
++		return;
++	}
++	ud.state = EP0_SETUP;
++	if (ud.trace_commands) {
++		printf("PICASSO USB: setup TRB prepare va %p pa 0x%llx\n",
++		    (void *)(ud.dma + UD_TRB_OUT), ud.dma_pa + UD_TRB_OUT);
++	}
++	int result = ud_ep0_start_recovering(0, UD_TRB_OUT, UD_SETUP, 8,
++	    TRBCTL_SETUP, "setup no-resource");
++	if (result != 0 && !ud.panic_mode) {
++		printf("PICASSO USB: setup STARTTRANSFER failed result=%d\n", result);
++	}
++	if (ud.trace_commands) {
++		printf("PICASSO USB: setup TRB command returned\n");
++	}
++}
++
++static void
++ud_stall(void)
++{
++	ud_ep0_end_active("stall");
++	ud_epcmd(0, DEPCMD_SETSTALL, 0, 0, 0);
++	ud_start_setup();
++}
