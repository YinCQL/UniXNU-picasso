++#define UD_WATCHDOG_INITIAL_REPORTS 4u
++#define UD_WATCHDOG_LATE_REPORTS 8u
++#define UD_WATCHDOG_LATE_NS (1000ULL * NSEC_PER_MSEC)
++
++struct ud_poller_progress {
++	bool started;
++	bool have_pet;
++	unsigned initial_reports;
++	unsigned late_reports;
++	uint64_t last_pet_ns;
++};
