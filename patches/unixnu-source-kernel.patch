+diff --git a/bsd/dev/picasso_usb.c b/bsd/dev/picasso_usb.c
+new file mode 100644
+--- /dev/null
++++ b/bsd/dev/picasso_usb.c
+@@ -0,0 +1,3181 @@
++/* Picasso USB debug console: CDC-ACM log streaming over DWC3.
++ *
++ * Port of the vermeer (ios-vermeer-lab) USB bring-up to the UniXNU Darwin 23
++ * kernel. The console mirror ring is streamed on the bulk IN endpoint, panic
++ * output uses a separate synchronous path, and the bulk OUT endpoint accepts a
++ * small diagnostic command set.
++ *
++ * Hardware notes (SM7250): the USB controller is a Synopsys DWC3 at
++ * 0x0a600000 behind Qualcomm's dwc-usb3-msm wrapper (QSCRATCH at +0xf8800),
++ * the same IP generation as SM8550/SM8650 whose constants vermeer validated.
++ * The controller is only touched when GCC reports the USB30_PRIM power
++ * domain on; the soft reset is bounded. The wrapper is told to use UTMI as
++ * the PIPE clock because Picasso has no enabled SuperSpeed PHY, but no clock
++ * rate or PHY power state is changed here. ABL/UEFI leave the controller
++ * powered from the fastboot session. Boot-arg picasso_usb=1 probes state
++ * only, 2 also runs the console.
++ * picasso_usb_trace=1 enables bulk-IN event and poller heartbeat logs.
++ */
++#include <sys/param.h>
++#include <sys/systm.h>
++#include <kern/clock.h>
++#include <kern/thread.h>
++#include <kern/sched_prim.h>
++#include <machine/machine_routines.h>
++#include <machine/atomic.h>
++#include <arm/caches_internal.h>
++#include <vm/pmap.h>
++#include <vm/vm_kern.h>
++#include <pexpert/pexpert.h>
++
++extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
++extern ppnum_t pmap_find_phys(pmap_t pmap, addr64_t va);
++extern uint64_t kvtophys(vm_offset_t va);
++extern void console_write_unbuffered(char);
++/* Optional when this console patch is used without the ArmCpu archive. */
++extern volatile uint64_t armcpu_timer_interrupts __attribute__((weak_import));
++
++/* ------------------------------------------------------------------ */
++/* Console mirror ring: any context, best effort, never waits.        */
++
++#define PURing_SIZE   (256 * 1024)
++#define PURing_MASK   (PURing_SIZE - 1)
++#define PU_PANIC_RING_SIZE  (128u * 1024u)
++#define PU_PANIC_RING_MASK  (PU_PANIC_RING_SIZE - 1)
++#define PU_CMD_SIZE         80u
++#define PSHOLD_PA           0x0c264000u
++#define APSS_WDT_PA         0x17c10000u
++#define IMEM_PA             0x146ab000u
++#define IMEM_RESTART_REASON 0x65cu
++#define IMEM_FASTBOOT_MODE  0x77665500u
++#define APSS_WDT_RST        0x04u
++#define APSS_WDT_EN         0x08u
++#define APSS_WDT_BARK       0x10u
++#define APSS_WDT_BITE       0x14u
++#define APSS_WDT_RATE_HZ    32768u
++#define APSS_WDT_TIMEOUT_MS 15000u
++#define APSS_WDT_FORCED_BITE 4u
++#define PICASSO_USB_CONTROL_DEFAULT_MS 60000u
++#define PICASSO_USB_FLUSH_POLLS 64u
++#define PICASSO_USB_FINAL_FLUSH_POLLS 8u
++#define PICASSO_USB_FLUSH_GAP_US 100u
++
++enum picasso_usb_reset_mode {
++	PICASSO_USB_RESET_WATCHDOG = 0,
++	PICASSO_USB_RESET_PSCI = 1,
++	PICASSO_USB_RESET_PSHOLD = 2
++};
++
++static struct {
++	char        buffer[PURing_SIZE];
++	uint64_t    total;
++} pur_ring;
++static struct {
++	char        buffer[PU_PANIC_RING_SIZE];
++	uint64_t    total;
++} pup_ring;
++static uint32_t _Atomic pur_lock;
++static uint64_t _Atomic pur_dropped;
++static uint64_t pup_pos;
++static uint32_t _Atomic pup_flush_lock;
++static bool pur_live;                   /* set once the TX thread streams */
++static bool pu_panic_active;
++
++struct pur_text {
++	char     bytes[96];
++	uint32_t length;
++};
++
++void picasso_usb_log_char(char c);
++void picasso_usb_log_write(const char *data, uint32_t length);
++void picasso_usb_console_start(void);
++void picasso_usb_panic_begin(void);
++void picasso_usb_panic_putc(char c);
++void picasso_usb_panic_write(const char *text, int size);
++void picasso_usb_panic_flush(void);
++void picasso_usb_panic_reset(void);
++void picasso_usb_panic_stackshot(const void *, unsigned);
++bool picasso_watchdog_backend_claim(const void *owner);
++bool picasso_watchdog_backend_enable(const void *owner);
++bool picasso_watchdog_backend_disable(const void *owner);
++bool picasso_watchdog_backend_pet(const void *owner);
++static void picasso_usb_console_drive_poll(void);
++static void ud_process_command(void);
++static void ud_finish_reboot(void);
++static void picasso_usb_watchdog_disable(void);
++static void ud_configure(void);
++
++void
++picasso_usb_log_write(const char *data, uint32_t length)
++{
++	if (pu_panic_active || data == NULL || length == 0) {
++		return;
++	}
++	if (!os_atomic_cmpxchg(&pur_lock, 0, 1, acquire)) {
++		os_atomic_add(&pur_dropped, length, relaxed);
++		return;
++	}
++	for (uint32_t i = 0; i < length; i++) {
++		pur_ring.buffer[pur_ring.total & PURing_MASK] = data[i];
++		pur_ring.total++;
++	}
++	os_atomic_store(&pur_lock, 0, release);
++	/*
++	 * bsd_init still runs before early kernel threads reliably receive CPU.
++	 * Drive the DWC3 event ring from console output itself until the
++	 * background poller becomes schedulable.
++	 */
++	picasso_usb_console_drive_poll();
++}
++
++void
++picasso_usb_log_char(char c)
++{
++	picasso_usb_log_write(&c, 1);
++}
++
++/*
++ * Event logging may run from inside console output, so it must never call
++ * printf() recursively. Append the complete diagnostic line to the console
++ * ring with one lock acquisition instead.
++ */
++static void
++pur_emit_raw(const char *data, uint32_t length)
++{
++	if (!os_atomic_cmpxchg(&pur_lock, 0, 1, acquire)) {
++		os_atomic_add(&pur_dropped, length, relaxed);
++		return;
++	}
++	for (uint32_t i = 0; i < length; i++) {
++		pur_ring.buffer[pur_ring.total & PURing_MASK] = data[i];
++		pur_ring.total++;
++	}
++	os_atomic_store(&pur_lock, 0, release);
++}
++
++static void
++pur_text_append(struct pur_text *text, const char *value)
++{
++	while (*value != '\0' && text->length < sizeof(text->bytes)) {
++		text->bytes[text->length++] = *value++;
++	}
++}
++
++static void
++pur_text_u64(struct pur_text *text, uint64_t value)
++{
++	char digits[20];
++	uint32_t count = 0;
++	do {
++		digits[count++] = (char)('0' + value % 10);
++		value /= 10;
++	} while (value != 0);
++	while (count != 0 && text->length < sizeof(text->bytes)) {
++		text->bytes[text->length++] = digits[--count];
++	}
++}
++
++static void
++pur_text_hex32(struct pur_text *text, uint32_t value)
++{
++	static const char hex[] = "0123456789abcdef";
++	for (int shift = 28; shift >= 0; shift -= 4) {
++		if (text->length < sizeof(text->bytes)) {
++			text->bytes[text->length++] = hex[(value >> shift) & 0xfu];
++		}
++	}
++}
++
++static void
++pur_emit_event(uint64_t index, unsigned ep, uint32_t event)
++{
++	struct pur_text text = { .length = 0 };
++	pur_text_append(&text, "PICASSO USB: event ");
++	pur_text_u64(&text, index);
++	pur_text_append(&text, " ep");
++	pur_text_u64(&text, ep);
++	pur_text_append(&text, " 0x");
++	pur_text_hex32(&text, event);
++	pur_text_append(&text, "\r\n");
++	pur_emit_raw(text.bytes, text.length);
++}
++
++static uint32_t
++pur_copy(uint64_t *pos, char *out, uint32_t max)
++{
++	uint32_t n = 0;
++	if (!os_atomic_cmpxchg(&pur_lock, 0, 1, acquire)) {
++		return 0;
++	}
++	if (pur_ring.total - *pos > PURing_SIZE) {
++		*pos = pur_ring.total - PURing_SIZE;
++	}
++	n = (uint32_t)MIN((uint64_t)max, pur_ring.total - *pos);
++	for (uint32_t i = 0; i < n; i++) {
++		out[i] = pur_ring.buffer[(*pos + i) & PURing_MASK];
++	}
++	*pos += n;
++	os_atomic_store(&pur_lock, 0, release);
++	return n;
++}
++
++static uint32_t
++pup_copy(char *out, uint32_t max)
++{
++	uint64_t pending = pup_ring.total - pup_pos;
++	uint32_t n = (uint32_t)MIN((uint64_t)max, pending);
++	for (uint32_t i = 0; i < n; i++) {
++		out[i] = pup_ring.buffer[(pup_pos + i) & PU_PANIC_RING_MASK];
++	}
++	pup_pos += n;
++	return n;
++}
++
++/* ------------------------------------------------------------------ */
++/* DWC3 device mode, EP0 + one bulk IN pair. Register layout follows   */
++/* the Synopsys databook as used by Linux drivers/usb/dwc3.           */
++
++#define GCC_PA                  0x00100000u
++#define GCC_SIZE                0x00090000u
++#define GCC_USB30_PRIM_GDSCR    0x0f004u         /* bit 31: power on */
++#define GCC_USB30_PRIM_MASTER   0x0f010u
++#define GCC_USB30_PRIM_SLEEP    0x0f018u
++#define GCC_USB30_PRIM_MOCK_UTMI 0x0f01cu
++#define GCC_CFG_NOC_USB3_PRIM   0x0f07cu
++#define GCC_AGGRE_USB3_PRIM     0x0f080u
++#define GCC_USB3_PRIM_CLKREF    0x8c010u
++
++#define SMMU_PA                 0x15000000u
++#define SMMU_SIZE               0x000d0000u
++#define USB_STREAM_ID           0x00e0u
++
++#define DWC3_PA                 0x0a600000u
++#define DWC3_SIZE               0x00100000u
++#define QSCRATCH_OFFSET         0x000f8800u
++#define QSCRATCH_PA             (DWC3_PA + QSCRATCH_OFFSET)
++#define QSCRATCH_GENERAL_CFG    0x08u
++#define   PIPE_UTMI_CLK_SEL     (1u << 0)
++#define   PIPE3_PHYSTATUS_SW    (1u << 3)
++#define   PIPE_UTMI_CLK_DIS     (1u << 8)
++#define QSCRATCH_HS_PHY_CTRL    0x10u
++#define   UTMI_OTG_VBUS_VALID   (1u << 20)
++#define   SW_SESSVLD_SEL        (1u << 28)
++#define QSCRATCH_CGCTL          0x28u
++#define QSCRATCH_SS_PHY_CTRL    0x30u
++#define   LANE0_PWR_PRESENT     (1u << 24)
++#define QSCRATCH_PWR_EVT_STAT   0x58u
++#define QSCRATCH_PWR_EVT_MASK   0x5cu
++
++#define GCTL            0xc110u
++#define GHWPARAMS3      0xc14cu
++#define GHWPARAMS4      0xc150u
++#define GHWPARAMS5      0xc154u
++#define GHWPARAMS6      0xc158u
++#define GHWPARAMS7      0xc15cu
++#define GUSB2PHYCFG0    0xc200u
++#define GUSB3PIPECTL0   0xc2c0u
++#define GTXFIFOSIZ(n)   (0xc300u + 4u * (n))
++#define GRXFIFOSIZ(n)   (0xc380u + 4u * (n))
++#define GEVNTADRLO      0xc400u
++#define GEVNTADRHI      0xc404u
++#define GEVNTSIZ        0xc408u
++#define GEVNTCOUNT      0xc40cu
++#define DCFG            0xc700u
++#define DCTL            0xc704u
++#define DEVTEN          0xc708u
++#define DSTS            0xc70cu
++#define DALEPENA        0xc720u
++#define DEPCMDPAR2(n)   (0xc800u + 0x10u * (n))
++#define DEPCMDPAR1(n)   (0xc804u + 0x10u * (n))
++#define DEPCMDPAR0(n)   (0xc808u + 0x10u * (n))
++#define DEPCMD(n)       (0xc80cu + 0x10u * (n))
++
++#define DCTL_RUN_STOP   (1u << 31)
++#define DCTL_CSFTRST    (1u << 30)
++#define DSTS_DEVCTRLHLT (1u << 22)
++#define GUSB2PHYCFG_SUSPHY   (1u << 6)
++#define GUSB2PHYCFG_ENBLSLPM (1u << 8)
++#define GUSB3PIPECTL_SUSPHY  (1u << 17)
++
++#define DEPCMD_SETEPCONFIG      1u
++#define DEPCMD_SETTRANSFRESOURCE 2u
++#define DEPCMD_GETEPSTATE       3u
++#define DEPCMD_SETSTALL         4u
++#define DEPCMD_CLEARSTALL       5u
++#define DEPCMD_STARTTRANSFER    6u
++#define DEPCMD_UPDATETRANSFER   7u
++#define DEPCMD_ENDTRANSFER      8u
++#define DEPCMD_DEPSTARTCFG      9u
++#define DEPCMD_FORCE_RM         (1u << 11)
++#define DEPCMD_CMDACT           (1u << 10)
++#define DEPCMD_CMDIOC           (1u << 8)
++
++#define UD_EPCMD_NO_RESOURCE    (-2)
++
++#define TRB_HWO         (1u << 0)
++#define TRB_LST         (1u << 1)
++#define TRB_CSP         (1u << 3)
++#define TRB_ISP_IMI     (1u << 10)
++#define TRB_IOC         (1u << 11)
++#define TRBCTL_NORMAL   (1u << 4)
++#define TRBCTL_SETUP    (2u << 4)
++#define TRBCTL_STATUS2  (3u << 4)
++#define TRBCTL_STATUS3  (4u << 4)
++#define TRBCTL_DATA     (5u << 4)
++#define TRBCTL_LINK     (8u << 4)
++
++/* physical endpoints: 0/1 = ep0 OUT/IN, 2 = bulk OUT, 3 = bulk IN */
++#define EP_RX           2u
++#define EP_TX           3u
++#define EP_NOTIFY       5u
++
++#define UD_DIAG_REQUEST 0x50u
++#define UD_DIAG_MAGIC   0x50554447u
++
++/* DMA area layout */
++#define UD_EVT          0x0000u         /* event buffer, 4 KiB */
++#define UD_EVT_SIZE     0x1000u
++#define UD_TRB_OUT      0x1000u         /* ep0 OUT TRB */
++#define UD_TRB_IN       0x1010u         /* ep0 IN TRB */
++#define UD_TRB_TX       0x1030u         /* bulk IN TRB */
++#define UD_TRB_RX       0x1080u         /* bulk OUT TRB */
++#define UD_TRB_RX_LINK  0x1090u         /* bulk OUT ring link */
++#define UD_TRB_NOTIFY   0x1020u         /* interrupt IN endpoint */
++#define UD_SETUP        0x1040u         /* 8-byte setup packet */
++#define UD_DATA         0x1100u         /* ep0 data stage, 512 bytes */
++#define UD_NOTIFY       0x1800u         /* CDC serial-state notification */
++#define UD_NOTIFY_SIZE  10u
++#define UD_TX           0x2000u         /* bulk IN log chunk, 4 KiB */
++#define UD_TX_SIZE      0x1000u
++#define UD_RX           0x3000u         /* bulk OUT command chunk */
++#define UD_RX_SIZE      0x200u
++#define UD_SIZE         0x4000u
++
++static struct {
++	vm_offset_t dwc;
