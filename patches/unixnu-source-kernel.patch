diff --git a/patches/xnu/zzzzzz-picasso-ipc-queue-dump.patch b/patches/xnu/zzzzzz-picasso-ipc-queue-dump.patch
new file mode 100644
--- /dev/null
+++ b/patches/xnu/zzzzzz-picasso-ipc-queue-dump.patch
@@ -0,0 +1,166 @@
+diff --git a/osfmk/ipc/mach_debug.c b/osfmk/ipc/mach_debug.c
+--- a/osfmk/ipc/mach_debug.c
++++ b/osfmk/ipc/mach_debug.c
+@@ -588,3 +588,162 @@
+ 	return KERN_NOT_SUPPORTED;
+ }
+ #endif
++
++#if DEVELOPMENT || DEBUG
++#include <kern/task.h>
++/* Picasso: a client waits forever for a reply from a daemon that sits idle. For each
++ * receive right of one task, show how many messages wait in its queue and how a
++ * receiver would be woken: port set member, kevent knote, or workloop link. */
++struct picasso_knote_info { uint32_t sfflags, kq_count; uint16_t status, flags, kq_state; uint8_t tr_state, qos; };
++void picasso_knote_info(struct knote *kn, struct picasso_knote_info *out);
++void picasso_dump_receive_rights(task_t task, const char *who);
++void
++picasso_dump_receive_rights(task_t task, const char *who)
++{
++	struct { mach_port_name_t name; uint16_t count, limit; uint8_t flags;
++	    struct picasso_knote_info kn; } rows[48];
++	unsigned shown = 0, receive = 0, queued = 0;
++	ipc_space_t space = task->itk_space;
++	if (space == IS_NULL) return;
++	is_read_lock(space);
++	if (!is_active(space)) {
++		is_read_unlock(space);
++		return;
++	}
++	ipc_entry_table_t table = is_active_table(space);
++	ipc_entry_num_t tsize = ipc_entry_table_count(table);
++	for (mach_port_index_t index = 1; index < tsize; index++) {
++		ipc_entry_t entry = ipc_entry_table_get_nocheck(table, index);
++		ipc_entry_bits_t bits = entry->ie_bits;
++		if (!(IE_BITS_TYPE(bits) & MACH_PORT_TYPE_RECEIVE)) continue;
++		ipc_port_t port = ip_object_to_port(entry->ie_object);
++		receive++;
++		ip_mq_lock(port);
++		uint16_t count = port->ip_messages.imq_msgcount;
++		uint16_t limit = port->ip_messages.imq_qlimit;
++		bool any = port->ip_sync_link_state == PORT_SYNC_LINK_ANY;
++		uint8_t flags = (ip_in_pset(port) ? 1 : 0) |
++		    (port->ip_specialreply ? 2 : 0) | (port->ip_service_port ? 4 : 0) |
++		    (!port->ip_specialreply && any && SLIST_FIRST(&port->ip_klist) ? 8 : 0) |
++		    (!port->ip_specialreply && !any ? 16 : 0);
++		struct picasso_knote_info kn = { .tr_state = 0xfe };
++		if (flags & 8) {
++			picasso_knote_info(SLIST_FIRST(&port->ip_klist), &kn);
++		}
++		ip_mq_unlock(port);
++		queued += count;
++		if (shown < 48 && (count || (flags & 6))) {
++			rows[shown].name = MACH_PORT_MAKE(index, IE_BITS_GEN(bits));
++			rows[shown].count = count;
++			rows[shown].limit = limit;
++			rows[shown].flags = flags;
++			rows[shown].kn = kn;
++			shown++;
++		}
++	}
++	is_read_unlock(space);
++	printf("PICASSO_IPC %s receive=%u queued=%u\n", who, receive, queued);
++	for (unsigned i = 0; i < shown; i++) {
++		printf("PICASSO_IPC %s name=0x%x msgs=%u qlimit=%u pset=%u knote=%u workloop=%u srp=%u service=%u\n",
++		    who, rows[i].name, rows[i].count, rows[i].limit, rows[i].flags & 1,
++		    (rows[i].flags >> 3) & 1, (rows[i].flags >> 4) & 1, (rows[i].flags >> 1) & 1,
++		    (rows[i].flags >> 2) & 1);
++		if (rows[i].flags & 8) {
++			printf("PICASSO_IPC %s name=0x%x kn_status=0x%x kn_flags=0x%x sfflags=0x%x qos=%u kq_state=0x%x kq_count=%u tr_state=%u\n",
++			    who, rows[i].name, rows[i].kn.status, rows[i].kn.flags, rows[i].kn.sfflags,
++			    rows[i].kn.qos, rows[i].kn.kq_state, rows[i].kn.kq_count, rows[i].kn.tr_state);
++		}
++	}
++}
++#include <kern/thread.h>
++#include <kern/processor.h>
++struct proc;
++extern char *proc_name_address(struct proc *p);
++/* Picasso: the workqueue creator thread of a daemon is chosen but never runs. Show the
++ * scheduling state of each thread of one task, and which runnable threads compete for
++ * the single CPU. Fields are read without thread locks: a diagnostic snapshot only. */
++static void
++picasso_print_thread(const char *who, thread_t thread, uint64_t now)
++{
++	task_t task = get_threadtask(thread);
++	void *bsd = task ? get_bsdtask_info(task) : NULL;
++	uint64_t ago = 0;
++	if (thread->last_made_runnable_time && now > thread->last_made_runnable_time) {
++		absolutetime_to_nanoseconds(now - thread->last_made_runnable_time, &ago);
++	}
++	printf("PICASSO_THR %s tid=%llu pid=%d name=%s state=0x%x pri=%d base=%d mode=%d bucket=%d runnable_ms=%llu\n",
++	    who, thread->thread_id, task ? task_pid(task) : -1,
++	    bsd ? proc_name_address(bsd) : "?", thread->state, thread->sched_pri,
++	    thread->base_pri, thread->sched_mode, thread->th_sched_bucket, ago / NSEC_PER_MSEC);
++}
++#if __arm64__
++#include <arm/thread.h>
++#include <arm/proc_reg.h>
++/* Frame-pointer walk of a thread that is off-CPU: its user registers were saved
++ * on kernel entry and its stack does not move. Reads go through the task's map. */
++static void
++picasso_print_user_stack(const char *who, thread_t thread)
++{
++	arm_saved_state_t *state = get_user_regs(thread);
++	if (!state || !is_saved_state64(state)) return;
++	vm_map_t map = get_task_map(get_threadtask(thread));
++	const uint64_t mask = 0x7fffffffffull;  /* drop pointer authentication bits */
++	uint64_t frames[16] = { get_saved_state_pc(state) & mask, get_saved_state_lr(state) & mask };
++	unsigned depth = 2;
++	uint64_t fp = get_saved_state_fp(state);
++	while (fp && depth < 16) {
++		uint64_t pair[2];
++		if (vm_map_read_user(map, fp, pair, sizeof(pair)) != KERN_SUCCESS || !pair[1]) break;
++		frames[depth++] = pair[1] & mask;
++		if (pair[0] <= fp) break;
++		fp = pair[0];
++	}
++	for (unsigned i = 0; i < depth; i += 4) {
++		printf("PICASSO_STK %s tid=%llu offset=%u %llx %llx %llx %llx\n", who, thread->thread_id, i,
++		    frames[i], frames[i + 1], frames[i + 2], frames[i + 3]);
++	}
++}
++#endif
++void picasso_dump_threads(task_t task, const char *who);
++void
++picasso_dump_threads(task_t task, const char *who)
++{
++	uint64_t now = mach_absolute_time();
++	thread_t thread, held[16];
++	unsigned count = 0;
++	task_lock(task);
++	printf("PICASSO_STK %s main_header=%llx cache_slide=%x\n", who,
++	    (unsigned long long)task->mach_header_vm_address, task->task_shared_region_slide);
++	queue_iterate(&task->threads, thread, thread_t, task_threads) {
++		picasso_print_thread(who, thread, now);
++		/* With one CPU, every other thread is off-CPU while this runs, so a runnable
++		 * thread's user registers are saved too (it was preempted). */
++		if (count < 16 && thread != current_thread()) {
++			thread_reference(thread);
++			held[count++] = thread;
++		}
++	}
++	task_unlock(task);
++	for (unsigned i = 0; i < count; i++) {
++#if __arm64__
++		picasso_print_user_stack(who, held[i]);
++#endif
++		thread_deallocate(held[i]);
++	}
++}
++void picasso_dump_runnable(void);
++void
++picasso_dump_runnable(void)
++{
++	uint64_t now = mach_absolute_time();
++	unsigned shown = 0;
++	thread_t thread;
++	lck_mtx_lock(&tasks_threads_lock);
++	queue_iterate(&threads, thread, thread_t, threads) {
++		if ((thread->state & (TH_RUN | TH_IDLE)) != TH_RUN || thread == current_thread()) continue;
++		if (shown++ < 40) picasso_print_thread("runnable", thread, now);
++	}
++	lck_mtx_unlock(&tasks_threads_lock);
++	printf("PICASSO_THR runnable total=%u\n", shown);
++}
++#endif
