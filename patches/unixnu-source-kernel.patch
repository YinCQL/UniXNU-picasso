++/* PICASSO_WATCHDOG_BACKEND_BEGIN: all APSS WDT writes share this lock. */
++#define PICASSO_WDT_TICKS ((uint32_t)(((uint64_t)APSS_WDT_TIMEOUT_MS * APSS_WDT_RATE_HZ / 1000u) - 1u))
++static uint32_t _Atomic picasso_wdt_lock;
++static uint32_t _Atomic picasso_wdt_terminal;
++static const void *picasso_wdt_owner;
++static bool picasso_wdt_forced;
++
++static bool
++picasso_watchdog_enter(boolean_t *interrupts)
++{
++	*interrupts = ml_set_interrupts_enabled(false);
++	if (!os_atomic_cmpxchg(&picasso_wdt_lock, 0, 1, acquire)) {
++		ml_set_interrupts_enabled(*interrupts);
++		return false;
++	}
++	return true;
++}
++
++static void
++picasso_watchdog_leave(boolean_t interrupts)
++{
++	os_atomic_store(&picasso_wdt_lock, 0, release);
++	ml_set_interrupts_enabled(interrupts);
++}
++
++static void
++picasso_usb_watchdog_terminal(void)
++{
++	/* Even a panic encountering a busy lock can permanently reject new work.
++	 * An already locked operation precedes the terminal transition. Forced
++	 * bite programming must take the same lock before replacing its count. */
++	os_atomic_store(&picasso_wdt_terminal, 1, release);
++}
++
++static bool
++picasso_watchdog_live_locked(void)
++{
++	return !os_atomic_load(&picasso_wdt_terminal, acquire) && ud.wdt != 0;
++}
++
++static bool
++picasso_watchdog_config_locked(bool enabled)
++{
++	return ud.wdt != 0 &&
++	    usb_rd(ud.wdt, APSS_WDT_EN) == (enabled ? 1u : 0u) &&
++	    (!enabled || usb_rd(ud.wdt, APSS_WDT_BITE) == PICASSO_WDT_TICKS);
++}
++
++static bool
++picasso_watchdog_pet_locked(void)
++{
++	if (!ud.watchdog_armed || !picasso_watchdog_config_locked(true) ||
++	    !picasso_watchdog_live_locked()) return false;
++	/* RST is a pulse: validate persistent registers, not an invented RST ack. */
++	usb_wr(ud.wdt, APSS_WDT_RST, 1);
++	return picasso_watchdog_config_locked(true);
++}
++
++static bool
++picasso_watchdog_program_locked(void)
++{
++	if (usb_rd(ud.wdt, APSS_WDT_EN) & 1u) {
++		/* Boot firmware may leave the watchdog enabled. A running timer
++		 * accepts a new bite interval immediately; pet after both writes. */
++		usb_wr(ud.wdt, APSS_WDT_BARK, PICASSO_WDT_TICKS);
++		usb_wr(ud.wdt, APSS_WDT_BITE, PICASSO_WDT_TICKS);
++		usb_wr(ud.wdt, APSS_WDT_RST, 1);
++		ud.watchdog_armed = picasso_watchdog_config_locked(true);
++		return ud.watchdog_armed;
++	}
++	/* Once started, finish the bounded arm sequence even if terminal is
++	 * requested concurrently, so an interrupted arm cannot leave EN=0. */
++	usb_wr(ud.wdt, APSS_WDT_EN, 0);
++	usb_wr(ud.wdt, APSS_WDT_RST, 1);
++	usb_wr(ud.wdt, APSS_WDT_BARK, PICASSO_WDT_TICKS);
++	usb_wr(ud.wdt, APSS_WDT_BITE, PICASSO_WDT_TICKS);
++	usb_wr(ud.wdt, APSS_WDT_EN, 1);
++	ud.watchdog_armed = picasso_watchdog_config_locked(true);
++	return ud.watchdog_armed;
++}
++
++bool
++picasso_watchdog_backend_claim(const void *owner)
++{
++	boolean_t interrupts;
++	if (owner == NULL || !picasso_watchdog_enter(&interrupts)) return false;
++	bool result = false;
++	if (picasso_watchdog_live_locked() &&
++	    (picasso_wdt_owner == NULL || picasso_wdt_owner == owner) &&
++	    picasso_watchdog_pet_locked() && picasso_watchdog_live_locked()) {
++		picasso_wdt_owner = owner;
++		result = true;
++	}
++	picasso_watchdog_leave(interrupts);
++	return result;
++}
++
++bool
++picasso_watchdog_backend_pet(const void *owner)
++{
++	boolean_t interrupts;
++	if (owner == NULL || !picasso_watchdog_enter(&interrupts)) return false;
++	bool result = picasso_watchdog_live_locked() && picasso_wdt_owner == owner &&
++	    picasso_watchdog_pet_locked();
++	picasso_watchdog_leave(interrupts);
++	return result;
++}
++
++bool
++picasso_watchdog_backend_disable(const void *owner)
++{
++	boolean_t interrupts;
++	if (owner == NULL || !picasso_watchdog_enter(&interrupts)) return false;
++	bool result = false;
++	if (picasso_watchdog_live_locked() && picasso_wdt_owner == owner &&
++	    picasso_watchdog_config_locked(ud.watchdog_armed)) {
++		if (ud.watchdog_armed) usb_wr(ud.wdt, APSS_WDT_EN, 0);
++		result = picasso_watchdog_config_locked(false);
++		if (result) ud.watchdog_armed = false;
++	}
++	picasso_watchdog_leave(interrupts);
++	return result;
++}
++
++bool
++picasso_watchdog_backend_enable(const void *owner)
++{
++	boolean_t interrupts;
++	if (owner == NULL || !picasso_watchdog_enter(&interrupts)) return false;
++	bool result = false;
++	if (picasso_watchdog_live_locked() && picasso_wdt_owner == owner &&
++	    picasso_watchdog_config_locked(ud.watchdog_armed)) {
++		result = ud.watchdog_armed ? picasso_watchdog_pet_locked() :
++		    picasso_watchdog_program_locked();
++	}
++	picasso_watchdog_leave(interrupts);
++	return result;
++}
++
++static bool
++picasso_usb_watchdog_pet(void)
++{
++	boolean_t interrupts;
++	if (!picasso_watchdog_enter(&interrupts)) return false;
++	bool result = picasso_watchdog_live_locked() && picasso_wdt_owner == NULL &&
++	    picasso_watchdog_pet_locked();
++	picasso_watchdog_leave(interrupts);
++	return result;
++}
++
++static void
++picasso_usb_watchdog_arm(void)
++{
++	boolean_t interrupts;
++	if (!picasso_watchdog_enter(&interrupts)) return;
++	bool attempted = ud.watchdog && picasso_watchdog_live_locked() &&
++	    picasso_wdt_owner == NULL;
++	bool armed = false;
++	uint32_t bark = 0, bite = 0, control = 0;
++	if (attempted) {
++		armed = picasso_watchdog_program_locked();
++		bark = usb_rd(ud.wdt, APSS_WDT_BARK);
++		bite = usb_rd(ud.wdt, APSS_WDT_BITE);
++		control = usb_rd(ud.wdt, APSS_WDT_EN);
++	}
++	picasso_watchdog_leave(interrupts);
++	if (attempted) printf("PICASSO USB: APSS watchdog %s ticks=%u bark=%u bite=%u ctl=%u\n",
++	    armed ? "armed" : "arm failed", PICASSO_WDT_TICKS, bark, bite, control);
++}
++
++static void
++picasso_usb_watchdog_disable(void)
++{
++	boolean_t interrupts;
++	if (!picasso_watchdog_enter(&interrupts)) return;
++	if (picasso_watchdog_live_locked() && picasso_wdt_owner == NULL) {
++		usb_wr(ud.wdt, APSS_WDT_EN, 0);
++		if (usb_rd(ud.wdt, APSS_WDT_EN) == 0) ud.watchdog_armed = false;
++	}
++	picasso_watchdog_leave(interrupts);
++}
++
++static bool
++picasso_usb_watchdog_force_bite(void)
++{
++	picasso_usb_watchdog_terminal();
++	boolean_t interrupts;
++	if (!picasso_watchdog_enter(&interrupts)) return false;
++	bool result = false;
++	if (ud.wdt != 0 && !picasso_wdt_forced) {
++		/* Preserve the vendor pet-then-four-tick-bite sequence. No other
++		 * WDT writer can reload a longer count after this critical section. */
++		if (!(usb_rd(ud.wdt, APSS_WDT_EN) & 1u)) {
++			usb_wr(ud.wdt, APSS_WDT_BARK, PICASSO_WDT_TICKS);
++			usb_wr(ud.wdt, APSS_WDT_BITE, PICASSO_WDT_TICKS);
++			usb_wr(ud.wdt, APSS_WDT_EN, 1);
++		}
++		usb_wr(ud.wdt, APSS_WDT_RST, 1);
++		usb_wr(ud.wdt, APSS_WDT_BITE, APSS_WDT_FORCED_BITE);
++		picasso_wdt_forced = true;
++	}
++	if (ud.wdt != 0 && picasso_wdt_forced) {
++		ud.watchdog_armed = (usb_rd(ud.wdt, APSS_WDT_EN) & 1u) != 0;
++		result = ud.watchdog_armed &&
++		    usb_rd(ud.wdt, APSS_WDT_BITE) == APSS_WDT_FORCED_BITE;
++	}
++	picasso_watchdog_leave(interrupts);
++	return result;
++}
++/* PICASSO_WATCHDOG_BACKEND_END */
++
++static bool
++picasso_usb_pshold_reset(void)
++{
++	picasso_usb_watchdog_terminal();
++	if (ud.pshold == 0) {
++		ud.pshold = ml_io_map(PSHOLD_PA, PAGE_SIZE);
++	}
++	if (ud.pshold == 0) {
++		printf("PICASSO CDC: PSHOLD map failed pa=0x%x; reset skipped\n",
++		    PSHOLD_PA);
++		return false;
++	}
++	printf("PICASSO CDC: PSHOLD reset begin pa=0x%x va=%p\n",
++	    PSHOLD_PA, (void *)ud.pshold);
++	*(volatile uint32_t *)ud.pshold = 0;
++	__asm__ volatile ("dsb sy" ::: "memory");
++	for (;;) {
++		__asm__ volatile ("wfe" ::: "memory");
++	}
++}
++
++static bool
++picasso_usb_arm_fastboot_reason(void)
++{
++	if (ud.imem == 0) {
++		printf("PICASSO CDC: IMEM Fastboot reason unavailable\n");
++		return false;
++	}
++
++	uint32_t previous = usb_rd(ud.imem, IMEM_RESTART_REASON);
++	printf("PICASSO CDC: IMEM Fastboot reason arm pa=0x%x previous=0x%08x target=0x%08x\n",
++	    IMEM_PA + IMEM_RESTART_REASON, previous, IMEM_FASTBOOT_MODE);
++	usb_wr(ud.imem, IMEM_RESTART_REASON, IMEM_FASTBOOT_MODE);
++	uint32_t readback = usb_rd(ud.imem, IMEM_RESTART_REASON);
++	if (readback != IMEM_FASTBOOT_MODE) {
++		printf("PICASSO CDC: IMEM Fastboot reason readback mismatch=0x%08x\n",
++		    readback);
++		return false;
++	}
++	printf("PICASSO CDC: IMEM Fastboot reason armed readback=0x%08x\n",
++	    readback);
++	return true;
++}
++
++static void
++picasso_usb_psci_reset(void)
++{
++	picasso_usb_watchdog_terminal();
++	/*
++	 * The device tree declares the PSCI conduit as SMC. Unlike an APSS
++	 * watchdog bite, this enters the same firmware reset path that has
++	 * already rebooted Picasso during the entry probes, so it should keep
++	 * the PMIC SOFT_SPARE reason DarwinBoot programmed.
++	 */
++	register uint64_t x0 __asm__("x0") = 0x84000009ull;
++	register uint64_t x1 __asm__("x1") = 0;
++	register uint64_t x2 __asm__("x2") = 0;
++	register uint64_t x3 __asm__("x3") = 0;
++	__asm__ volatile ("dsb sy" ::: "memory");
++	__asm__ volatile ("msr daifset, #0xf" ::: "memory");
++	__asm__ volatile ("smc #0" : "+r" (x0)
++	    : "r" (x1), "r" (x2), "r" (x3)
++	    : "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11",
++	      "x12", "x13", "x14", "x15", "x16", "x17", "memory");
++	printf("PICASSO CDC: PSCI reset returned (x0=%llu); falling back\n",
++	    (unsigned long long)x0);
++}
++
++static void
++picasso_usb_watchdog_reset(void)
++{
++	picasso_usb_watchdog_terminal();
++	if (ud.wdt == 0) {
++		ud.wdt = ml_io_map(APSS_WDT_PA, PAGE_SIZE);
++	}
++	/*
++	 * DarwinBoot has already preset the PMIC SOFT_SPARE reset reason.
++	 * Keep this path as a fallback for firmware where PSCI reset is not
++	 * available.
++	 */
++	if (picasso_usb_watchdog_force_bite()) {
++		__asm__ volatile ("dsb sy" ::: "memory");
++		__asm__ volatile ("msr daifset, #0xf" ::: "memory");
++		for (;;) {
++			__asm__ volatile ("wfe" ::: "memory");
++		}
++	}
++}
++
++static void
++picasso_usb_system_reset(void)
++{
++	picasso_usb_watchdog_terminal();
++	printf("PICASSO CDC: reset begin mode=%u\n", ud.reset_mode);
++	(void)picasso_usb_arm_fastboot_reason();
++	if (ud.reset_mode == PICASSO_USB_RESET_PSCI) {
++		picasso_usb_psci_reset();
++	}
++	if (ud.reset_mode != PICASSO_USB_RESET_PSHOLD) {
++		picasso_usb_watchdog_reset();
++	}
++	printf("PICASSO CDC: reset fallback PSHOLD\n");
++	if (!picasso_usb_pshold_reset()) {
++		printf("PICASSO CDC: reset failed; console remains alive\n");
++	}
++}
++
++static bool
++ud_flush_console(unsigned polls, unsigned gap_usec)
++{
++	for (unsigned i = 0; i < polls; i++) {
++		ud_poll_events();
++		ud_tx_pump();
++		if (!ud.tx_busy && pur_ring.total == ud.tx_pos) {
++			return true;
++		}
++		picasso_usb_busy_wait(gap_usec);
++	}
++	return !ud.tx_busy && pur_ring.total == ud.tx_pos;
++}
++
++static void
++ud_finish_reboot(void)
++{
++	picasso_usb_watchdog_terminal();
++	/*
++	 * Never make reset conditional on an infinitely busy console ring:
++	 * PICASSO USB events can append bytes while this drain is running.
++	 * Give the current output a short, fixed opportunity to leave, then
++	 * reset unconditionally. The IMEM Fastboot reason was armed above.
++	 */
++	(void)picasso_usb_arm_fastboot_reason();
++	printf("PICASSO CDC: fastboot flush begin tx_busy=%u pending=%llu\n",
++	    ud.tx_busy ? 1u : 0u, pur_ring.total - ud.tx_pos);
++	bool flushed = ud_flush_console(PICASSO_USB_FLUSH_POLLS,
++	    PICASSO_USB_FLUSH_GAP_US);
++	printf("PICASSO CDC: fastboot flush %s; entering configured reset path\n",
++	    flushed ? "complete" : "deadline");
++	(void)ud_flush_console(PICASSO_USB_FINAL_FLUSH_POLLS,
++	    PICASSO_USB_FLUSH_GAP_US);
++	picasso_usb_system_reset();
++}
++
++static void
++ud_finish_hang(void)
++{
