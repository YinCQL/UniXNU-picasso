++/* A thread-context RAM snapshot, not a timer-register read. A missing
++ * optional ArmCpu symbol is reported separately from an observed zero. */
++static uint64_t
++ud_timer_irq_snapshot(const volatile uint64_t *counter)
++{
++	return counter != NULL ? *counter : 0;
++}
++
++/* Only the background thread services the watchdog here. Console writes
++ * can re-enter ud_poll_serialized(), but cannot recurse into this helper.
++ * Time samples are diagnostic only: a stopped clock must not stop pets. */
++static void
++ud_background_poll(struct ud_poller_progress *progress)
++{
++	bool first = !progress->started;
++	progress->started = true;
++	if (first && !ud.panic_mode) {
++		printf("PICASSO USB: background first poll begin mono_ns=%llu\n",
++		    ud_monotonic_ns());
++	}
++	bool normal = ud_poll_serialized();
++	/* Ownership and the actual RST write are decided under the WDT lock. */
++	bool petted = normal && !ud.panic_mode && picasso_usb_watchdog_pet();
++	uint64_t now_ns = 0, gap_ns = 0;
++	bool gap_valid = false;
++	if (petted) {
++		/* Service a completed normal poll before diagnostics or yielding.
++		 * A failed try-lock is not USB progress and must not feed the dog. */
++		now_ns = ud_monotonic_ns();
++		gap_valid = progress->have_pet && now_ns >= progress->last_pet_ns;
++		if (gap_valid) {
++			gap_ns = now_ns - progress->last_pet_ns;
++		}
++		progress->last_pet_ns = now_ns;
++		progress->have_pet = true;
++	}
++	/* All diagnostics run after this pass has released the poll lock. */
++	if (first && !ud.panic_mode) {
++		printf("PICASSO USB: background first poll end normal=%u petted=%u mono_ns=%llu\n",
++		    normal ? 1u : 0u, petted ? 1u : 0u,
++		    petted ? now_ns : ud_monotonic_ns());
++	}
++	if (petted && !ud.panic_mode) {
++		bool late = gap_valid && gap_ns >= UD_WATCHDOG_LATE_NS;
++		bool report = false;
++		if (progress->initial_reports < UD_WATCHDOG_INITIAL_REPORTS) {
++			progress->initial_reports++;
++			report = true;
++		} else if (late && progress->late_reports < UD_WATCHDOG_LATE_REPORTS) {
++			progress->late_reports++;
++			report = true;
++		}
++		if (report) {
++			const volatile uint64_t *timer_irqs = &armcpu_timer_interrupts;
++			printf("PICASSO USB: watchdog pet mono_ns=%llu gap_ns=%llu gap_valid=%u late=%u timer_irqs=%llu timer_irq_valid=%u\n",
++			    now_ns, gap_ns, gap_valid ? 1u : 0u, late ? 1u : 0u,
++			    ud_timer_irq_snapshot(timer_irqs), timer_irqs != NULL ? 1u : 0u);
++		}
++	}
++}
++
++static void
++ud_thread(void *arg __unused, wait_result_t wr __unused)
++{
++	uint64_t polls = 0;
++	struct ud_poller_progress progress = { 0 };
++	bool first_yield = true;
++	const volatile uint64_t *timer_irqs = &armcpu_timer_interrupts;
++
++	/*
++	 * Keep the bounded spin, then allow other runnable work to proceed.
++	 * In this XNU, zero depresses to priority 0 without a restore timeout;
++	 * 1 ms arms the priority-restoration timer. It is not a return deadline
++	 * and still requires working timer IRQ delivery and scheduling.
++	 */
++	printf("PICASSO USB: busy poller started\n");
++	for (;;) {
++		ud_background_poll(&progress);
++		polls++;
++		if (ud.trace_polling && (polls % 4096) == 0) {
++			printf("PICASSO USB: poller heartbeat polls=%llu events=%llu rx_busy=%u\n",
++			    polls, ud.events, ud.rx_busy ? 1u : 0u);
++		}
++		picasso_usb_busy_wait(100);
++		bool report_yield = first_yield && !ud.panic_mode;
++		first_yield = false;
++		if (report_yield) {
++			printf("PICASSO USB: background first yield begin depress_ms=1 mono_ns=%llu timer_irqs=%llu timer_irq_valid=%u\n",
++			    ud_monotonic_ns(), ud_timer_irq_snapshot(timer_irqs),
++			    timer_irqs != NULL ? 1u : 0u);
++		}
++		thread_yield_internal(1);
++		if (report_yield && !ud.panic_mode) {
++			printf("PICASSO USB: background first yield end mono_ns=%llu timer_irqs=%llu timer_irq_valid=%u\n",
++			    ud_monotonic_ns(), ud_timer_irq_snapshot(timer_irqs),
++			    timer_irqs != NULL ? 1u : 0u);
++		}
++	}
++}
