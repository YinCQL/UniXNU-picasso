++/*
++ * LaunchServices' first-boot progress service synchronously calls
++ * performJournalRecovery() from its dispatch_once setup path. That method does
++ * a dispatch_sync onto the install-controls queue while
++ * restoreInactiveInstalls() waits for the database seeding group on that same
++ * queue. This image has no install journal, so returning from the entry point
++ * is equivalent to an empty recovery and breaks the self-wait without
++ * touching filesystem, trust or code-signature policy.
++ */
++unsigned
++picasso_patch_lsd_task(task_t task)
++{
++	enum {
++		JournalAddress = 0x187dc532c,
++		JournalExpected = 0xd10243ff,
++		JournalExpected1 = 0x6d0523e9,
++		StubReturn = 0xd65f03c0,
++		StubNop = 0xd503201f,
++	};
++	if (!task) {
++		return 0;
++	}
++	task_lock(task);
++	uint32_t slide = task->task_shared_region_slide;
++	pmap_t pmap = vm_map_pmap(get_task_map(task));
++	task_unlock(task);
+ 
++	const uint64_t address = JournalAddress + slide;
++	const char *where = "";
++	ppnum_t page = picasso_user_page(pmap, address, &where);
++	if (!page) {
++		printf("PICASSO_LSD_STUB miss slide=%x address=%llx where=%s root=%u nofault=%u\n",
++		    slide, (unsigned long long)address, where,
++		    pmap_find_phys(pmap, address),
++		    pmap_find_phys_nofault(pmap, address));
++		return 0;
++	}
++	const uint64_t physical = ((uint64_t)page << PAGE_SHIFT) |
++	    (address & PAGE_MASK);
++	volatile uint32_t *word = (volatile uint32_t *)phystokv(physical);
++	const uint32_t before0 = word[0];
++	const uint32_t before1 = word[1];
++	if (before0 == StubReturn && before1 == StubNop) {
++		printf("PICASSO_LSD_STUB already part=journal-entry address=%llx\n",
++		    (unsigned long long)address);
++		return 1;
++	}
++	if (before0 != JournalExpected || before1 != JournalExpected1) {
++		printf("PICASSO_LSD_STUB mismatch part=journal-entry address=%llx before=%x/%x expected=%x/%x\n",
++		    (unsigned long long)address, before0, before1,
++		    JournalExpected, JournalExpected1);
++		return 0;
++	}
++	word[0] = StubReturn;
++	word[1] = StubNop;
