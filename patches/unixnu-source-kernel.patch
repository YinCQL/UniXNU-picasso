++ * at 0x50 and their mach ports at 0x260, plus a few bytes near brightness,
++ * EDR and ambient-light fields. Each run below keeps the iOS 16 bytes and
++ * moves them to their iPadOS 17 offset; inserted fields stay zero (no event
++ * waits or signals). Runs were derived from the store offsets of every
++ * kern_Swap and IOMobileFramebufferSwap setter in both dyld caches; the last
++ * three insertion points are bounded by known fields, not pinned exactly. */
++extern "C" void picasso_notifyd_snapshot_later(void);
++#define PICASSO_IOS16_SWAP_BYTES 0x46c
++#define PICASSO_IPADOS17_SWAP_BYTES 0x508
++static const struct { uint16_t begin, end, shift; } picassoSwapRuns[] = {
++	{0x000, 0x050, 0x00}, {0x050, 0x260, 0x48}, {0x260, 0x2e6, 0x6c}, {0x2e6, 0x2e8, 0x6d},
++	{0x2e8, 0x30c, 0x70}, {0x30c, 0x37b, 0x78}, {0x37b, 0x467, 0x7c}, {0x467, 0x46c, 0x9c},
++};
++static void *
++picasso_ios16_swap(const void *record)
++{
++	uint8_t *out = (uint8_t *)IOMallocZeroData(PICASSO_IPADOS17_SWAP_BYTES);
++	if (!out) return NULL;
++	for (size_t i = 0; i < sizeof(picassoSwapRuns) / sizeof(picassoSwapRuns[0]); ++i) {
++		memcpy(out + picassoSwapRuns[i].begin + picassoSwapRuns[i].shift,
++		    (const uint8_t *)record + picassoSwapRuns[i].begin,
++		    picassoSwapRuns[i].end - picassoSwapRuns[i].begin);
++	}
++	return out;
++}
++/* The iOS 16 IOSurface client and the retained iPadOS 17 IOSurfaceRootUserClient
++ * agree on selector numbers but not on two output structures. The limits query
++ * (selector 13) grew from 0x18 to 0x28 bytes: its two alignment masks remain
++ * 32-bit, while maximum width, height and row bytes widen to 64-bit. The surface lock
++ * result (create and lookup: selectors 0, 2, 4, 6, 7, 34 and their copies at +54)
++ * grew from 0xa68 to 0xc68 bytes: the header from 0x68 to 0x88 (0x18 bytes before
++ * the pixel format, 8 more before the plane count) and each of the 20 planes from
++ * 0x80 to 0x98 (six 32-bit size fields became 64-bit). Offsets come from the kernel handlers and
++ * the framework getters of both versions; new fields are dropped. */
++#define PICASSO_IOS16_LIMITS 0x18
++#define PICASSO_IPADOS17_LIMITS 0x28
