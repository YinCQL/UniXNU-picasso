+/* Combined payloads keep the four audio files first and only the pinned GPU
+ * bundle after them. No daemon replacements or arbitrary addon paths. */
+static bool
+picasso_media_addon_entry(uint32_t count, uint32_t index, const char *name, uint32_t mode, bool gpu)
+{
+    static const char *const names[] = {
+        "addons/NativeAdrenoMetal.bundle/Info.plist",
+        "addons/NativeAdrenoMetal.bundle/NativeAdrenoMetal",
+        "addons/NativeAdrenoMetal.bundle/_CodeSignature/CodeResources",
+        "addons/NativeAdrenoMetal.bundle/libNativeGL.dylib",
+        "addons/NativeAdrenoMetal.bundle/libOSMesa.8.dylib",
+        "addons/NativeAdrenoMetal.bundle/libvulkan_freedreno.dylib",
+        "addons/NativeAdrenoMetal.publish", "addons/NativeAdrenoMetal.clients"
+    };
+    static const uint32_t modes[] = {0644, 0755, 0644, 0755, 0755, 0755, 0644, 0644};
+    if (count == 4) return picasso_audio_addon_entry(count, index, name, mode);
+    if (!gpu || count != 12 || index >= 12) return false;
+    if (index < 4) return picasso_audio_addon_entry(4, index, name, mode);
+    return name && !strcmp(name, names[index - 4]) && mode == modes[index - 4];
+}
