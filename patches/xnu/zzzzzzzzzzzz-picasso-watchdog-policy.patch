 /*
+ * Diagnostic bring-up isolation for the original watchdogd.  The service
+ * checkin path does not complete on this kernel, so permit the board to
+ * disable only the watchdogd launch job for the current boot.  This writes
+ * launchd's own root-owned policy before the init exec; it does not replace
+ * or bypass the watchdog implementation.
+ */
+static int
+picasso_boot_watchdog_policy(proc_t p, user_addr_t scratch)
+{
+	static const char directory[] = "/private/var/db/com.apple.xpc.launchd";
+	static const char path[] = "/private/var/db/com.apple.xpc.launchd/disabled.plist";
+	static const char marker[] = "/private/var/db/com.apple.xpc.launchd/disabled.migrated";
+	static const char policy[] =
+	    "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n"
+	    "<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" "
+	    "\"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n"
+	    "<plist version=\"1.0\"><dict>"
+	    "<key>com.apple.watchdogd</key><true/>"
+	    "</dict></plist>\n";
+	int enabled = 0;
+	int32_t result = 0;
+	int error = 0;
+	int fd = -1;
+	struct mkdir_args md = {};
+	struct open_args op = {};
+	struct write_args wr = {};
+	struct close_args close_args = {};
+
+	if (!PE_parse_boot_argn("sheng-disable-watchdogd", &enabled,
+	    sizeof(enabled)) || enabled != 1) {
+		return 0;
+	}
+	if ((error = copyout(directory, scratch, sizeof(directory))) != 0) {
+		goto done;
+	}
+	md.path = scratch;
+	md.mode = 0755;
+	error = mkdir(p, &md, &result);
+	if (error == EEXIST) {
+		error = 0;
+	}
+	if (error != 0) {
+		goto done;
+	}
+	if ((error = copyout(path, scratch, sizeof(path))) != 0) {
+		goto done;
+	}
+	op.path = scratch;
+	op.flags = O_WRONLY | O_CREAT | O_TRUNC | O_NOFOLLOW;
+	op.mode = 0644;
+	error = open(p, &op, &result);
+	if (error != 0) {
+		goto done;
+	}
+	fd = result;
+	if ((error = copyout(policy, scratch + 0x200, sizeof(policy))) != 0) {
+		goto done;
+	}
+	wr.fd = fd;
+	wr.cbuf = scratch + 0x200;
+	wr.nbyte = sizeof(policy) - 1;
+	user_ssize_t written = 0;
+	error = write(p, &wr, &written);
+	if (error != 0 || written != (user_ssize_t)(sizeof(policy) - 1)) {
+		if (error == 0) {
+			error = EIO;
+		}
+		goto done;
+	}
+	close_args.fd = fd;
+	error = sys_close(p, &close_args, &result);
+	fd = -1;
+	if (error != 0) {
+		goto done;
+	}
+	if ((error = copyout(marker, scratch, sizeof(marker))) != 0) {
+		goto done;
+	}
+	struct open_args marker_open = {
+		.path = scratch,
+		.flags = O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW,
+		.mode = 0644,
+	};
+	error = open(p, &marker_open, &result);
+	if (error == EEXIST) {
+		error = 0;
+	} else if (error == 0) {
+		struct close_args marker_close = { .fd = result };
+		error = sys_close(p, &marker_close, &result);
+	}
+
+done:
+	if (fd >= 0) {
+		close_args.fd = fd;
+		(void)sys_close(p, &close_args, &result);
+	}
+	if (error == 0) {
+		printf("PICASSO_WATCHDOG_POLICY: watchdogd disabled for this boot\n");
+	} else {
+		printf("PICASSO_WATCHDOG_POLICY: failed error=%d\n", error);
+	}
+	return error;
+}
