diff --git a/bsd/kern/kern_exec.c b/bsd/kern/kern_exec.c
index 5272b82..8a3f9cc 100644
--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -8345,6 +8345,747 @@ done:
 	if (path) kfree_data(path, 256);
 }
 
+/* Persistent LaunchServices cache (PCLSD001 blob in the board aux window).
+ * The lsd rebuild does not survive a reboot by itself: the Data volume starts from the seed
+ * every boot. The export command (CDC "save-ls") copies the rebuilt com.apple.LaunchServices-*
+ * files into the board aux window (raw 4096-byte blocks with FUA, directly below the Data
+ * store), and the next boot restores them before the drop would run, so lsd does not rescan
+ * every application.
+ *
+ * Neither a Data file nor the raw store window is used. A Data file follows the file system's
+ * checkpoint: an unclean reboot can replay an older state with partly overwritten blocks (wf263:
+ * old size, wrong hash). The store window belongs to the Data overlay, which opens it before this
+ * code runs and keeps its own page layout there (wf258: writing at relative block 0 stepped on it).
+ * The aux window is its own region, validated by the same geometry checks, and a torn write only
+ * fails the blob's CRC, which makes the next boot drop and rebuild as if no blob existed. */
+#define PICASSO_LSP_MAGIC "PCLSD001"
+#define PICASSO_LSP_MAX   (16U << 20)
+#define PICASSO_LSP_BLOCKS (PICASSO_LSP_MAX / 4096)   /* the board aux window: 16 MiB */
+
+extern int native_ufs_aux_open(uint64_t, uint64_t *, const char **) __attribute__((weak_import));
+extern int native_ufs_aux_read(uint64_t, uint32_t, void *) __attribute__((weak_import));
+extern int native_ufs_aux_write(uint64_t, uint32_t, const void *) __attribute__((weak_import));
+
+static uint32_t
+picasso_lsp_hash(const uint8_t *data, size_t length)
+{
+	uint32_t hash = 2166136261u;
+	for (size_t i = 0; i < length; ++i) {
+		hash ^= data[i];
+		hash *= 16777619u;
+	}
+	return hash;
+}
+
+/* Reads a whole file. A NULL buffer only reports the size (capacity is still checked),
+ * so the restore path can size its allocation from the blob instead of always taking
+ * the 16 MiB maximum. */
+static int
+picasso_lsp_read_file(const char *path, uint8_t *buffer, uint64_t capacity, uint64_t *size, vfs_context_t ctx)
+{
+	vnode_t vp = NULLVP;
+	struct vnode_attr va;
+	int error = vnode_open(path, FREAD | O_NOFOLLOW, 0, 0, &vp, ctx);
+	if (error) {
+		return error;
+	}
+	VATTR_INIT(&va);
+	VATTR_SET(&va, va_data_size, 0);
+	error = vnode_getattr(vp, &va, ctx);
+	if (!error) {
+		*size = (uint64_t)va.va_data_size;
+		if (*size > capacity) {
+			error = EFBIG;
+		}
+	}
+	int resid = 0;
+	if (!error && buffer && *size) {
+		error = vn_rdwr(UIO_READ, vp, (caddr_t)buffer, (int)*size, 0, UIO_SYSSPACE,
+		    IO_NOAUTH, vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+		if (!error && resid) {
+			error = EIO;
+		}
+	}
+	vnode_close(vp, FREAD, ctx);
+	return error;
+}
+
+static int
+picasso_lsp_restore(proc_t p, user_addr_t scratch)
+{
+	uint8_t *header = NULL, *blob = NULL;
+	uint64_t total = 0, first = 0;
+	int restored = 0;
+	vfs_context_t ctx = vfs_context_current();
+	const char *why = "";
+	(void)p;
+	(void)scratch;
+	/* The blob lives in the board aux window (raw blocks with FUA, below the Data store), not in a
+	 * Data file: a file write follows the file system's checkpoint, and an unclean reboot can replay
+	 * an older state with partly overwritten blocks (wf263: old size, wrong hash). */
+	if (native_ufs_aux_open == NULL || native_ufs_aux_read == NULL ||
+	    !native_ufs_aux_open(PICASSO_LSP_BLOCKS, &first, &why)) {
+		return 0;
+	}
+	header = kalloc_data(4096, Z_WAITOK | Z_ZERO);
+	if (!header) {
+		return 0;
+	}
+	if (!native_ufs_aux_read(0, 1, header) || memcmp(header, PICASSO_LSP_MAGIC, 8)) {
+		goto done;   /* never exported: nothing to restore */
+	}
+	uint32_t version = 0, count = 0, crc = 0;
+	memcpy(&version, header + 8, 4);
+	memcpy(&count, header + 12, 4);
+	memcpy(&total, header + 16, 8);
+	memcpy(&crc, header + 24, 4);
+	if (version != 1 || !count || count > 64 || total < 32 || total > PICASSO_LSP_MAX) {
+		goto done;
+	}
+	blob = kalloc_data((size_t)total, Z_WAITOK | Z_ZERO);
+	if (!blob) {
+		goto done;
+	}
+	if (!native_ufs_aux_read(0, (uint32_t)((total + 4095) / 4096), blob)) {
+		goto done;
+	}
+	const uint32_t actual = picasso_lsp_hash(blob + 32, (size_t)(total - 32));
+	if (actual != crc) {
+		printf("PICASSO_LSP restore=bad-blob total=%llu count=%u stored=%08x actual=%08x\n",
+		    (unsigned long long)total, count, crc, actual);
+		goto done;
+	}
+	uint64_t at = 32;
+	for (uint32_t i = 0; i < count; ++i) {
+		uint32_t path_bytes = 0, mode = 0, data_bytes = 0;
+		if (total - at < 12) {
+			break;
+		}
+		memcpy(&path_bytes, blob + at, 4);
+		memcpy(&mode, blob + at + 4, 4);
+		memcpy(&data_bytes, blob + at + 8, 4);
+		at += 12;
+		if (path_bytes < 2 || path_bytes > 255 || total - at < path_bytes ||
+		    total - at - path_bytes < data_bytes) {
+			break;
+		}
+		const char *path = (const char *)(blob + at);
+		if (path[0] != '/' || path[path_bytes - 1]) {
+			break;
+		}
+		at += path_bytes;
+		/* native_gpu_addon_write returns 0 on a write, -1 when the file already
+		 * matched; both mean the cache is in place. */
+		const int werr = native_gpu_addon_write(path, blob + at, data_bytes, mode & 0777, ctx);
+		if (werr == 0 || werr == -1) {
+			++restored;
+		} else {
+			printf("PICASSO_LSP restore=write-failed err=%d path=%s\n", werr, path);
+		}
+		at += data_bytes;
+	}
+done:
+	if (blob) {
+		kfree_data(blob, (size_t)total);
+	}
+	if (header) {
+		kfree_data(header, 4096);
+	}
+	return restored;
+}
+
+/* The metal2vulkan runtime's cache directory (NativeAdrenoMetalPlugin: candidate 4, the process's
+ * Library/Caches/com.apple.backboardd/m2v). Its size at boot tells whether the pipeline cache really
+ * survives on Data or is rebuilt every boot: the runtime compiles the whole UI when it is empty. */
+static void
+picasso_m2v_scan(const char *path, unsigned depth, unsigned *files, uint64_t *bytes, vfs_context_t ctx)
+{
+	if (depth > 4) {
+		return;
+	}
+	vnode_t vp = NULLVP;
+	if (vnode_lookup(path, 0, &vp, ctx)) {
+		return;
+	}
+	char *buffer = kalloc_data(4096, Z_WAITOK);
+	uio_t uio = buffer ? uio_create(1, 0, UIO_SYSSPACE, UIO_READ) : NULL;
+	int eof = 0;
+	while (uio && !eof) {
+		uio_reset(uio, uio_offset(uio), UIO_SYSSPACE, UIO_READ);
+		uio_addiov(uio, CAST_USER_ADDR_T(buffer), 4096);
+		int entries = 0;
+		if (VNOP_READDIR(vp, uio, 0, &eof, &entries, ctx)) {
+			break;
+		}
+		size_t used = 4096 - uio_resid(uio);
+		if (!used) {
+			break;
+		}
+		const size_t header = offsetof(struct dirent, d_name);
+		for (size_t at = 0; at + header < used;) {
+			const struct dirent *entry = (const struct dirent *)(buffer + at);
+			if (entry->d_reclen <= header || entry->d_reclen > used - at ||
+			    entry->d_namlen >= entry->d_reclen - header) {
+				break;
+			}
+			const int dot = entry->d_name[0] == '.' &&
+			    (entry->d_namlen == 1 || (entry->d_namlen == 2 && entry->d_name[1] == '.'));
+			if (!dot) {
+				char child[256];
+				snprintf(child, sizeof child, "%s/%s", path, entry->d_name);
+				vnode_t cvp = NULLVP;
+				if (!vnode_lookup(child, 0, &cvp, ctx)) {
+					struct vnode_attr va;
+					VATTR_INIT(&va);
+					VATTR_WANTED(&va, va_mode);
+					VATTR_WANTED(&va, va_data_size);
+					if (!vnode_getattr(cvp, &va, ctx)) {
+						if (VATTR_IS_SUPPORTED(&va, va_mode) && (va.va_mode & S_IFMT) == S_IFDIR) {
+							picasso_m2v_scan(child, depth + 1, files, bytes, ctx);
+						} else if (VATTR_IS_SUPPORTED(&va, va_data_size)) {
+							++*files;
+							*bytes += (uint64_t)va.va_data_size;
+						}
+					}
+					vnode_put(cvp);
+				}
+			}
+			at += entry->d_reclen;
+		}
+	}
+	if (uio) {
+		uio_free(uio);
+	}
+	if (buffer) {
+		kfree_data(buffer, 4096);
+	}
+	vnode_put(vp);
+}
+
+static void
+picasso_m2v_probe(void)
+{
+	unsigned files = 0;
+	uint64_t bytes = 0;
+	picasso_m2v_scan("/private/var/mobile/Library/Caches/com.apple.backboardd/m2v", 0, &files, &bytes,
+	    vfs_context_current());
+	printf("PICASSO_M2V dir files=%u bytes=%llu\n", files, (unsigned long long)bytes);
+}
+
+/* ---- Pipeline cache: the runtime's cache directory, exported raw and replayed at boot ----------------
+ * NativeAdrenoMetalPlugin's exporter sends its cache directory as SHEXR001 over method 0x7100 whenever it
+ * changed and stayed stable for one period. The Data file system cannot be trusted to keep the late writes
+ * across an unclean reboot (the APFS checkpoint replays an older state), so the stream goes to the aux
+ * window instead: raw blocks with FUA. The next boot replays it into the runtime's cache directory before
+ * backboardd opens the device, so the UI starts as cache hits.
+ * Layout: aux block 4096 is the header, blocks 4097.. the stream (SHEXR001: 16-byte header, then the
+ * M2VCACH1 directory stream). The header is written last with valid=1 and the stream's FNV-1a. */
+#define PICASSO_PIPE_BLOCK 4096u
+#define PICASSO_PIPE_MAX   (192u << 20)
+#define PICASSO_PIPE_MAGIC "M2VEXPRT"
+#define PICASSO_M2V_DIR    "/private/var/mobile/Library/Caches/com.apple.backboardd/m2v"
+#define PICASSO_M2V_UID    501u
+#define PICASSO_M2V_GID    501u
+#define PICASSO_PIPE_WINDOW (32u * 4096u)
+
+static uint8_t picasso_pipe_tail[4096];
+static uint32_t picasso_pipe_tail_bytes, picasso_pipe_total, picasso_pipe_hash;
+static uint64_t picasso_pipe_next;
+static int picasso_pipe_active;
+static int picasso_pipe_opened;
+
+static uint32_t
+picasso_lsp_hash_step(uint32_t hash, const uint8_t *data, size_t length)
+{
+	for (size_t i = 0; i < length; ++i) {
+		hash ^= data[i];
+		hash *= 16777619u;
+	}
+	return hash;
+}
+
+static int
+picasso_pipe_header_write(uint32_t total, uint32_t hash, uint32_t generation, uint32_t valid)
+{
+	uint8_t *block = kalloc_data(4096, Z_WAITOK | Z_ZERO);
+	if (!block) {
+		return 0;
+	}
+	uint32_t version = 1;
+	memcpy(block, PICASSO_PIPE_MAGIC, 8);
+	memcpy(block + 8, &version, 4);
+	memcpy(block + 12, &total, 4);
+	memcpy(block + 16, &hash, 4);
+	memcpy(block + 20, &generation, 4);
+	memcpy(block + 24, &valid, 4);
+	const int ok = native_ufs_aux_write(PICASSO_PIPE_BLOCK, 1, block);
+	kfree_data(block, 4096);
+	return ok;
+}
+
+/* Method 0x7100 sink: the strong definition overrides NativeAdrenoStubs.c's weak no-op. Pieces arrive in
+ * order; the tail of a block is kept until the next piece completes it, and the header becomes valid only
+ * when the announced total has arrived. A torn export therefore reads as absent, never as a short stream. */
+int
+boot_log_export_put(uint32_t generation, uint32_t total, uint32_t offset, const void *data, uint32_t size)
+{
+	if (native_ufs_aux_open == NULL || native_ufs_aux_write == NULL || !generation || !data || !size) {
+		return -1;
+	}
+	uint64_t first = 0;
+	const char *why = "";
+	if (!picasso_pipe_opened && !native_ufs_aux_open(65536, &first, &why)) {
+		return -4;
+	}
+	picasso_pipe_opened = 1;
+	uint8_t *bytes = (uint8_t *)(uintptr_t)data;
+	if (offset == 0) {
+		if (total < 16 || total > PICASSO_PIPE_MAX) {
+			return -5;
+		}
+		picasso_pipe_total = total;
+		picasso_pipe_hash = 2166136261u;
+		picasso_pipe_tail_bytes = 0;
+		picasso_pipe_next = PICASSO_PIPE_BLOCK + 1;
+		if (!picasso_pipe_header_write(total, 0, generation, 0)) {
+			return -6;
+		}
+		picasso_pipe_active = 1;
+	}
+	if (!picasso_pipe_active || total != picasso_pipe_total || offset > total || size > total - offset) {
+		return -3;
+	}
+	while (size) {
+		uint32_t n = 4096 - picasso_pipe_tail_bytes;
+		if (n > size) {
+			n = size;
+		}
+		memcpy(picasso_pipe_tail + picasso_pipe_tail_bytes, bytes, n);
+		picasso_pipe_hash = picasso_lsp_hash_step(picasso_pipe_hash, bytes, n);
+		picasso_pipe_tail_bytes += n;
+		bytes += n;
+		size -= n;
+		offset += n;
+		if (picasso_pipe_tail_bytes == 4096) {
+			if (!native_ufs_aux_write(picasso_pipe_next++, 1, picasso_pipe_tail)) {
+				picasso_pipe_active = 0;
+				return -6;
+			}
+			picasso_pipe_tail_bytes = 0;
+		}
+	}
+	if (offset == total) {
+		if (picasso_pipe_tail_bytes) {
+			memset(picasso_pipe_tail + picasso_pipe_tail_bytes, 0, 4096 - picasso_pipe_tail_bytes);
+			if (!native_ufs_aux_write(picasso_pipe_next++, 1, picasso_pipe_tail)) {
+				picasso_pipe_active = 0;
+				return -6;
+			}
+		}
+		if (!picasso_pipe_header_write(total, picasso_pipe_hash, generation, 1)) {
+			picasso_pipe_active = 0;
+			return 0;
+		}
+		picasso_pipe_active = 0;
+		printf("PICASSO_M2V export total=%u blocks=%llu\n", total,
+		    (unsigned long long)(picasso_pipe_next - PICASSO_PIPE_BLOCK));
+	}
+	return 0;
+}
+
+/* Sequential reader over the stream in the aux window. */
+static uint64_t picasso_pipe_cursor;
+static uint8_t *picasso_pipe_window;
+static uint32_t picasso_pipe_window_used, picasso_pipe_window_bytes;
+static uint64_t picasso_pipe_remaining;
+
+static int
+picasso_pipe_read(void *dst, uint32_t n)
+{
+	uint8_t *out = dst;
+	if (n > picasso_pipe_remaining) {
+		return 0;
+	}
+	while (n) {
+		if (picasso_pipe_window_used == picasso_pipe_window_bytes) {
+			if (!native_ufs_aux_read(picasso_pipe_cursor, 32, picasso_pipe_window)) {
+				return 0;
+			}
+			picasso_pipe_cursor += 32;
+			picasso_pipe_window_used = 0;
+			picasso_pipe_window_bytes = PICASSO_PIPE_WINDOW;
+		}
+		uint32_t k = picasso_pipe_window_bytes - picasso_pipe_window_used;
+		if (k > n) {
+			k = n;
+		}
+		memcpy(out, picasso_pipe_window + picasso_pipe_window_used, k);
+		picasso_pipe_window_used += k;
+		out += k;
+		n -= k;
+		picasso_pipe_remaining -= k;
+	}
+	return 1;
+}
+
+static uint8_t picasso_pipe_scratch[4096];
+
+static int
+picasso_pipe_skip(uint64_t n)
+{
+	while (n) {
+		uint32_t k = n < sizeof picasso_pipe_scratch ? (uint32_t)n : sizeof picasso_pipe_scratch;
+		if (!picasso_pipe_read(picasso_pipe_scratch, k)) {
+			return 0;
+		}
+		n -= k;
+	}
+	return 1;
+}
+
+static void
+picasso_pipe_reset(void)
+{
+	picasso_pipe_cursor = PICASSO_PIPE_BLOCK + 1;
+	picasso_pipe_window_used = picasso_pipe_window_bytes = 0;
+}
+
+static int
+picasso_m2v_mkdirs(proc_t p, user_addr_t scratch, const char *full, vfs_context_t ctx)
+{
+	char path[320];
+	strlcpy(path, full, sizeof path);
+	for (char *s = path + 1; *s; ++s) {
+		if (*s != '/') {
+			continue;
+		}
+		*s = 0;
+		struct mkdir_args request = {.path = scratch + 0xc00, .mode = 0700};
+		int32_t result = 0;
+		int error = copyout(path, request.path, strlen(path) + 1);
+		const int made = !error && mkdir(p, &request, &result) == 0;
+		*s = '/';
+		if (!made) {
+			continue;   /* an existing directory keeps its owner (never chown /private and friends) */
+		}
+		vnode_t dvp = NULLVP;
+		if (!vnode_lookup(path, 0, &dvp, ctx)) {
+			struct vnode_attr va;
+			VATTR_INIT(&va);
+			VATTR_SET(&va, va_mode, 0700);
+			VATTR_SET(&va, va_uid, PICASSO_M2V_UID);
+			VATTR_SET(&va, va_gid, PICASSO_M2V_GID);
+			(void)vnode_setattr(dvp, &va, ctx);
+			vnode_put(dvp);
+		}
+	}
+	return 0;
+}
+
+static int
+picasso_m2v_write(const char *path, uint32_t mode, uint32_t uid, uint32_t gid, uint64_t size,
+    proc_t p, user_addr_t scratch, vfs_context_t ctx)
+{
+	(void)p;
+	(void)scratch;
+	vnode_t vp = NULLVP;
+	const uint32_t file_mode = (mode & 0777) ? (mode & 0777) : 0600;
+	int error = vnode_open(path, O_CREAT | O_TRUNC | FWRITE | O_NOFOLLOW, file_mode, 0, &vp, ctx);
+	if (error) {
+		return error;
+	}
+	uint8_t *buffer = kalloc_data(65536, Z_WAITOK);
+	if (!buffer) {
+		vnode_close(vp, FWRITE, ctx);
+		return ENOMEM;
+	}
+	uint64_t at = 0;
+	while (!error && at < size) {
+		uint32_t k = size - at < 65536 ? (uint32_t)(size - at) : 65536;
+		if (!picasso_pipe_read(buffer, k)) {
+			error = EIO;
+			break;
+		}
+		int resid = 0;
+		error = vn_rdwr(UIO_WRITE, vp, (caddr_t)buffer, (int)k, (off_t)at, UIO_SYSSPACE,
+		    IO_NOAUTH | IO_UNIT, vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+		if (!error && resid) {
+			error = EIO;
+		}
+		at += k;
+	}
+	kfree_data(buffer, 65536);
+	if (!error) {
+		struct vnode_attr va;
+		VATTR_INIT(&va);
+		VATTR_SET(&va, va_mode, file_mode);
+		VATTR_SET(&va, va_uid, uid);
+		VATTR_SET(&va, va_gid, gid);
+		error = vnode_setattr(vp, &va, ctx);
+	}
+	if (!error) {
+		error = VNOP_FSYNC(vp, MNT_WAIT, ctx);
+	}
+	vnode_close(vp, FWRITE, ctx);
+	return error;
+}
+
+static void
+picasso_m2v_import(proc_t p, user_addr_t scratch)
+{
+	if (native_ufs_aux_open == NULL || native_ufs_aux_read == NULL) {
+		return;
+	}
+	uint64_t first = 0;
+	const char *why = "";
+	if (!native_ufs_aux_open(65536, &first, &why)) {
+		return;
+	}
+	uint8_t *header = kalloc_data(4096, Z_WAITOK | Z_ZERO);
+	picasso_pipe_window = kalloc_data(PICASSO_PIPE_WINDOW, Z_WAITOK | Z_ZERO);
+	if (!header || !picasso_pipe_window) {
+		goto done;
+	}
