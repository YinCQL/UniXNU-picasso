+void picasso_settings_diag_request(void);
+void
+picasso_settings_diag_request(void)
+{
+    if (!os_atomic_cmpxchg(&settings_diag_busy, 0, 1, acquire)) {
+        printf("PICASSO_SETTINGS unavailable=busy\n");
+        return;
+    }
+    uint64_t interval = 0, now = mach_absolute_time();
+    nanoseconds_to_absolutetime(5ULL * NSEC_PER_SEC, &interval);
+    if (settings_diag_sample >= 8 ||
+        (settings_diag_sample && now - settings_diag_last < interval)) {
+        printf("PICASSO_SETTINGS unavailable=%s\n", settings_diag_sample >= 8 ? "budget" : "rate-limit");
+        os_atomic_store(&settings_diag_busy, 0, release);
+        return;
+    }
+    if (!settings_diag_call) settings_diag_call = thread_call_allocate(picasso_settings_diag_fire, NULL);
+    if (!settings_diag_call) {
+        printf("PICASSO_SETTINGS unavailable=allocation\n");
+        os_atomic_store(&settings_diag_busy, 0, release);
+        return;
+    }
+    settings_diag_last = now;
+    ++settings_diag_sample;
+    thread_call_enter(settings_diag_call);
+}
