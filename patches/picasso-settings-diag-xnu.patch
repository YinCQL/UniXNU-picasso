+/* PICASSO_CONFIGD_VFS_BEGIN */
+#if DEVELOPMENT || DEBUG
+/* Observe configd's real bundle discovery and preference-file operations.
+ * Only fixed SystemConfiguration paths are accepted. No file data is printed,
