+/* Fixed directory identities include the real addon backing tree. */
+#if DEVELOPMENT || DEBUG
+static unsigned
+picasso_configd_directory_name(const char *path)
+{
+    static const char *const directories[] = {
+        "/System/Library/SystemConfiguration",
+        "/System/Library/SystemConfiguration/InterfaceNamer.bundle",
+        "/private/var/picasso/ifnamer/InterfaceNamer.bundle"};
+    for (unsigned i = 0; i < sizeof(directories) / sizeof(directories[0]); ++i)
+        if (!strcmp(path, directories[i])) return 1;
+    return 0;
+}
+
+static unsigned
+picasso_configd_directory_vnode(vfs_context_t ctx, vnode_t vp, char path[256])
+{
+    proc_t p = vfs_context_proc(ctx);
+    if (!p || strcmp(p->p_name, "configd")) return 0;
+    int length = 256;
+    if (!vn_getpath(vp, path, &length) && picasso_configd_directory_name(path)) return 1;
+    /* A mount root can lack a cached parent/name; its mountpoint is exact. */
+    if (vnode_isvroot(vp) && vnode_mount(vp)) {
+        const char *mountpoint = vfs_statfs(vnode_mount(vp))->f_mntonname;
+        if (picasso_configd_directory_name(mountpoint)) {
+            strlcpy(path, mountpoint, 256);
+            return 1;
+        }
+    }
+    path[0] = 0;
+    return 0;
+}
+
+static unsigned
+picasso_configd_relative_path(vfs_context_t ctx, int fd, user_addr_t address, char path[256])
+{
+    proc_t p = vfs_context_proc(ctx);
+    if (!p || strcmp(p->p_name, "configd")) return 0;
+    char relative[32];
+    size_t length = 0;
+    if (copyinstr(address, relative, sizeof(relative), &length) || !length ||
+        (strcmp(relative, ".") && strcmp(relative, "Info.plist") &&
+         strcmp(relative, "Contents") && strcmp(relative, "Resources"))) return 0;
+    vnode_t vp = NULLVP;
+    if (file_vnode(fd, &vp)) return 0;
+    unsigned selected = 0;
+    if (!vnode_getwithref(vp)) {
+        selected = picasso_configd_directory_vnode(ctx, vp, path);
+        vnode_put(vp);
+    }
+    file_drop(fd);
+    if (selected) {
+        strlcat(path, "/", 256);
+        strlcat(path, relative, 256);
+    }
+    return selected;
+}
