+static unsigned
+picasso_configd_vfs_path(vfs_context_t ctx, user_addr_t path, char buffer[256])
+{
+    static const char *const roots[] = {"/System/Library/SystemConfiguration",
+        "/Library/Preferences/SystemConfiguration",
+        "/private/var/preferences/SystemConfiguration"};
+    proc_t p = vfs_context_proc(ctx);
+    if (!p || strcmp(p->p_name, "configd")) return 0;
+    size_t length = 0;
+    if (copyinstr(path, buffer, 256, &length) || !length) return 0;
+    for (unsigned i = 0; i < sizeof(roots) / sizeof(roots[0]); ++i) {
+        size_t n = strlen(roots[i]);
+        if (!strncmp(buffer, roots[i], n) && (!buffer[n] || buffer[n] == '/')) {
+            if (i || !buffer[n]) return 1;
+            static const char bundle[] = "/InterfaceNamer.bundle";
+            return !strncmp(buffer + n, bundle, sizeof(bundle) - 1) &&
+                (!buffer[n + sizeof(bundle) - 1] || buffer[n + sizeof(bundle) - 1] == '/');
+        }
+    }
+    return 0;
+}
+
+static unsigned
+picasso_configd_vfs_ticket(void)
+{
+    unsigned value = os_atomic_load(&picasso_configd_vfs_count, relaxed);
+    while (value < 96) {
+        if (os_atomic_cmpxchg(&picasso_configd_vfs_count, value, value + 1, relaxed)) return value + 1;
+        value = os_atomic_load(&picasso_configd_vfs_count, relaxed);
+    }
+    return 0;
+}
