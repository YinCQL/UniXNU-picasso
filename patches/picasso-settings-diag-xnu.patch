+#if __arm64__ && (DEVELOPMENT || DEBUG)
+/* Explicit CDC request only. A worker keeps VM reads off the USB drain thread.
+ * Three task references are acquired under the process-list lock; no printing,
+ * task locks or VM accesses occur there. No user configuration is modified. */
+extern void picasso_settings_task_snapshot(task_t, int, uint64_t, unsigned, const char *);
+static unsigned settings_diag_busy, settings_diag_sample;
+static uint64_t settings_diag_last;
+static thread_call_t settings_diag_call;
