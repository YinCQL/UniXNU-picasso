+/* PICASSO_SETTINGS_DIAG_TASK_BEGIN */
+#if __arm64__ && (DEVELOPMENT || DEBUG)
+#include <sys/errno.h>
+struct picasso_settings_thread_row {
+    uint64_t tid, pc, lr, fp;
+    unsigned valid, state, hint, regs;
+};
+
+/* Remote reads use a referenced map and never page in or wait on a VM fault.
+ * Only 16-byte frame records are read; addresses are checked before switching.
+ * A concurrent user stack/register update makes this best-effort evidence,
+ * not a coherent stack or proof of a wait site. */
+static unsigned
+picasso_settings_frames(vm_map_t map, const struct picasso_settings_thread_row *row,
+    uint64_t frames[12], unsigned *error)
+{
+    const uint64_t mask = 0x7fffffffffULL;
+    unsigned depth = 2;
+    frames[0] = row->pc & mask;
+    frames[1] = row->lr & mask;
+    uint64_t fp = row->fp & mask;
+    *error = 0;
+    while (fp && depth < 12) {
+        if ((fp & 15) || fp < 0x1000 || fp > mask - 15) { *error = EFAULT; break; }
+        uint64_t pair[2] = {0};
+        vm_map_t previous = vm_map_switch(map);
+        disable_preemption();
+        int copied = copyin(fp, pair, sizeof(pair));
+        enable_preemption();
+        vm_map_switch(previous);
+        if (copied) { *error = copied; break; }
+        if (!pair[1]) break;
+        frames[depth++] = pair[1] & mask;
+        uint64_t next = pair[0] & mask;
+        if (next && next <= fp) { *error = EINVAL; break; }
+        fp = next;
+    }
+    return depth;
+}
+
+void picasso_settings_task_snapshot(task_t, int, uint64_t, unsigned, const char *);
+void
+picasso_settings_task_snapshot(task_t task, int pid, uint64_t unique, unsigned sample, const char *name)
+{
+    struct picasso_settings_thread_row rows[8] = {0};
+    unsigned count = 0, total = 0, locked = 0, active = 0;
+    uint64_t header = 0, slide = 0;
+    vm_map_t map = VM_MAP_NULL;
+    /* One task/scheduler lock attempt, copied scalars only, no console or VM
+     * work under either lock. Task lock stabilizes thread queue/lifetimes. */
+    if (task_lock_try(task)) {
+        locked = 1;
+        active = task->active;
+        if (active) {
+            total = task->thread_count;
+            header = task->mach_header_vm_address;
+            slide = task->task_shared_region_slide;
+            map = task->map;
+            if (map) vm_map_reference(map);
+            thread_t thread;
+            queue_iterate(&task->threads, thread, thread_t, task_threads) {
+                if (count == 8) break;
+                struct picasso_settings_thread_row *row = &rows[count++];
+                row->tid = thread_tid(thread);
+                spl_t level = splsched();
+                if (simple_lock_try(&thread->sched_lock, &thread_lck_grp)) {
+                    row->valid = 1;
+                    row->state = thread->state;
+                    if (thread->state & TH_WAIT) row->hint = thread->block_hint;
+                    arm_saved_state_t *state = get_user_regs(thread);
+                    if (state && is_saved_state64(state) && PSR64_IS_USER64(get_saved_state_cpsr(state))) {
+                        row->regs = 1;
+                        row->pc = get_saved_state_pc(state);
+                        row->lr = get_saved_state_lr(state);
+                        row->fp = get_saved_state_fp(state);
+                    }
+                    thread_unlock(thread);
+                }
+                splx(level);
+            }
+        }
+        task_unlock(task);
+    }
+    printf("PICASSO_SETTINGS task sample=%u name=%s pid=%d unique=%llu locked=%u active=%u total=%u sampled=%u main_header=%llx cache_slide=%llx coherent=0\n",
+        sample, name, pid, (unsigned long long)unique, locked, active, total, count,
+        (unsigned long long)header, (unsigned long long)slide);
+    for (unsigned i = 0; i < count; ++i) {
+        const struct picasso_settings_thread_row *row = &rows[i];
+        printf("PICASSO_SETTINGS state sample=%u name=%s pid=%d tid=%llu valid=%u state=%x hint=%u regs=%u\n",
+            sample, name, pid, (unsigned long long)row->tid, row->valid, row->state, row->hint, row->regs);
+        if (!row->regs || !map) continue;
+        uint64_t frames[12] = {0};
+        unsigned error = 0, depth = picasso_settings_frames(map, row, frames, &error);
+        printf("PICASSO_SETTINGS stack sample=%u name=%s pid=%d tid=%llu frames=%u error=%u coherent=0\n",
+            sample, name, pid, (unsigned long long)row->tid, depth, error);
+        for (unsigned j = 0; j < depth; j += 4) {
+            printf("PICASSO_SETTINGS frames sample=%u name=%s pid=%d tid=%llu offset=%u %llx %llx %llx %llx\n",
+                sample, name, pid, (unsigned long long)row->tid, j,
+                (unsigned long long)frames[j], (unsigned long long)frames[j+1],
+                (unsigned long long)frames[j+2], (unsigned long long)frames[j+3]);
+        }
+    }
+    if (map) vm_map_deallocate(map);
+}
+#endif
+/* PICASSO_SETTINGS_DIAG_TASK_END */
