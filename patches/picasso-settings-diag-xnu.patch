+/* PICASSO_SETTINGS_DIAG_TASK_BEGIN */
+#if __arm64__ && (DEVELOPMENT || DEBUG)
+#include <sys/errno.h>
+struct picasso_settings_thread_row {
+    uint64_t tid, pc, lr, fp;
+    unsigned valid, state, hint, regs;
+};
