+    unsigned ticket = picasso_configd_vfs_ticket();
+    if (ticket) printf("PICASSO_CONFIGD_VFS sample=%u pid=%d op=%u error=%d a=%llx b=%llx path=%s\n",
+        ticket, proc_getpid(vfs_context_proc(ctx)), op, error,
+        (unsigned long long)a, (unsigned long long)b, buffer);
