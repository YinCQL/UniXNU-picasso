+/* PICASSO_SETTINGS_DIAG_BSD_BEGIN */
+#if __arm64__ && (DEVELOPMENT || DEBUG)
+/* Explicit CDC request only. A worker keeps VM reads off the USB drain thread.
+ * Three task references are acquired under the process-list lock; no printing,
+ * task locks or VM accesses occur there. No user configuration is modified. */
+extern void picasso_settings_task_snapshot(task_t, int, uint64_t, unsigned, const char *);
+static unsigned settings_diag_busy, settings_diag_sample;
+static uint64_t settings_diag_last;
+static thread_call_t settings_diag_call;
+
+static void
+picasso_settings_diag_fire(thread_call_param_t unused, thread_call_param_t argument)
+{
+    (void)unused;
+    (void)argument;
+    static const char *const names[] = {"Preferences", "configd", "lockdownd"};
+    struct { task_t task; int pid; uint64_t unique; } rows[3] = {0};
+    proc_t p;
+    unsigned sample = settings_diag_sample;
+    proc_list_lock();
+    ALLPROC_FOREACH(p) {
+        for (unsigned i = 0; i < 3; ++i) {
+            if (rows[i].task || strcmp(p->p_name, names[i])) continue;
+            task_t task = proc_task(p);
+            if (!task) continue;
+            task_reference(task);
+            rows[i].task = task;
+            rows[i].pid = proc_getpid(p);
+            rows[i].unique = proc_uniqueid(p);
+        }
+    }
+    proc_list_unlock();
+    printf("PICASSO_SETTINGS begin sample=%u coherent=0 readonly=1\n", sample);
+    for (unsigned i = 0; i < 3; ++i) {
+        if (rows[i].task) {
+            picasso_settings_task_snapshot(rows[i].task, rows[i].pid, rows[i].unique, sample, names[i]);
+            task_deallocate(rows[i].task);
+        } else {
+            printf("PICASSO_SETTINGS absent sample=%u name=%s\n", sample, names[i]);
+        }
+    }
+    printf("PICASSO_SETTINGS end sample=%u\n", sample);
+    os_atomic_store(&settings_diag_busy, 0, release);
+}
+
+void picasso_settings_diag_request(void);
+void
+picasso_settings_diag_request(void)
+{
+    if (!os_atomic_cmpxchg(&settings_diag_busy, 0, 1, acquire)) {
+        printf("PICASSO_SETTINGS unavailable=busy\n");
+        return;
+    }
+    uint64_t interval = 0, now = mach_absolute_time();
+    nanoseconds_to_absolutetime(5ULL * NSEC_PER_SEC, &interval);
+    if (settings_diag_sample >= 8 ||
+        (settings_diag_sample && now - settings_diag_last < interval)) {
+        printf("PICASSO_SETTINGS unavailable=%s\n", settings_diag_sample >= 8 ? "budget" : "rate-limit");
+        os_atomic_store(&settings_diag_busy, 0, release);
+        return;
+    }
+    if (!settings_diag_call) settings_diag_call = thread_call_allocate(picasso_settings_diag_fire, NULL);
+    if (!settings_diag_call) {
+        printf("PICASSO_SETTINGS unavailable=allocation\n");
+        os_atomic_store(&settings_diag_busy, 0, release);
+        return;
+    }
+    settings_diag_last = now;
+    ++settings_diag_sample;
+    thread_call_enter(settings_diag_call);
+}
+#endif
+/* PICASSO_SETTINGS_DIAG_BSD_END */
