+// already uses): the non-blocking-present experiment, commit and return without waiting for the GPU.
+inline bool nonblocking() {
+    static int enabled = -1;
+    if (enabled < 0) {
+        char args[1024] = {};
+        size_t size = sizeof args;
+        enabled = sysctlbyname("kern.bootargs", args, &size, nullptr, 0) == 0 &&
+                  strstr(args, "sheng-present-nonblock=1") != nullptr;
+    }
+    return enabled != 0;
+}
